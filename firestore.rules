rules_version = '2';

// Deploy from Firebase Console → Firestore → Rules (paste this file),
// or: firebase deploy --only firestore:rules  (requires firebase.json + firebase login)
//
// Web org setup needs a signed-in user to CREATE:
//   organizations/{newOrgId}  (with themselves in members)
//   users/{theirAuthUid}
//   users/{theirAuthUid}/orgMemberships/{orgId}
//   organizations/{orgId}/*   (guided setup data after activation)

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function orgData(orgId) {
      return get(/databases/$(database)/documents/organizations/$(orgId)).data;
    }

    function isOrgMember(orgId) {
      return signedIn() && request.auth.uid in orgData(orgId).members;
    }

    function isOrgAdmin(orgId) {
      return signedIn() && orgData(orgId).members[request.auth.uid] == 'admin';
    }

    match /users/{userId} {
      allow read: if signedIn() && (
        request.auth.uid == userId ||
        (resource.data.organizationId is string && isOrgMember(resource.data.organizationId))
      );

      allow create: if signedIn() && (
        request.auth.uid == userId ||
        (
          request.resource.data.organizationId is string &&
          isOrgAdmin(request.resource.data.organizationId)
        )
      );

      allow update: if signedIn() && (
        request.auth.uid == userId ||
        (resource.data.organizationId is string && isOrgAdmin(resource.data.organizationId))
      );

      allow delete: if signedIn() && (
        request.auth.uid == userId ||
        (resource.data.organizationId is string && isOrgAdmin(resource.data.organizationId))
      );

      match /orgMemberships/{orgId} {
        allow read: if signedIn() && request.auth.uid == userId;
        allow create, update: if signedIn() && (
          request.auth.uid == userId ||
          isOrgAdmin(orgId)
        );
      }
    }

    match /organizations/{orgId} {
      allow create: if signedIn() && request.auth.uid in request.resource.data.members;
      allow read: if signedIn() && request.auth.uid in resource.data.members;
      allow update: if signedIn() && request.auth.uid in resource.data.members;

      match /{subcollection}/{docId} {
        allow read, write: if isOrgMember(orgId);
      }
    }

    match /invitations/{invitationId} {
      allow read: if signedIn();
      allow create: if signedIn();
      allow update: if signedIn();
    }

    match /platformConfig/{docId} {
      allow read: if signedIn();
      allow write: if false;
    }
  }
}
