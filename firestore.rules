rules_version = '2';
service cloud.firestore {
  function orgIdsMatch(a, b) {
    return a is string && b is string && (
      a.lower() == b.lower() ||
      a.lower().matches('^\\s*' + b.lower() + '\\s*$')
    );
  }

  function truthyBool(v) {
    return v == true || v == 1;
  }

  function adminLikeUser(userData) {
    return truthyBool(userData.get('isSuperAdmin', false)) ||
           truthyBool(userData.get('adminAccess', false)) ||
           'permissions' in userData && userData.permissions is map &&
             'adminAccess' in userData.permissions && truthyBool(userData.permissions.adminAccess) ||
           userData.get('role', '') == 'admin';
  }

  function callerHomeFlags() {
    return request.auth.token.get(['pp', 'u'], []);
  }
  function callerOrg(orgId) {
    return request.auth.token.get(['pp', 'o', orgId.lower()], ['', '']);
  }
  function callerHomeOrgRaw() {
    let pp = request.auth.token.get('pp', {});
    return pp.get('r', pp.get('h', null));
  }

  function callerHomeIsOperative() {
    let u = callerHomeFlags();
    return 'o' in u && !('a' in u);
  }

  function userDocOrganizationMatches(userData, orgId) {
    let v = userData.get('organizationId', null);
    let o = orgId.lower();
    let w = v is path ? v[4] : v;
    let m = w is string && orgId is string && (w.lower() == o || w.lower().matches('^\\s*' + o + '\\s*$'));
    return v is string && (m || v.lower().matches('(^|.*/)organizations/' + o + '$')) ||
      v is path && (m || string(v).lower().matches('.*/organizations/' + o + '$')) ||
      v == /databases/(default)/documents/organizations/$(orgId);
  }

  function userOrgIdMatchesPath(orgId) {
    return request.auth != null && 'h' in callerOrg(orgId);
  }

  function isOrgCreatorViaParentGet(orgId) {
    let orgPath = /databases/(default)/documents/organizations/$(orgId);
    return request.auth != null && exists(orgPath) && get(orgPath).data.get('creatorUserId', null) == request.auth.uid;
  }

  function selfCreateHasAgeConfirmation() {
    return request.resource.data.ageConfirmed == true &&
           request.resource.data.ageConfirmedYears is number &&
           request.resource.data.ageConfirmedAt is timestamp;
  }

  function inviteClaimIsPendingPlaceholder(orgId, emailKey) {
    let claimPath = /databases/(default)/documents/organizations/$(orgId)/userEmails/$(emailKey);
    let claimed = exists(claimPath) ? get(claimPath).data.get('userId', '') : '';
    return claimed is string && claimed != '' && !claimed.matches('.*/.*') &&
      pendingPlaceholderFor(claimed, orgId, emailKey);
  }
  function pendingPlaceholderFor(placeholderId, orgId, emailKey) {
    let path = /databases/(default)/documents/users/$(placeholderId);
    let placeholder = exists(path) ? get(path).data : {};
    return exists(path) &&
           placeholder.get('passwordSet', false) != true &&
           placeholder.get('email', null) is string &&
           placeholder.email.lower() == emailKey &&
           'organizationId' in placeholder &&
           userDocOrganizationMatches(placeholder, orgId);
  }

  function staffFlag(data, key) {
    let v = data.get(key, null);
    let p = data.get('permissions', {});
    return v == null ? truthyBool(p is map ? p.get(key, null) : null) : truthyBool(v);
  }

  function privilegeKeysTyped(next, prev) {
    return [next.get('isSuperAdmin', null), next.get('adminAccess', null), next.get('manager', null), next.get('operatives', null), next.get('operativeMode', null), next.get('annualLeaveSelfBook', null), next.get('timesheetSelfSign', null)].toSet().difference([prev.get('isSuperAdmin', null), prev.get('adminAccess', null), prev.get('manager', null), prev.get('operatives', null), prev.get('operativeMode', null), prev.get('annualLeaveSelfBook', null), prev.get('timesheetSelfSign', null)].toSet().union([true, false, null].toSet())).size() == 0;
  }
  function privilegeCreateTyped(next, checkRole) {
    let np = next.get('permissions', {});
    return [next.get('isSuperAdmin', null), next.get('adminAccess', null), next.get('manager', null), next.get('operatives', null), next.get('operativeMode', null), next.get('annualLeaveSelfBook', null), next.get('timesheetSelfSign', null)].toSet().difference([true, false, null].toSet()).size() == 0 &&
      (!('permissions' in next) || np is map && [np.get('isSuperAdmin', null), np.get('adminAccess', null), np.get('manager', null), np.get('operatives', null), np.get('operativeMode', null), np.get('annualLeaveSelfBook', null), np.get('timesheetSelfSign', null)].toSet().difference([true, false, null].toSet()).size() == 0) &&
      (!checkRole || next.get('role', null) in [null, 'admin', 'manager', 'operative', 'member', 'basic', 'viewer']);
  }
  function privilegeWriteTyped(next, prev, checkRole) {
    return next.diff(prev).affectedKeys().hasAny(['isSuperAdmin', 'adminAccess', 'manager', 'operatives', 'operativeMode',
        'annualLeaveSelfBook', 'timesheetSelfSign', 'permissions', 'role'])
      ? privilegeKeysTyped(next, prev) &&
      (next.get('permissions', null) == prev.get('permissions', null) || next.get('permissions', {}) is map &&
        privilegeKeysTyped(next.get('permissions', {}), prev.get('permissions', {}) is map ? prev.get('permissions', {}) : {})) &&
      (!checkRole || next.get('role', null) == prev.get('role', null) ||
        next.get('role', null) in [null, 'admin', 'manager', 'operative', 'member', 'basic', 'viewer']) : true;
  }

  function membersValuesTyped(next, prev) {
    let nm = next.get('members', {}) is map ? next.get('members', {}).values() : ['-'];
    let pm = prev.get('members', {}) is map ? prev.get('members', {}).values() : [];
    let ok = ['admin', 'manager', 'operative', 'member'];
    return !next.diff(prev).affectedKeys().hasAny(['members']) ? true :
      nm.removeAll(ok).size() <= pm.removeAll(ok).size() && nm.toSet().difference(pm.toSet()).hasOnly(ok);
  }

  function privilegeFlag(d, key) {
    let p = d.get('permissions', {});
    return truthyBool(d.get(key, false)) || p is map && truthyBool(p.get(key, false));
  }
  function noPrivilegeFlags(d) {
    let p = d.get('permissions', {}) is map ? d.get('permissions', {}) : {};
    let v = [d.get('isSuperAdmin', false), d.get('adminAccess', false), d.get('manager', false), d.get('operatives', false),
      d.get('annualLeaveSelfBook', false), d.get('timesheetSelfSign', false), p.get('isSuperAdmin', false),
      p.get('adminAccess', false), p.get('manager', false), p.get('operatives', false), p.get('annualLeaveSelfBook', false),
      p.get('timesheetSelfSign', false)];
    return !(d.get('role', '') in ['admin', 'manager']) && !v.hasAny([true, 1, 1.0]);
  }

  function isOperativeProfile(data) {
    return staffFlag(data, 'operativeMode') || data.get('role', '') == 'operative';
  }

  function selfCreateJoinsCompany(orgId, emailKey) {
    let hp0 = /databases/(default)/documents/organizations/$(orgId);
    let claimPath = /databases/(default)/documents/organizations/$(orgId)/userEmails/$(emailKey);
    return (
      inviteClaimIsPendingPlaceholder(orgId, emailKey) ? (
        inviteBeingAccepted(request.resource.data.get('invitationId', ''), orgId) ?
          selfCreateWithinInvitationLevel(request.resource.data,
            get(/databases/(default)/documents/invitations/$(request.resource.data.invitationId)).data) &&
          selfCreateCopiesPlaceholder(get(claimPath).data.userId) : false
      ) : false
    ) || (
      exists(claimPath) && get(claimPath).data.userId == request.auth.uid ? (
        request.auth != null &&
           exists(hp0) &&
           'members' in get(hp0).data &&
           get(hp0).data.members[request.auth.uid] != null ? (
          selfCreateKeepsManagedFields(get(hp0).data.members[request.auth.uid]) ?
            privilegeCreateTyped(request.resource.data, true) &&
            selfCreateAliasesWithin(request.resource.data, {}, '') &&
            (!privilegeFlag(request.resource.data, 'annualLeaveSelfBook') &&
            !privilegeFlag(request.resource.data, 'timesheetSelfSign') ||
           orgCreatorIs(orgId, request.auth.uid)) &&
            (
              !(privilegeFlag(request.resource.data, 'isSuperAdmin') ||
           privilegeFlag(request.resource.data, 'adminAccess') ||
           privilegeFlag(request.resource.data, 'manager') ||
           privilegeFlag(request.resource.data, 'operatives') ||
           request.resource.data.get('role', '') in ['admin', 'manager']) ||
              get(hp0).data.members[request.auth.uid] == 'admin'
            )
           : false
        ) : false
      ) : false
    );
  }
  function selfCreateWithinInvitationLevel(next, inv) {
    let stored = inv.get('role', '');
    let role = stored in ['admin', 'manager', 'operative'] ? stored : invitationRole(inv);
    let p = next.get('permissions', {}) is map ? next.get('permissions', {}) : {};
    let sa = [next.get('isSuperAdmin', false), p.get('isSuperAdmin', false)];
    let ad = [next.get('adminAccess', false), p.get('adminAccess', false)];
    let mg = [next.get('manager', false), p.get('manager', false), next.get('operatives', false), p.get('operatives', false)];
    return !(true in sa) && !(1 in sa) && !(1.0 in sa) && (role == 'admin' ||
      !(true in ad) && !(1 in ad) && !(1.0 in ad) && next.get('role', '') != 'admin' && (role in ['manager', 'member'] ||
        !(true in mg) && !(1 in mg) && !(1.0 in mg) && next.get('role', '') != 'manager'));
  }
  function selfCreateKeepsManagedFields(listed) {
    return listed == 'admin' ||
      !request.resource.data.keys().hasAny([
        'dayRate', 'hourlyRate', 'payBasis', 'employmentType', 'employmentTypeTransitionFrom', 'employmentTypeEffectiveAt',
        'hasNoLineManager', 'assignedManagerUserId', 'assignedManagerUserIds'
      ]) &&
      (listed != 'operative' || isOperativeProfile(request.resource.data))
    ;
  }

  function callerAcceptedPlaceholder(placeholderId, orgId) {
    let home = callerHomeData();
    return placeholderId is string && placeholderId != '' &&
      placeholderId in home.get('formerUserIds', []) &&
      orgIdsMatch(home.get('organizationId', ''), orgId);
  }
  function selfCreateCopiesPlaceholder(placeholderId) {
    let placeholder = get(/databases/(default)/documents/users/$(placeholderId)).data;
    let next = request.resource.data;
    let d = next.diff(placeholder);
    let np = next.get('permissions', {}) is map ? next.get('permissions', {}) : {};
    let sp = placeholder.get('permissions', {}) is map ? placeholder.get('permissions', {}) : {};
    let pd = np.diff(sp);
    let pay = ['dayRate', 'hourlyRate', 'payBasis', 'employmentType', 'employmentTypeTransitionFrom', 'employmentTypeEffectiveAt'];
    return !d.affectedKeys().hasAny(['assignedManagerUserId', 'assignedManagerUserIds', 'hasNoLineManager', 'role',
        'isSuperAdmin', 'adminAccess', 'manager', 'operatives', 'operativeMode', 'annualLeaveSelfBook', 'timesheetSelfSign']) &&
      !pd.affectedKeys().hasAny(['isSuperAdmin', 'adminAccess', 'manager', 'operatives', 'operativeMode',
        'annualLeaveSelfBook', 'timesheetSelfSign']) &&
      !d.changedKeys().union(d.addedKeys()).hasAny(pay) &&
      (d.removedKeys().hasAny(pay) ? privatePayOn(next.get('organizationId', '')) : true) &&
      selfCreateAliasesWithin(next, placeholder, placeholderId);
  }

  function enforcedReadsOn(orgId) {
    let config = /databases/(default)/documents/platformConfig/app;
    let data = exists(config) ? get(config).data : {};
    return data.get('enforcedReads', false) == true ||
      data.get('enforcedReadsOrganizationIds', []) is list && orgId in data.get('enforcedReadsOrganizationIds', []);
  }

  function operativeOwnLeaveOn(orgId) {
    let config = /databases/(default)/documents/platformConfig/app;
    let data = exists(config) ? get(config).data : {};
    return data.get('operativeOwnLeave', false) == true ||
      data.get('operativeOwnLeaveOrganizationIds', []) is list && orgId in data.get('operativeOwnLeaveOrganizationIds', []);
  }

  function privatePayOn(orgId) {
    let config = /databases/(default)/documents/platformConfig/app;
    let data = exists(config) ? get(config).data : {};
    return data.get('privatePay', false) == true ||
      data.get('privatePayOrganizationIds', []) is list && orgId in data.get('privatePayOrganizationIds', []);
  }
  function payValueWritten() {
    let next = request.resource.data;
    let prev = resource == null ? {} : resource.data;
    return next.get('dayRate', null) != null && next.get('dayRate', null) != prev.get('dayRate', null) ||
      next.get('hourlyRate', null) != null && next.get('hourlyRate', null) != prev.get('hourlyRate', null) ||
      next.get('payBasis', null) != null && next.get('payBasis', null) != prev.get('payBasis', null) ||
      next.get('employmentType', null) != null && next.get('employmentType', null) != prev.get('employmentType', null) ||
      next.get('employmentTypeTransitionFrom', null) != null &&
        next.get('employmentTypeTransitionFrom', null) != prev.get('employmentTypeTransitionFrom', null) ||
      next.get('employmentTypeEffectiveAt', null) != null &&
        next.get('employmentTypeEffectiveAt', null) != prev.get('employmentTypeEffectiveAt', null);
  }
  function payStaysPrivate(orgId) {
    return privatePayOn(orgId) ? (
      request.resource.data.diff(resource == null ? {} : resource.data).affectedKeys().hasAny(['dayRate', 'hourlyRate',
        'payBasis', 'employmentType', 'employmentTypeTransitionFrom', 'employmentTypeEffectiveAt'])
        ? !payValueWritten() : true) : true;
  }

  function orgBillingOpen(orgId) {
    let path = /databases/(default)/documents/organizations/$(orgId);
    let org = exists(path) ? get(path).data : {};
    let c = org.get(['billing', 'accessClosesAt'], null);
    return org.get(['deletion', 'status'], '') != 'scheduled' &&
      org.get(['billing', 'accessOpen'], true) != false &&
      !(c is timestamp && request.time >= c);
  }

  function canAccessOrganization(orgId) {
    return isPlatformOwner() || request.auth != null && 'c' in callerOrg(orgId) && orgBillingOpen(orgId);
  }

  function billingUnchanged() {
    return !('billing' in resource.data) && !('billing' in request.resource.data)
      || request.resource.data.billing == resource.data.billing;
  }

  function resourceMaterialHasNonEmptyOwnerUid() {
    return resource != null &&
           'addedByUserId' in resource.data &&
           resource.data.addedByUserId is string &&
           resource.data.addedByUserId.size() > 0;
  }

  function addedByNamesUser(addedBy, u) {
    return 'email' in u && u.email is string && addedBy == u.email.lower() ||
           'firstName' in u && 'surname' in u && u.firstName is string && u.surname is string &&
            addedBy == (u.firstName + ' ' + u.surname).lower() ||
           'firstName' in u && 'lastName' in u && u.firstName is string && u.lastName is string &&
            addedBy == (u.firstName + ' ' + u.lastName).lower();
  }

  function isOrganizationAdmin(orgId) {
    return request.auth != null && 'H' in callerOrg(orgId) && orgBillingOpen(orgId);
  }

  function callerListedRole(orgId) {
    return callerOrg(orgId)[1];
  }
  function callerHomeData() {
    let p = /databases/(default)/documents/users/$(request.auth.uid);
    return exists(p) ? get(p).data : {};
  }
  function homeOrgIs(home, orgId) {
    let v = home.get('organizationId', '');
    let org = orgId.lower();
    return v is string && (v.trim().lower() == org || v.lower().matches('(^|.*/)organizations/' + org + '$')) ||
      v is path && string(v).lower().matches('.*/organizations/' + org + '$');
  }
  function callerOrgRole(orgId) {
    return orgBillingOpen(orgId) ? (callerOrg(orgId)[0]) : '';
  }
  function invitationRole(inv) {
    let perms = inv.get('permissions', {});
    return inv.get('role', '') in ['admin', 'manager', 'operative', 'member'] ? inv.get('role', '') : (
      !(perms is map) || perms.size() == 0 ? 'member' : (
        perms.get('adminAccess', false) == true ? 'admin' : (perms.get('operativeMode', false) == true ? 'operative' : 'manager')
      )
    );
  }

  function invitationIsOperativeOnly(inv) {
    let perms = inv.get('permissions', {}) is map ? inv.get('permissions', {}) : {};
    return invitationRole(inv) == 'operative' &&
      (truthyBool(perms.get('operativeMode', false)) || inv.get('role', '') == 'operative') &&
      !truthyBool(perms.get('adminAccess', false)) && !truthyBool(perms.get('isSuperAdmin', false)) &&
      !truthyBool(perms.get('manager', false)) && !truthyBool(perms.get('operatives', false)) &&
      !truthyBool(inv.get('adminAccess', false)) && !truthyBool(inv.get('isSuperAdmin', false)) &&
      !truthyBool(inv.get('manager', false)) && !truthyBool(inv.get('operatives', false));
  }

  function inviteBeingAccepted(invId, orgId) {
    let path = /databases/(default)/documents/invitations/$(invId);
    return invId is string && invId.size() > 0 && !invId.matches('.*/.*') && exists(path) &&
      get(path).data.get('isUsed', false) != true &&
      getAfter(path).data.get('isUsed', false) == true &&
      get(path).data.get('organizationId', '') == orgId &&
      request.auth.token.email is string &&
      string(get(path).data.get('email', '')).lower() == request.auth.token.email.lower();
  }
  function isOrgManagerOrAdmin(orgId) {
    return request.auth != null && orgId is string &&
      callerOrgRole(orgId) in ['admin', 'manager'];
  }

  function isOperativeLikeUser(userData) {
    return 'operativeMode' in userData && truthyBool(userData.operativeMode) ||
           'role' in userData && userData.role == 'operative';
  }

  function orgAdminEither(orgId) {
    return request.auth != null && 'E' in callerOrg(orgId) && orgBillingOpen(orgId);
  }

  function isManagerWithOperativesAccess() {
    let p = /databases/(default)/documents/users/$(request.auth.uid);
    let u = get(p).data;
    return request.auth != null && exists(p) &&
           !('operativeMode' in u && truthyBool(u.operativeMode)) &&
           'manager' in u && truthyBool(u.manager) &&
           'operatives' in u && truthyBool(u.operatives);
  }

  function opsManagerEmailFree(org, email) {
    return (!(email is string) || email.trim() == '') ? true : opsManagerClaimFree(org, email.trim().lower());
  }
  function opsManagerClaimFree(org, key) {
    let hp0 = /databases/(default)/documents/organizations/$(org)/userEmails/$(key);
    return key.matches('.*/.*') ? false : (
      !exists(hp0) ? true :
        opsManagerMayHoldClaim(get(hp0).data.get('userId', ''))
    );
  }
  function opsManagerMayHoldClaim(uid) {
    let hp0 = /databases/(default)/documents/users/$(uid);
    return (!(uid is string) || uid == '') ? true : (
      uid.matches('.*/.*') ? false : (
        !exists(hp0) ? true :
          managerMayManageOperative(uid, get(hp0).data)
      )
    );
  }
  function opsManagerClaimTarget(uid) {
    let hp0 = /databases/(default)/documents/users/$(uid);
    return (uid is string && uid != '' && !uid.matches('.*/.*') &&
            existsAfter(hp0)) ?
      managerMayManageOperative(uid, getAfter(hp0).data) : false;
  }

  function isPlatformOwner() {
    return request.auth != null &&
      request.auth.token.get('email', '').lower() == 'info@projectplanner.us' &&
      request.auth.token.email_verified;
  }

  function managerMayManageOperative(targetUserId, targetData) {
    let home = callerHomeData();
    return (request.auth.uid != targetUserId && !('operativeMode' in home && truthyBool(home.operativeMode)) &&
           'manager' in home && truthyBool(home.manager) &&
           'operatives' in home && truthyBool(home.operatives)) ?
      'organizationId' in home && 'organizationId' in targetData &&
      orgIdsMatch(home.organizationId, targetData.organizationId) &&
      manageableOperative(targetData)
     : false;
  }

  function manageableOperative(t) {
    let p = t.get('permissions', {}) is map ? t.get('permissions', {}) : {};
    let v = [t.get('isSuperAdmin', false), t.get('adminAccess', false), t.get('manager', false),
      p.get('isSuperAdmin', false), p.get('adminAccess', false), p.get('manager', false)];
    return ('operativeMode' in t && truthyBool(t.operativeMode) ||
           'permissions' in t && t.permissions is map && 'operativeMode' in t.permissions && truthyBool(t.permissions.operativeMode) ||
           'role' in t && t.role == 'operative') && !(t.get('role', '') in ['admin', 'manager']) && !v.hasAny([true, 1, 1.0]);
  }

  function plainOperative(d) {
    let p = d.get('permissions', {}) is map ? d.get('permissions', {}) : {};
    let om = d.get('operativeMode', null) == null ? p.get('operativeMode', null) : d.get('operativeMode', false);
    return (om == true || om == 1 || d.get('role', '') == 'operative') && noPrivilegeFlags(d);
  }

  function selfUpdateKeepsIdentityLinks() {
    let changed = affected();
    return (!('email' in changed) ||
             request.resource.data.get('email', null) is string &&
             request.auth.token.email is string &&
             request.resource.data.email.trim().lower() == request.auth.token.email.lower()
           ) &&
           !changed.hasAny(['formerUserIds', 'sameEmailUserIds', 'ghost', 'inviteEmailHint']);
  }

  function selfCreateAliasesWithin(next, source, placeholderId) {
    return (next.get('formerUserIds', null) == null || next.get('formerUserIds', null) is list) && (next.get('sameEmailUserIds', null) == null || next.get('sameEmailUserIds', null) is list) &&
      (next.get('formerUserIds', null) is list ? next.get('formerUserIds', null).toSet() : [].toSet()).difference((source.get('formerUserIds', null) is list ? source.get('formerUserIds', null).toSet() : [].toSet())).hasOnly([placeholderId]) &&
      (next.get('sameEmailUserIds', null) is list ? next.get('sameEmailUserIds', null).toSet() : [].toSet()).difference((source.get('sameEmailUserIds', null) is list ? source.get('sameEmailUserIds', null).toSet() : [].toSet())).size() == 0;
  }

  function selfPermissionsNotRaised(next, prev, topChanged) {
    let falseMap = ((isOperativeProfile(prev))
      ? {'manager': false, 'operatives': false, 'qualifications': false, 'projects': false, 'smallWorks': false,
         'annualLeaveSelfBook': false, 'timesheetSelfSign': false, 'weeklyReports': false, 'subContractors': false,
         'materials': false, 'siteAudit': false}
      : {'manager': false, 'operatives': false, 'qualifications': false, 'projects': false, 'smallWorks': false,
         'annualLeaveSelfBook': false, 'timesheetSelfSign': false, 'weeklyReports': false, 'subContractors': false});
    return (prev.diff(falseMap).changedKeys().union(
      prev.get('permissions', {}) is map ? prev.get('permissions', {}).diff(falseMap).changedKeys() : [].toSet()
    )).hasAll((next.diff(falseMap).changedKeys().union(
      next.get('permissions', {}) is map ? next.get('permissions', {}).diff(falseMap).changedKeys() : [].toSet()
    ))) &&
           (next.diff({'dailyOverview': false, 'wholesalersOrderHistory': false}).unchangedKeys().union(
      next.get('permissions', {}) is map
        ? next.get('permissions', {}).diff({'dailyOverview': false, 'wholesalersOrderHistory': false}).unchangedKeys()
        : [].toSet()
    )).hasAll((prev.diff({'dailyOverview': false, 'wholesalersOrderHistory': false}).unchangedKeys().union(
      prev.get('permissions', {}) is map
        ? prev.get('permissions', {}).diff({'dailyOverview': false, 'wholesalersOrderHistory': false}).unchangedKeys()
        : [].toSet()
    ))) &&
           (!(topChanged.hasAny(['operativeMode', 'role', 'permissions'])) ||
            !isOperativeProfile(prev) || isOperativeProfile(next));
  }

  function lineManagerIdList(data) {
    let many = data.get('assignedManagerUserIds', null);
    let one = data.get('assignedManagerUserId', null);
    return many is list && many != [] ? many : one is string && one != '' ? [one] : [];
  }

  function sameInstantValue(a, b) {
    return a == b ||
      a is timestamp && b is timestamp && a > b - duration.value(1, 's') && a < b + duration.value(1, 's') ||
      a is number && b is number && a > b - 1000 && a < b + 1000;
  }

  function affected() {
    return request.resource.data.diff(resource.data).affectedKeys();
  }
  function writtenKeys() {
    return resource == null
      ? request.resource.data.keys().toSet()
      : affected();
  }
  function writeMetadataKeysValid(written) {
    let d = request.resource.data;
    return (!('updatedBy' in written) || d.updatedBy == request.auth.uid) &&
      (!('updatedFrom' in written) || d.updatedFrom in ['web', 'ios', 'android']) &&
      (!('updatedAt' in written) || d.updatedAt is timestamp);
  }

  function sameLooseValue(a, b) {
