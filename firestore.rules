rules_version = '2';
service cloud.firestore {
  // UUID / org strings may differ by case or accidental whitespace (website imports, copy/paste).
  function orgIdsMatch(a, b) {
    return a is string && b is string && (
      a.lower() == b.lower() ||
      a.lower().matches('^\\s*' + b.lower() + '\\s*$')
    );
  }

  // Firestore may store legacy "boolean" flags as 1/0 from imports or other clients.
  function truthyBool(v) {
    return v == true || v == 1;
  }

  function adminLikeUser(userData) {
    return ('isSuperAdmin' in userData && truthyBool(userData.isSuperAdmin)) ||
           ('adminAccess' in userData && truthyBool(userData.adminAccess)) ||
           ('permissions' in userData && userData.permissions is map &&
             ('adminAccess' in userData.permissions && truthyBool(userData.permissions.adminAccess))) ||
           ('role' in userData && userData.role == 'admin');
  }

  function materialManagerLikeUser(userData) {
    return adminLikeUser(userData) ||
           ('manager' in userData && truthyBool(userData.manager)) ||
           ('permissions' in userData && userData.permissions is map &&
             ('manager' in userData.permissions && truthyBool(userData.permissions.manager))) ||
           ('role' in userData && userData.role == 'manager');
  }

  // Job quote and order history (`canViewMaterialOrderHistory`): every admin and manager of the organisation, never
  // operative mode — `isOrgManagerOrAdmin` (1.10.0: this organisation's role, not another company's flags).

  // True if users/{auth.uid}.organizationId matches this org (string case-insensitive, DocumentReference exact path,
  // or DocumentReference whose *document id* matches case-insensitive — avoids strict path equality when UUID casing differs).
  // Also accepts string relative paths like "organizations/<uuid>" (Swift client strips the prefix; rules must too).
  function userDocOrganizationMatches(userData, organizationId) {
    return 'organizationId' in userData && (
      (userData.organizationId is string &&
       orgIdsMatch(userData.organizationId, organizationId)) ||
      (userData.organizationId is string &&
       string(userData.organizationId).lower().matches('(^|.*/)organizations/' + organizationId.lower() + '$')) ||
      (userData.organizationId is path &&
       orgIdsMatch(userData.organizationId[4], organizationId)) ||
      userData.organizationId == /databases/(default)/documents/organizations/$(organizationId) ||
      // Some clients/refs use a different path segment index; full string match covers those cases.
      (userData.organizationId is path &&
       string(userData.organizationId).lower().matches('.*/organizations/' + organizationId.lower() + '$'))
    );
  }
  
  function userOrgIdMatchesPath(organizationId) {
    return request.auth != null &&
           exists(/databases/(default)/documents/users/$(request.auth.uid)) &&
           userDocOrganizationMatches(
             get(/databases/(default)/documents/users/$(request.auth.uid)).data,
             organizationId
           );
  }
  
  // Member check by reading the parent org document. Do NOT use this when evaluating read on that same org doc
  // (circular get can deny access). For organizations/{organizationId} document reads, use resource.data.members instead.
  function isOrgMemberViaParentGet(organizationId) {
    return request.auth != null &&
           exists(/databases/(default)/documents/organizations/$(organizationId)) &&
           'members' in get(/databases/(default)/documents/organizations/$(organizationId)).data &&
           get(/databases/(default)/documents/organizations/$(organizationId)).data.members[request.auth.uid] != null;
  }
  
  function isOrgCreatorViaParentGet(organizationId) {
    return request.auth != null &&
           exists(/databases/(default)/documents/organizations/$(organizationId)) &&
           'creatorUserId' in get(/databases/(default)/documents/organizations/$(organizationId)).data &&
           get(/databases/(default)/documents/organizations/$(organizationId)).data.creatorUserId == request.auth.uid;
  }

  // Web org setup: user just created organizations/{id} and is writing their own users/{authUid} profile.
  function isOrgBootstrapAdminProfileCreate(userId) {
    return request.auth != null &&
           request.auth.uid == userId &&
           'organizationId' in request.resource.data &&
           organizationExists(request.resource.data.organizationId) &&
           exists(/databases/(default)/documents/organizations/$(request.resource.data.organizationId)) &&
           'members' in get(/databases/(default)/documents/organizations/$(request.resource.data.organizationId)).data &&
           get(/databases/(default)/documents/organizations/$(request.resource.data.organizationId)).data.members[request.auth.uid] == 'admin';
  }

  // Self-create only (request.auth.uid == userId). Admin/manager invite placeholders omit these.
  function selfCreateHasAgeConfirmation() {
    return request.resource.data.ageConfirmed == true &&
           request.resource.data.ageConfirmedYears is number &&
           request.resource.data.ageConfirmedAt is timestamp;
  }

  // Invite accept: organizations/{org}/userEmails/{email} still points at the UUID placeholder
  // Add User wrote (not an Auth uid). The placeholder must be pending (passwordSet not true),
  // in this org, and hold this same email — so a live member or the Deleted-user tombstone
  // (email '', passwordSet true) never qualifies. Lets the invitee create users/{authUid}
  // before the claim moves to authUid.
  function inviteClaimIsPendingPlaceholder(organizationId, emailKey) {
    let claimPath = /databases/(default)/documents/organizations/$(organizationId)/userEmails/$(emailKey);
    let claimed = exists(claimPath) ? get(claimPath).data.get('userId', '') : '';
    return claimed is string && claimed != '' && !claimed.matches('.*/.*') &&
      pendingPlaceholderFor(claimed, organizationId, emailKey);
  }
  function pendingPlaceholderFor(placeholderId, organizationId, emailKey) {
    let path = /databases/(default)/documents/users/$(placeholderId);
    let placeholder = exists(path) ? get(path).data : {};
    return exists(path) &&
           placeholder.get('passwordSet', false) != true &&
           placeholder.get('email', null) is string &&
           placeholder.email.lower() == emailKey &&
           'organizationId' in placeholder &&
           userDocOrganizationMatches(placeholder, organizationId);
  }

  // Fields that decide what an account may do. A self-created profile may not choose its own.
  function permissionValue(data, key) {
    return data.get('permissions', {}) is map ? data.get('permissions', {}).get(key, null) : null;
  }

  // A flag counts when it is on at the top level or inside `permissions`.
  function staffFlag(data, key) {
    return truthyBool(data.get(key, false)) || truthyBool(permissionValue(data, key));
  }

  function isOperativeProfile(data) {
    return staffFlag(data, 'operativeMode') || data.get('role', '') == 'operative';
  }

  // `next` has no privilege `source` lacks. Missing and false are the same; an operative stays one.
  function noMorePrivilegeThan(next, source) {
    return (!staffFlag(next, 'isSuperAdmin') || staffFlag(source, 'isSuperAdmin')) &&
           (!staffFlag(next, 'adminAccess') || staffFlag(source, 'adminAccess')) &&
           (!staffFlag(next, 'manager') || staffFlag(source, 'manager')) &&
           (!staffFlag(next, 'operatives') || staffFlag(source, 'operatives')) &&
           (!(next.get('role', '') in ['admin', 'manager']) || next.get('role', '') == source.get('role', '')) &&
           (!isOperativeProfile(source) || isOperativeProfile(next));
  }

  function raisesPrivileges(next) {
    return staffFlag(next, 'isSuperAdmin') ||
           staffFlag(next, 'adminAccess') ||
           staffFlag(next, 'manager') ||
           staffFlag(next, 'operatives') ||
           next.get('role', '') in ['admin', 'manager'];
  }

  // Self-create (users/{authUid}) into an existing company. Either the invitee copies the pending
  // placeholder an admin wrote (no privilege it lacks), or a returning member whose email claim
  // already names this account and who is in the company's members map. Admin flags need an
  // 'admin' entry in that map. A company that never invited or listed this account is refused.
  function selfCreateJoinsCompany(organizationId, emailKey) {
    let claimPath = /databases/(default)/documents/organizations/$(organizationId)/userEmails/$(emailKey);
    return (
      inviteClaimIsPendingPlaceholder(organizationId, emailKey) &&
      selfCreateCopiesPlaceholder(get(claimPath).data.userId)
    ) || (
      exists(claimPath) &&
      get(claimPath).data.userId == request.auth.uid &&
      isOrgMemberViaParentGet(organizationId) &&
      // 1.12.0 (B3): a returning member re-creating their own profile brings no alias ids (deleting and re-creating
      // it must not be a way round the self-update lock).
      selfCreateAliasesWithin(request.resource.data, {}, '') &&
      (
        !raisesPrivileges(request.resource.data) ||
        get(/databases/(default)/documents/organizations/$(organizationId)).data.members[request.auth.uid] == 'admin'
      )
    );
  }

  // The invitee's new profile has no privilege the placeholder lacks and (1.12.0, B3) alias ids only from the
  // placeholder, plus its own id.
  function selfCreateCopiesPlaceholder(placeholderId) {
    let placeholder = get(/databases/(default)/documents/users/$(placeholderId)).data;
    return noMorePrivilegeThan(request.resource.data, placeholder) &&
      selfCreateAliasesWithin(request.resource.data, placeholder, placeholderId);
  }

  // Admin of this company: users/{uid}.organizationId plus admin flags, or 'admin' in its members map.
  function isAdminOfCompany(organizationId) {
    // Members map first: one get. isOrganizationAdmin runs the long organizationId match.
    return organizationId is string &&
           (isOrgAdminViaMembersMap(organizationId) || isOrganizationAdmin(organizationId));
  }

  // The claim for the signed-in email, pointed at the signed-in account. Allowed when the claim
  // is new, already names this account, names this invite's pending placeholder, or names a
  // users document that no longer exists. A live claim for another account is not taken over.
  function isOwnEmailClaimWrite(organizationId, emailKey) {
    return request.resource.data.userId == request.auth.uid &&
           request.auth.token.email is string &&
           emailKey == request.auth.token.email.lower() &&
           (
             resource == null ||
             resource.data.userId == request.auth.uid ||
             inviteClaimIsPendingPlaceholder(organizationId, emailKey) ||
             !exists(/databases/(default)/documents/users/$(resource.data.userId))
           );
  }

  // Rulebook 1.12.0 (H2, lib/canonical organizationMemberActive): deactivated in this organisation. Two sources, read
  // where the role is read so the check costs no extra document in most rules:
  //   - this organisation's own users document (`organizationId` names it): `isActive` false;
  //   - for a member whose users document names another company: their membership here,
  //     users/{uid}/orgMemberships/{orgId}.accountActive (else isActive) false.
  // Only an explicit false deactivates; a missing document or flag is active (older data, founder bootstrap). A
  // deactivated person still reads their own users document and memberships (the apps show the deactivated screen).
  // Rulebook 1.12.1 §17/§18: the job and booking read scoping of 1.10.0 / 1.11.0 applies only once the platform owner
  // has set `platformConfig/app.enforcedReads` to true (after both backfills and an app release with
  // ENFORCED_READS_ACTIVE true). Until then every member of the organisation reads its jobs and bookings as before
  // 1.10.0. One document read, shared by every rule that asks. Writes are never switched by it.
  function enforcedReadsOn() {
    let config = /databases/(default)/documents/platformConfig/app;
    return exists(config) && get(config).data.get('enforcedReads', false) == true;
  }

  function callerHomeInactiveIn(organizationId) {
    let home = callerHomeData();
    return home.get('isActive', true) == false && homeOrgIs(home, organizationId);
  }
  function callerMembershipDeactivated(organizationId) {
    let membership = /databases/(default)/documents/users/$(request.auth.uid)/orgMemberships/$(organizationId);
    return exists(membership) &&
      get(membership).data.get('accountActive', get(membership).data.get('isActive', true)) == false;
  }

  // For subcollections under organizations/{organizationId}/… only (parent get is not the resource being read).
  // 1.12.0 (H2): never for a person this organisation has deactivated.
  function belongsToOrganization(organizationId) {
    return request.auth != null && (
      userOrgIdMatchesPath(organizationId)
        ? callerHomeData().get('isActive', true) != false
        : ((isOrgMemberViaParentGet(organizationId) || isOrgCreatorViaParentGet(organizationId)) &&
           !callerMembershipDeactivated(organizationId))
    );
  }

  function canAccessOrganization(organizationId) {
    return isPlatformOwner() || belongsToOrganization(organizationId);
  }

  function billingUnchanged() {
    return (!('billing' in resource.data) && !('billing' in request.resource.data))
      || request.resource.data.billing == resource.data.billing;
  }
  
  // Treat missing or blank addedByUserId like legacy rows (see canDeleteOwnMaterial / canClaimLegacyOwnMaterial).
  function resourceMaterialHasNonEmptyOwnerUid() {
    return resource != null &&
           'addedByUserId' in resource.data &&
           resource.data.addedByUserId is string &&
           resource.data.addedByUserId.size() > 0;
  }

  function isMaterialOwnerForRequest() {
    return request.auth != null && (
      (resourceMaterialHasNonEmptyOwnerUid() && resource.data.addedByUserId == request.auth.uid) ||
      (
        request.resource.data.addedByUserId is string &&
        request.resource.data.addedByUserId.size() > 0 &&
        request.resource.data.addedByUserId == request.auth.uid
      )
    );
  }

  function legacyMaterialAddedByMatchesCurrentUser() {
    return request.auth != null &&
           exists(/databases/(default)/documents/users/$(request.auth.uid)) &&
           resource.data.addedBy is string &&
           (
             (
               'email' in get(/databases/(default)/documents/users/$(request.auth.uid)).data &&
               get(/databases/(default)/documents/users/$(request.auth.uid)).data.email is string &&
               resource.data.addedBy.lower() == get(/databases/(default)/documents/users/$(request.auth.uid)).data.email.lower()
             ) ||
             (
               'firstName' in get(/databases/(default)/documents/users/$(request.auth.uid)).data &&
               'surname' in get(/databases/(default)/documents/users/$(request.auth.uid)).data &&
               get(/databases/(default)/documents/users/$(request.auth.uid)).data.firstName is string &&
               get(/databases/(default)/documents/users/$(request.auth.uid)).data.surname is string &&
               resource.data.addedBy.lower() == (
                 get(/databases/(default)/documents/users/$(request.auth.uid)).data.firstName + ' ' +
                 get(/databases/(default)/documents/users/$(request.auth.uid)).data.surname
               ).lower()
             ) ||
             (
               'firstName' in get(/databases/(default)/documents/users/$(request.auth.uid)).data &&
               'lastName' in get(/databases/(default)/documents/users/$(request.auth.uid)).data &&
               get(/databases/(default)/documents/users/$(request.auth.uid)).data.firstName is string &&
               get(/databases/(default)/documents/users/$(request.auth.uid)).data.lastName is string &&
               resource.data.addedBy.lower() == (
                 get(/databases/(default)/documents/users/$(request.auth.uid)).data.firstName + ' ' +
                 get(/databases/(default)/documents/users/$(request.auth.uid)).data.lastName
               ).lower()
             )
           );
  }

  function canClaimLegacyOwnMaterial(organizationId) {
    return canAccessOrganization(organizationId) &&
           userOrgIdMatchesPath(organizationId) &&
           !resourceMaterialHasNonEmptyOwnerUid() &&
           request.resource.data.addedByUserId is string &&
           request.resource.data.addedByUserId.size() > 0 &&
           request.resource.data.addedByUserId == request.auth.uid &&
           legacyMaterialAddedByMatchesCurrentUser();
  }

  function isOnlyClaimingLegacyOwnMaterial(organizationId) {
    return canClaimLegacyOwnMaterial(organizationId) &&
           request.resource.data.diff(resource.data).affectedKeys().hasOnly(['addedByUserId']);
  }
  
  function canCreateOwnMaterial(organizationId) {
    return canAccessOrganization(organizationId) &&
           request.resource.data.addedByUserId is string &&
           request.resource.data.addedByUserId.size() > 0 &&
           request.resource.data.addedByUserId == request.auth.uid;
  }
  
  function canUpdateOwnMaterial(organizationId) {
    return canAccessOrganization(organizationId) &&
           isMaterialOwnerForRequest() &&
           (request.resource.data.addedByUserId == resource.data.addedByUserId);
  }

  function canDeleteOwnMaterial(organizationId) {
    return canAccessOrganization(organizationId) && (
      (resourceMaterialHasNonEmptyOwnerUid() && resource.data.addedByUserId == request.auth.uid) ||
      (!resourceMaterialHasNonEmptyOwnerUid() && legacyMaterialAddedByMatchesCurrentUser())
    );
  }
  
  // Helper function to check if user is admin of organization
  // Includes adminAccess so users with admin permissions can update org (e.g. members map on user delete).
  function isOrganizationAdmin(organizationId) {
    return request.auth != null &&
           exists(/databases/(default)/documents/users/$(request.auth.uid)) &&
           userOrgIdMatchesPath(organizationId) &&
           adminLikeUser(get(/databases/(default)/documents/users/$(request.auth.uid)).data) &&
           get(/databases/(default)/documents/users/$(request.auth.uid)).data.get('isActive', true) != false;
  }

  // Rulebook 1.10.0 (H2): a person's role in an organisation comes from that organisation. Their users/{uid}
  // flags count only when that document is this company's (users/{uid}.organizationId); otherwise the role is this
  // company's members map entry. A manager in company A who is an operative (or member) in company B is never a
  // manager in B.
  function callerListedRole(organizationId) {
    return exists(/databases/(default)/documents/organizations/$(organizationId)) ?
      get(/databases/(default)/documents/organizations/$(organizationId)).data.get('members', {}).get(request.auth.uid, '') : '';
  }
  function callerHomeData() {
    return exists(/databases/(default)/documents/users/$(request.auth.uid)) ?
      get(/databases/(default)/documents/users/$(request.auth.uid)).data : {};
  }
  // users/{uid}.organizationId names this organisation (string, "organizations/<id>" path string, or reference).
  function homeOrgIs(home, organizationId) {
    let v = home.get('organizationId', '');
    let org = organizationId.lower();
    return (v is string && (v.trim().lower() == org || v.lower().matches('(^|.*/)organizations/' + org + '$'))) ||
      (v is path && string(v).lower().matches('.*/organizations/' + org + '$'));
  }
  // The caller's role in THIS organisation: 'admin' | 'manager' | 'operative' | 'member' | the listed role | ''.
  // 1.11.0: an admin is an admin (no operative mode, permissionLevelOf); otherwise operative mode wins
  // (lib/canonical staffAccess: operative mode is never staff).
  // 1.12.0 (H2): '' for a person this organisation has deactivated (callerHomeInactiveIn / callerMembershipDeactivated), so every rule built on the
  // role refuses them.
  function callerOrgRole(organizationId) {
    let listed = callerListedRole(organizationId);
    let home = callerHomeData();
    return homeOrgIs(home, organizationId) ? (
      home.get('isActive', true) == false ? '' : (
        (listed == 'admin' || adminLikeUser(home)) ? 'admin' : (
          isOperativeProfile(home) ? 'operative' : (materialManagerLikeUser(home) ? 'manager' : 'member')
        )
      )
    ) : ((listed != '' && callerMembershipDeactivated(organizationId)) ? '' : listed);
  }

  // Rulebook 1.11.0 (lib/canonical/inviteAccept.ts invitationRole): the role an invitation gives — its `role`, else
  // the kind its permissions give, else 'member'.
  function invitationRole(inv) {
    let perms = inv.get('permissions', {});
    return inv.get('role', '') in ['admin', 'manager', 'operative', 'member'] ? inv.get('role', '') : (
      !(perms is map) || perms.size() == 0 ? 'member' : (
        perms.get('adminAccess', false) == true ? 'admin' : (perms.get('operativeMode', false) == true ? 'operative' : 'manager')
      )
    );
  }

  // Rulebook 1.12.0 (B2, lib/canonical invitationIsOperativeOnly): an invitation that gives an operative and nothing
  // more — role operative (`invitationRole`), operative mode on, and no admin, super admin, manager or operatives
  // toggle at the top level or in `permissions`. The same test as managerCanCreateOperativeUser on users/{uid}: the
  // only invitation a manager with operatives access may create, change or hold.
  function invitationIsOperativeOnly(inv) {
    let perms = inv.get('permissions', {}) is map ? inv.get('permissions', {}) : {};
    return invitationRole(inv) == 'operative' &&
      (truthyBool(perms.get('operativeMode', false)) || inv.get('role', '') == 'operative') &&
      !truthyBool(perms.get('adminAccess', false)) && !truthyBool(perms.get('isSuperAdmin', false)) &&
      !truthyBool(perms.get('manager', false)) && !truthyBool(perms.get('operatives', false)) &&
      !truthyBool(inv.get('adminAccess', false)) && !truthyBool(inv.get('isSuperAdmin', false)) &&
      !truthyBool(inv.get('manager', false)) && !truthyBool(inv.get('operatives', false));
  }

  // A genuine, unused invitation (`invitations/{invId}`) to the signed-in email for this organisation, marked used in
  // the same batch (inviteMembershipWrites). The one source of an accepting person's access in that organisation.
  function inviteBeingAccepted(invId, organizationId) {
    let path = /databases/(default)/documents/invitations/$(invId);
    return invId is string && invId.size() > 0 && !invId.matches('.*/.*') && exists(path) &&
      get(path).data.get('isUsed', false) != true &&
      getAfter(path).data.get('isUsed', false) == true &&
      get(path).data.get('organizationId', '') == organizationId &&
      request.auth.token.email is string &&
      string(get(path).data.get('email', '')).lower() == request.auth.token.email.lower();
  }
  // Admin or manager of THIS organisation, never operative mode (lib/canonical/staffAccess.ts isStaffAccount).
  function isOrgManagerOrAdmin(organizationId) {
    return request.auth != null && organizationId is string &&
      callerOrgRole(organizationId) in ['admin', 'manager'];
  }
  // Staff who may open Send in THIS organisation: not an operative here.
  function isOrgNonOperativeMember(organizationId) {
    return request.auth != null && (
      callerOrgRole(organizationId) in ['admin', 'manager'] ||
      (homeOrgIs(callerHomeData(), organizationId) && !isOperativeLikeUser(callerHomeData()))
    );
  }

  function isOrganizationMaterialManager(organizationId) {
    return isOrgManagerOrAdmin(organizationId);
  }

  function isOperativeLikeUser(userData) {
    return ('operativeMode' in userData && truthyBool(userData.operativeMode)) ||
           ('role' in userData && userData.role == 'operative');
  }

  // Staff who can open Send (not operatives). Membership is enough — do not
  // require users/{uid}.organizationId to be this company (multi-org / stale
  // primary org used to fail the send-history write after the email went out).
  function canWriteMaterialSendRecord(organizationId) {
    return request.auth != null &&
           canAccessOrganization(organizationId) &&
           isOrgNonOperativeMember(organizationId);
  }

  // Rulebook 1.9.0: a Send status update may carry write metadata (`updatedBy` = the signed-in user,
  // `updatedFrom` a known platform). Checked inline: the materials update rule is close to the expression limit.
  function isStaffMaterialStatusWrite(organizationId) {
    let affected = request.resource.data.diff(resource.data).affectedKeys();
    return affected.hasOnly(['status', 'lastSentAt', 'lastSentRequestType', 'updatedAt', 'updatedBy', 'updatedFrom']) &&
           (!('updatedBy' in affected) || request.resource.data.updatedBy == request.auth.uid) &&
           (!('updatedFrom' in affected) || request.resource.data.updatedFrom in ['web', 'ios', 'android']) &&
           canWriteMaterialSendRecord(organizationId);
  }

  // Admin of org by members map (works before users/{uid} profile exists — web org bootstrap).
  function isOrgAdminViaMembersMap(organizationId) {
    return request.auth != null &&
           exists(/databases/(default)/documents/organizations/$(organizationId)) &&
           'members' in get(/databases/(default)/documents/organizations/$(organizationId)).data &&
           get(/databases/(default)/documents/organizations/$(organizationId)).data.members[request.auth.uid] == 'admin' &&
           !callerHomeInactiveIn(organizationId);
  }
  
  // Helper function to check if current user is super admin or has admin access
  // Firestore rules only support boolean expressions, not if/let statements
  // 
  // WHO CAN CREATE USERS:
  // ✅ Super Admin (isSuperAdmin == true)
  // ✅ Admins (adminAccess == true OR role == 'admin')
  // ✅ Managers with operatives permission — operative accounts only (operativeMode == true)
  // ❌ Managers without operatives permission — cannot create users
  // ❌ Operatives (operativeMode == true) — CANNOT create users
  //
  // Managers and operatives can create their own accounts during website signup (self-creation path).
  function isManagerWithOperativesAccess() {
    return request.auth != null &&
           exists(/databases/(default)/documents/users/$(request.auth.uid)) &&
           !('operativeMode' in get(/databases/(default)/documents/users/$(request.auth.uid)).data &&
             truthyBool(get(/databases/(default)/documents/users/$(request.auth.uid)).data.operativeMode)) &&
           ('manager' in get(/databases/(default)/documents/users/$(request.auth.uid)).data &&
             truthyBool(get(/databases/(default)/documents/users/$(request.auth.uid)).data.manager)) &&
           ('operatives' in get(/databases/(default)/documents/users/$(request.auth.uid)).data &&
             truthyBool(get(/databases/(default)/documents/users/$(request.auth.uid)).data.operatives));
  }

  function managerCanCreateOperativeUser() {
    return isManagerWithOperativesAccess() &&
           'organizationId' in request.resource.data &&
           'organizationId' in get(/databases/(default)/documents/users/$(request.auth.uid)).data &&
           orgIdsMatch(
             get(/databases/(default)/documents/users/$(request.auth.uid)).data.organizationId,
             request.resource.data.organizationId
           ) &&
           (
             ('operativeMode' in request.resource.data && truthyBool(request.resource.data.operativeMode)) ||
             ('role' in request.resource.data && request.resource.data.role == 'operative')
           ) &&
           !('adminAccess' in request.resource.data && truthyBool(request.resource.data.adminAccess)) &&
           !('isSuperAdmin' in request.resource.data && truthyBool(request.resource.data.isSuperAdmin));
  }

  function isAdminOrSuperAdmin() {
    return request.auth != null && 
           exists(/databases/(default)/documents/users/$(request.auth.uid)) &&
           adminLikeUser(get(/databases/(default)/documents/users/$(request.auth.uid)).data);
  }

  // App owner only (Project Planner), never an organisation admin.
  // Rulebook 1.12.0 (B1, isPlatformOwnerEmail): only the signed-in Auth token's email, and only once Firebase Auth has
  // verified it. The users document's `email` is never read here — anyone could write their own.
  function isPlatformOwner() {
    return request.auth != null &&
      request.auth.token.email is string &&
      request.auth.token.email.lower() == 'info@projectplanner.us' &&
      request.auth.token.email_verified == true;
  }

  // Variations: every admin and manager of the org (isOrgManagerOrAdmin). Never an operative.
  // Do not look up the job's assigned-manager list here — that extra get() made
  // every variation read/write slow and denied managers who can already see the job.
  function canAdminVariations(organizationId) {
    return isOrganizationAdmin(organizationId) ||
      isOrgAdminViaMembersMap(organizationId) ||
      isPlatformOwner();
  }

  // 1.10.0: the manager test is this organisation's role (isOrgManagerOrAdmin), never another company's flags.
  function canAccessVariationsStaff(organizationId) {
    return canAdminVariations(organizationId) || isOrgManagerOrAdmin(organizationId);
  }

  // A manager with operative-management access (manager + operatives, not operative mode) in the
  // same company as `targetData`, which is another person's operative users document. The one
  // test for who besides an admin may change an operative's pay, on users/{uid}
  // (canManagerUpdateOperativeProfile), operativeProfiles and operativeDayRateHistory.
  function managerMayManageOperative(targetUserId, targetData) {
    return request.auth != null &&
           request.auth.uid != targetUserId &&
           exists(/databases/(default)/documents/users/$(request.auth.uid)) &&
           ('organizationId' in targetData) &&
           ('organizationId' in get(/databases/(default)/documents/users/$(request.auth.uid)).data) &&
           orgIdsMatch(
             get(/databases/(default)/documents/users/$(request.auth.uid)).data.organizationId,
             targetData.organizationId
           ) &&
           !('operativeMode' in get(/databases/(default)/documents/users/$(request.auth.uid)).data &&
             truthyBool(get(/databases/(default)/documents/users/$(request.auth.uid)).data.operativeMode)) &&
           ('manager' in get(/databases/(default)/documents/users/$(request.auth.uid)).data &&
             truthyBool(get(/databases/(default)/documents/users/$(request.auth.uid)).data.manager)) &&
           ('operatives' in get(/databases/(default)/documents/users/$(request.auth.uid)).data &&
             truthyBool(get(/databases/(default)/documents/users/$(request.auth.uid)).data.operatives)) &&
           (
             ('operativeMode' in targetData && truthyBool(targetData.operativeMode)) ||
             ('permissions' in targetData && targetData.permissions is map && 'operativeMode' in targetData.permissions && truthyBool(targetData.permissions.operativeMode)) ||
             ('role' in targetData && targetData.role == 'operative')
           );
  }

  // Managers with operative-management access may edit limited operative profile fields on users docs.
  function canManagerUpdateOperativeProfile(targetUserId) {
    return managerMayManageOperative(targetUserId, resource.data) &&
           request.resource.data.diff(resource.data).changedKeys().hasOnly([
             'assignedManagerUserId',
             'assignedManagerUserIds',
             'hasNoLineManager',
             'dayRate',
             'hourlyRate',
             'payBasis',
             'annualLeaveEnabled',
             'annualLeaveDaysPerYear',
             'annualLeaveYearStartMonth',
             'annualLeaveYearEndMonth',
             'annualLeaveCarriesOver',
             'employmentType',
             'employmentTypeTransitionFrom',
             'employmentTypeEffectiveAt',
             'updatedAt',
             'updatedBy',
             'updatedFrom'
           ]) &&
           writeMetadataValidWhenPresent();
  }

  function flagOn(data, key) {
    return data != null && key in data && truthyBool(data[key]);
  }

  function alreadyPrivilegedAdmin(data) {
    return flagOn(data, 'isSuperAdmin') ||
           flagOn(data, 'adminAccess') ||
           ('role' in data && data.role == 'admin') ||
           ('permissions' in data && data.permissions is map && flagOn(data.permissions, 'adminAccess'));
  }

  // Self-update may repair missing top-level admin flags on an existing admin.
  // It must not let an operative set adminAccess, isSuperAdmin, role, or organizationId.
  function userSelfUpdateKeepsPrivileges() {
    return resource != null &&
           (!('organizationId' in request.resource.data) ||
            ('organizationId' in resource.data &&
             orgIdsMatch(request.resource.data.organizationId, resource.data.organizationId))) &&
           (!('role' in request.resource.data) ||
            ('role' in resource.data && request.resource.data.role == resource.data.role) ||
            (alreadyPrivilegedAdmin(resource.data) && request.resource.data.role == 'admin')) &&
           (!flagOn(request.resource.data, 'adminAccess') || alreadyPrivilegedAdmin(resource.data)) &&
           (!flagOn(request.resource.data, 'isSuperAdmin') || flagOn(resource.data, 'isSuperAdmin')) &&
           (
             !('permissions' in request.resource.data) ||
             !(request.resource.data.permissions is map) ||
             !flagOn(request.resource.data.permissions, 'adminAccess') ||
             alreadyPrivilegedAdmin(resource.data)
           ) &&
           selfUpdateKeepsIdentityLinks() &&
           selfUpdateKeepsManagedFields();
  }

  // Rulebook 1.12.0 (B1, B3): on their own document a person never changes the fields other rules trust as who they
  // are. `email` changes only to the signed-in Auth email (the sync after Firebase Auth has changed the sign-in email,
  // `verifyBeforeUpdateEmail`); `formerUserIds` and `sameEmailUserIds` (the ids the rules and pay treat as theirs,
  // `personIdSet`) never change on a self-update — admins, invite acceptance and the admin backfill write them. Admins
  // editing a person go through the admin branch, not this one.
  function selfUpdateKeepsIdentityLinks() {
    let changed = request.resource.data.diff(resource.data).affectedKeys();
    return (!('email' in changed) || (
             request.resource.data.get('email', null) is string &&
             request.auth.token.email is string &&
             request.resource.data.email.trim().lower() == request.auth.token.email.lower()
           )) &&
           !changed.hasAny(['formerUserIds', 'sameEmailUserIds']);
  }

  // A list field as a set (missing or not a list: empty).
  function idSetOf(data, key) {
    return data.get(key, null) is list ? data.get(key, null).toSet() : [].toSet();
  }
  function idListOrMissing(data, key) {
    return data.get(key, null) == null || data.get(key, null) is list;
  }
  // 1.12.0 (B3): a self-created profile carries no alias ids except what the invite placeholder it copies already had,
  // plus that placeholder's own id (`inviteMigrationFormerIdWriteFields`). `placeholderId` '' means no placeholder.
  function selfCreateAliasesWithin(next, source, placeholderId) {
    return idListOrMissing(next, 'formerUserIds') && idListOrMissing(next, 'sameEmailUserIds') &&
      idSetOf(next, 'formerUserIds').difference(idSetOf(source, 'formerUserIds')).hasOnly([placeholderId]) &&
      idSetOf(next, 'sameEmailUserIds').difference(idSetOf(source, 'sameEmailUserIds')).size() == 0;
  }

  // Effective flag for a key that defaults to true when missing (dailyOverview, wholesalersOrderHistory):
  // off only when the top level or `permissions` says false.
  function defaultOnFlag(data, key) {
    return !(data.get(key, true) == false || data.get(key, true) == 0 ||
             permissionValue(data, key) == false || permissionValue(data, key) == 0);
  }

  // Permission toggles a person may not switch on for themselves (Manage Users sets them). Kept as
  // all-false maps so one diff() finds every toggle that is on: a key present with a value other
  // than false. materials and siteAudit are locked only for an operative, because iOS saveUser
  // forces them on for every non-operative.
  function lockedPermissionFalseMap(includeOperativeOnlyKeys) {
    return includeOperativeOnlyKeys
      ? {'manager': false, 'operatives': false, 'qualifications': false, 'projects': false, 'smallWorks': false,
         'annualLeaveSelfBook': false, 'weeklyReports': false, 'subContractors': false,
         'materials': false, 'siteAudit': false}
      : {'manager': false, 'operatives': false, 'qualifications': false, 'projects': false, 'smallWorks': false,
         'annualLeaveSelfBook': false, 'weeklyReports': false, 'subContractors': false};
  }

  // Locked toggles that are on at the top level or in `permissions`.
  function lockedPermissionsOn(data, falseMap) {
    return data.diff(falseMap).changedKeys().union(
      data.get('permissions', {}) is map ? data.get('permissions', {}).diff(falseMap).changedKeys() : [].toSet()
    );
  }

  // Toggles that default to on (dailyOverview, wholesalersOrderHistory): explicitly false somewhere.
  function defaultOnPermissionsOff(data) {
    return data.diff({'dailyOverview': false, 'wholesalersOrderHistory': false}).unchangedKeys().union(
      data.get('permissions', {}) is map
        ? data.get('permissions', {}).diff({'dailyOverview': false, 'wholesalersOrderHistory': false}).unchangedKeys()
        : [].toSet()
    );
  }

  // `next` turns on no permission toggle that `prev` had off, and an operative stays one.
  function selfPermissionsNotRaised(next, prev, topChanged) {
    return lockedPermissionsOn(prev, lockedPermissionFalseMap(isOperativeProfile(prev))).hasAll(
             lockedPermissionsOn(next, lockedPermissionFalseMap(isOperativeProfile(prev)))) &&
           // A default-on toggle that was off stays off.
           defaultOnPermissionsOff(next).hasAll(defaultOnPermissionsOff(prev)) &&
           (!(topChanged.hasAny(['operativeMode', 'role', 'permissions'])) ||
            !isOperativeProfile(prev) || isOperativeProfile(next));
  }

  // `assignedManagerUserIds`, or the legacy single id when that list is empty (lib/canonical/userTimesheetAccess.ts).
  function lineManagerIdList(data) {
    return (data.get('assignedManagerUserIds', null) is list && data.get('assignedManagerUserIds', null).size() > 0)
      ? data.get('assignedManagerUserIds', null)
      : ((data.get('assignedManagerUserId', null) is string && data.get('assignedManagerUserId', null).size() > 0)
          ? [data.get('assignedManagerUserId', null)]
          : []);
  }

  function hasLineManager(data) {
    return data.get('hasNoLineManager', false) != true && lineManagerIdList(data).size() > 0;
  }

  // lib/canonical/leaveRequests.ts hasActiveLineManager, as far as rules can see: a listed line manager who
  // is not the person and, when exactly one is listed, whose users document exists and is not inactive
  // (rules cannot loop, so two or more listed ids count as having one). `uid` is the person's id.
  function hasCurrentLineManager(uid, data) {
    let ids = lineManagerIdList(data);
    return data.get('hasNoLineManager', false) != true && ids.size() > 0 && (
      ids.size() > 1 || (
        ids[0] != uid &&
        exists(/databases/(default)/documents/users/$(ids[0])) &&
        get(/databases/(default)/documents/users/$(ids[0])).data.get('isActive', true) != false
      )
    );
  }

  // Timestamps written by a client round-trip through ms (web Date) or a Swift Double (iOS Date),
  // so a resent unchanged instant can differ by under a millisecond. Within one second is the same.
  function sameInstantValue(a, b) {
    return a == b ||
      (a is timestamp && b is timestamp && a > b - duration.value(1, 's') && a < b + duration.value(1, 's')) ||
      (a is number && b is number && a > b - 1000 && a < b + 1000);
  }

  // Write metadata (lib/canonical/writeMetadata.ts writeMetadataFields). Optional while iOS does not
  // send it yet; when present, updatedBy is the signed-in account, updatedFrom a known platform, and
  // updatedAt a timestamp.
  // Only keys this write sets are checked, so a merge that keeps an earlier editor's stamp still passes.
  function writeMetadataValidWhenPresent() {
    return writeMetadataKeysValid(
      resource == null
        ? request.resource.data.keys().toSet()
        : request.resource.data.diff(resource.data).affectedKeys()
    );
  }

  function writeMetadataKeysValid(written) {
    return (!('updatedBy' in written) || request.resource.data.get('updatedBy', null) == request.auth.uid) &&
      (!('updatedFrom' in written) || request.resource.data.get('updatedFrom', null) in ['web', 'ios', 'android']) &&
      (!('updatedAt' in written) || request.resource.data.get('updatedAt', null) is timestamp);
  }

  // A plain value, with missing, null and '' the same.
  function sameLooseValue(a, b) {
    return a == b || ((a == null || a == '') && (b == null || b == ''));
  }

  // Pay, line manager, active state, employment type and permission toggles are set by an admin or
  // a manager with operatives access (Manage Users), never by the person on their own document.
  // Both apps resend the whole profile (iOS saveUser setData merge, web updateDoc), so only a real
  // change is refused: missing and the app default are the same value. An admin repairing their
  // own document keeps the existing exemption.
  function selfUpdateKeepsManagedFields() {
    let next = request.resource.data;
    let prev = resource.data;
    let changed = next.diff(prev).affectedKeys();
    return alreadyPrivilegedAdmin(prev) || (
      (!changed.hasAny(['dayRate', 'hourlyRate', 'payBasis']) || (
        next.get('dayRate', null) == prev.get('dayRate', null) &&
        next.get('hourlyRate', null) == prev.get('hourlyRate', null) &&
        sameLooseValue(next.get('payBasis', null), prev.get('payBasis', null))
      )) &&
      (!changed.hasAny(['isActive', 'hasNoLineManager']) || (
        truthyBool(next.get('isActive', true)) == truthyBool(prev.get('isActive', true)) &&
        truthyBool(next.get('hasNoLineManager', false)) == truthyBool(prev.get('hasNoLineManager', false))
      )) &&
      (!changed.hasAny(['assignedManagerUserId', 'assignedManagerUserIds']) || (
        lineManagerIdList(next) == lineManagerIdList(prev) &&
        (sameLooseValue(next.get('assignedManagerUserId', null), prev.get('assignedManagerUserId', null)) ||
         next.get('assignedManagerUserId', null) in lineManagerIdList(next))
      )) &&
      (!changed.hasAny(['employmentType', 'employmentTypeTransitionFrom', 'employmentTypeEffectiveAt']) || (
        next.get('employmentType', 'paye') == prev.get('employmentType', 'paye') &&
        sameLooseValue(next.get('employmentTypeTransitionFrom', null), prev.get('employmentTypeTransitionFrom', null)) &&
        sameInstantValue(next.get('employmentTypeEffectiveAt', null), prev.get('employmentTypeEffectiveAt', null))
      )) &&
      (!changed.hasAny(['permissions', 'manager', 'operatives', 'qualifications', 'projects', 'smallWorks',
                        'annualLeaveSelfBook', 'weeklyReports', 'subContractors', 'dailyOverview',
                        'wholesalersOrderHistory', 'materials', 'siteAudit', 'operativeMode', 'role']) ||
       selfPermissionsNotRaised(next, prev, changed))
    );
  }


  // An organisation id stored on a document: an id, an "organizations/<id>" string or a reference.
  function docOrganizationId(data) {
    let v = data.get('organizationId', '');
    let raw = v is path ? string(v) : (v is string ? v : '');
    let parts = raw.split('/');
    return parts.size() > 0 ? parts[parts.size() - 1].trim() : '';
  }
  function orgCreatorIs(org, uid) {
    return org != '' && !org.matches('.*[.].*') &&
      exists(/databases/(default)/documents/organizations/$(org)) &&
      get(/databases/(default)/documents/organizations/$(org)).data.get('creatorUserId', '') == uid;
  }
  // 1.12.0 (B4): a self-created profile is super admin only for the organisation's creator (deleting and re-creating
  // one's own profile is not a way to become super admin).
  function selfCreateSuperAdminAllowed() {
    return !staffFlag(request.resource.data, 'isSuperAdmin') ||
      orgCreatorIs(docOrganizationId(request.resource.data), request.auth.uid);
  }
  // Rulebook 1.12.0 (B4, §16): the current Super Admin of this organisation — its creator, or a users document of
  // this organisation that is already super admin. Never a flag the caller set on themselves (see below).
  function callerIsSuperAdminOf(org) {
    return orgCreatorIs(org, request.auth.uid) ||
      (staffFlag(callerHomeData(), 'isSuperAdmin') && org != '' && homeOrgIs(callerHomeData(), org));
  }
  // 1.12.0 (B4): an admin who is not the Super Admin never changes `isSuperAdmin` on anyone (their own document
  // included) and never changes the role, permissions, active flag or company of the Super Admin or the creator.
  // Ownership moves only as §16 says (the current Super Admin, or the platform owner).
  function adminUpdateKeepsTopAccount(userId) {
    let next = request.resource.data;
    let prev = resource.data;
    let org = docOrganizationId(prev);
    return callerIsSuperAdminOf(org) || (
      staffFlag(next, 'isSuperAdmin') == staffFlag(prev, 'isSuperAdmin') && (
        !next.diff(prev).affectedKeys().hasAny(['isSuperAdmin', 'adminAccess', 'role', 'permissions', 'operativeMode',
          'manager', 'operatives', 'isActive', 'organizationId']) ||
        !(staffFlag(prev, 'isSuperAdmin') || orgCreatorIs(org, userId))
      )
    );
  }

  // Rulebook 1.11.0 (rosterMembersForOrganization): the reader's own company, from their users document
  // (`organizationId` as an id, an "organizations/<id>" string or a reference).
  function callerHomeOrgId() {
    let v = callerHomeData().get('organizationId', '');
    let raw = v is path ? string(v) : (v is string ? v : '');
    let parts = raw.split('/');
    return parts.size() > 0 ? parts[parts.size() - 1].trim() : '';
  }
  // The person is anchored on the reader's company: a key of its `members` map or its creator. Lets co-members read a
  // member whose own users document names another company (a super admin who last opened another one).
  function anchoredInCallerCompany(userId) {
    let org = callerHomeOrgId();
    let path = /databases/(default)/documents/organizations/$(org);
    // 1.12.0 (H2): never for a person their company has deactivated.
    return org != '' && !org.matches('.*[.].*') && callerHomeData().get('isActive', true) != false && exists(path) && (
      get(path).data.get('members', {}).get(userId, null) != null ||
      get(path).data.get('creatorUserId', '') == userId
    );
  }

  function canReadUserDocument(userId) {
    return request.auth != null && (
      isPlatformOwner() ||
      request.auth.uid == userId ||
      (resource != null &&
       resource.data.email is string &&
       request.auth.token.email is string &&
       resource.data.email.lower() == request.auth.token.email.lower()) ||
      (resource != null &&
       'organizationId' in resource.data &&
       canAccessOrganization(resource.data.organizationId)) ||
      anchoredInCallerCompany(userId)
    );
  }
  
  // Helper function to validate organizationId exists
  function organizationExists(organizationId) {
    return exists(/databases/(default)/documents/organizations/$(organizationId));
  }
  
  match /databases/{database}/documents {
    // Invitees open /setup-password?token=<id> before they have an account, so get-by-id
    // stays public. List/create/delete are the inviting org's admin or manager, or the
    // platform owner — not any signed-in user. Update also allows the invitee to mark
    // isUsed after they set a password (same field lock as accountConfirmations).
    match /invitations/{invitationId} {
      function invitationOrgId() {
        return request.method == 'create'
          ? request.resource.data.organizationId
          : resource.data.organizationId;
      }

      function invitationAdmin() {
        return invitationOrgId() is string &&
          invitationOrgId().size() > 0 && (
            isPlatformOwner() ||
            isOrganizationAdmin(invitationOrgId()) ||
            isOrgAdminViaMembersMap(invitationOrgId())
          );
      }
      function invitationOperativesManager() {
        return invitationOrgId() is string && invitationOrgId().size() > 0 &&
          isManagerWithOperativesAccess() && userOrgIdMatchesPath(invitationOrgId()) &&
          callerHomeData().get('isActive', true) != false;
      }
      // 1.12.0 (B2): a manager with operatives access lists and deletes their company's invitations, and creates or
      // changes only an operative-only invitation (`invitationIsOperativeOnly`), before and after the write — never
      // an admin's or manager's invitation.
      function canAdministerInvitation() {
        return invitationAdmin() || (
          invitationOperativesManager() && (
            request.method in ['list', 'delete'] || (
              invitationIsOperativeOnly(request.resource.data) &&
              (request.method == 'create' || invitationIsOperativeOnly(resource.data))
            )
          )
        );
      }

      function canMarkInvitationUsed() {
        return request.auth != null &&
          resource.data.isUsed != true &&
          request.resource.data.isUsed == true &&
          request.resource.data.diff(resource.data).changedKeys().hasOnly(['isUsed', 'usedAt']) &&
          resource.data.email is string &&
          request.auth.token.email is string &&
          resource.data.email.lower() == request.auth.token.email.lower();
      }

      allow get: if true;
      allow list, create, delete: if canAdministerInvitation();
      allow update: if canAdministerInvitation() || canMarkInvitationUsed();
    }

    // Founder confirm-account email tokens. Get-by-id is public so the emailed link can mark the token used.
    // 1.12.0 (H5): never listed (each holds a founder's email, uid and organisation); created by the founder for
    // themselves; marked used only by the signed-in person whose email it names.
    match /accountConfirmations/{token} {
      allow get: if true;
      allow list: if false;
      allow create: if request.auth != null &&
                    request.resource.data.get('userId', '') == request.auth.uid;
      allow update: if request.auth != null
                    && request.auth.token.email is string
                    && resource.data.get('email', '') is string
                    && resource.data.get('email', '').lower() == request.auth.token.email.lower()
                    && resource.data.isUsed != true
                    && request.resource.data.isUsed == true
                    && request.resource.data.diff(resource.data).changedKeys().hasOnly(['isUsed', 'usedAt']);
      allow delete: if false;
    }
    
    // Users collection - with better validation
    //
    // Role / permission coherence when promoting or demoting accounts (operative ↔ manager ↔ admin)
    // is enforced in the iOS client via `UserRoleTransitionPolicy` + `UserStore.updateUserPermissions`.
    // That flow keeps `role`, boolean permission flags, and annual-leave behaviour aligned with the
    // Add user presets; pending holiday *requests* are deleted client-side when switching onto the
    // self-book path. Approved bookings are never deleted by that transition.
    match /users/{userId} {
      allow get: if canReadUserDocument(userId);
      allow list: if canReadUserDocument(userId);
      
      // Allow create if:
      // 1. User is creating themselves (by email match - for signup flow), OR
      // 2. Current user is super admin or has admin access (for admin user creation)
      // 3. Web org bootstrap: org creator writes users/{authUid} right after creating organizations/{id}
      // 
      // IMPORTANT: We check self-creation FIRST because:
      // - During signup, users create their own account via the website
      // - This doesn't require admin permissions
      // - This is fast and reliable (no document reads)
      //
      // For admin creation, we use inline checks instead of the function
      // because functions can be unreliable during CREATE operations.
      // This directly checks the user document in the rule itself.
      allow create: if request.auth != null && (
        // Path 1: Self-creation into a company that invited or lists this account.
        // A new company's founder uses Path 3. An email with no claim does not open any company.
        (request.auth.uid == userId &&
         request.resource.data.email is string &&
         request.auth.token.email is string &&
         request.resource.data.email.lower() == request.auth.token.email.lower() &&
         'organizationId' in request.resource.data &&
         request.resource.data.organizationId is string &&
         selfCreateHasAgeConfirmation() &&
         selfCreateJoinsCompany(request.resource.data.organizationId, request.resource.data.email.lower()) &&
         selfCreateSuperAdminAllowed()) ||
        // Path 2: Admin of the target company creating another user there (e.g. invite placeholder).
        // Not their own profile: that is Path 1 or Path 3, which require age confirmation.
        (request.auth.uid != userId &&
         'organizationId' in request.resource.data &&
         isAdminOfCompany(request.resource.data.organizationId)) ||
        // Path 3: Web org setup bootstrap (org exists, caller is admin in members map, writing own profile).
        // 1.12.0 (B3): a founder's new profile carries no alias ids.
        (isOrgBootstrapAdminProfileCreate(userId) && selfCreateHasAgeConfirmation() &&
         selfCreateAliasesWithin(request.resource.data, {}, '') && selfCreateSuperAdminAllowed()) ||
        // Path 4: Manager with operatives permission inviting a new operative
        managerCanCreateOperativeUser() ||
        // Path 5: Platform owner creating their own non-tenant profile
        (isPlatformOwner() && request.auth.uid == userId)
      );
      
      // Allow update if:
      // 1. User updating themselves without escalating admin / role / organizationId, OR
      // 2. Admin/Super Admin updating other users (for user management)
      allow update: if isPlatformOwner() || (request.auth != null && (
        (request.auth.uid == userId && userSelfUpdateKeepsPrivileges()) ||
        (resource.data.email is string &&
         request.auth.token.email is string &&
         resource.data.email.lower() == request.auth.token.email.lower() &&
         request.resource.data.email is string &&
         request.resource.data.email.lower() == request.auth.token.email.lower() &&
         userSelfUpdateKeepsPrivileges()) ||
        ('organizationId' in resource.data && isAdminOfCompany(resource.data.organizationId) &&
         adminUpdateKeepsTopAccount(userId)) ||
        canManagerUpdateOperativeProfile(userId)
      ) && (
        // No shortcut for the account's own document: an admin moving their own profile
        // into another company must be an admin of that company too.
        !('organizationId' in request.resource.data) ||
        (('organizationId' in resource.data && orgIdsMatch(request.resource.data.organizationId, resource.data.organizationId)) ||
         (request.resource.data.organizationId is string &&
          organizationExists(request.resource.data.organizationId) &&
          isAdminOfCompany(request.resource.data.organizationId)))
      ));
      
      // Allow delete if:
      // 1) User deleting themselves by uid, OR
      // 2) User deleting their own duplicate docs by email, OR
      // 3) Super Admin deleting any non-creator user in their organization, OR
      // 4) Admin (non-super) deleting non-admin/non-super users in their organization.
      allow delete: if request.auth != null && (
        isPlatformOwner() ||
        request.auth.uid == userId ||
        (request.auth.token.email != null && resource.data.email == request.auth.token.email) ||
        (
          exists(/databases/(default)/documents/users/$(request.auth.uid)) &&
          orgIdsMatch(get(/databases/(default)/documents/users/$(request.auth.uid)).data.organizationId, resource.data.organizationId) &&
          (
            (
              ('isSuperAdmin' in get(/databases/(default)/documents/users/$(request.auth.uid)).data &&
               get(/databases/(default)/documents/users/$(request.auth.uid)).data.isSuperAdmin == true) &&
              (
                !exists(/databases/(default)/documents/organizations/$(resource.data.organizationId)) ||
                !('creatorUserId' in get(/databases/(default)/documents/organizations/$(resource.data.organizationId)).data) ||
                get(/databases/(default)/documents/organizations/$(resource.data.organizationId)).data.creatorUserId != userId
              )
            ) ||
            (
              isAdminOrSuperAdmin() &&
              !('isSuperAdmin' in get(/databases/(default)/documents/users/$(request.auth.uid)).data &&
                get(/databases/(default)/documents/users/$(request.auth.uid)).data.isSuperAdmin == true) &&
              !('isSuperAdmin' in resource.data && resource.data.isSuperAdmin == true) &&
              !('adminAccess' in resource.data && resource.data.adminAccess == true) &&
              !('role' in resource.data && resource.data.role == 'admin')
            )
          )
        )
      );

      // Tax identifiers (UTR, VAT number): lib/canonical/sensitiveProfile.ts.
      // Only the person, an admin of their company and the platform owner read or write.
      // The invitee may read and remove the placeholder's copy while finishing an invite
      // (same email check the placeholder user document uses).
      match /private/{privateDocId} {
        function subjectUserData() {
          return get(/databases/$(database)/documents/users/$(userId)).data;
        }
        function subjectExists() {
          return exists(/databases/$(database)/documents/users/$(userId));
        }
        function adminOfSubject() {
          return subjectExists() &&
            subjectUserData().organizationId is string &&
            isOrganizationAdmin(subjectUserData().organizationId);
        }
        function inviteeOfPlaceholder() {
          return subjectExists() &&
            subjectUserData().email is string &&
            request.auth.token.email is string &&
            subjectUserData().email.lower() == request.auth.token.email.lower();
        }
        function validTaxIds() {
          return request.resource.data.keys().hasOnly(['utrNumber', 'vatNumber', 'updatedByUserId', 'updatedAt']) &&
            request.resource.data.utrNumber is string && request.resource.data.utrNumber.size() <= 20 &&
            request.resource.data.vatNumber is string && request.resource.data.vatNumber.size() <= 20 &&
            request.resource.data.updatedByUserId == request.auth.uid &&
            request.resource.data.updatedAt == request.time;
        }
        allow read: if request.auth != null && privateDocId == 'taxIds' && (
          request.auth.uid == userId || isPlatformOwner() || adminOfSubject() || inviteeOfPlaceholder()
        );
        allow create, update: if request.auth != null && privateDocId == 'taxIds' && validTaxIds() && (
          request.auth.uid == userId || isPlatformOwner() || adminOfSubject()
        );
        allow delete: if request.auth != null && privateDocId == 'taxIds' && (
          request.auth.uid == userId || isPlatformOwner() || adminOfSubject() || inviteeOfPlaceholder()
        );
      }

      // Multi-org memberships (web Change organisation + cross-org invites)
      // Rulebook 1.10.0 (lib/canonical/orgMembership.ts): only an admin of that organisation writes role,
      // permissions, super admin or the active flag. The person may accept (status active, acceptedAt), keep
      // their profile copy fields, and set `role` only to what that organisation's members map lists for them.
      match /orgMemberships/{membershipOrgId} {
        function membershipChangedKeys() {
          return resource == null
            ? request.resource.data.keys().toSet()
            : request.resource.data.diff(resource.data).affectedKeys();
        }
        function membershipSelfWriteAllowed() {
          return membershipChangedKeys().hasOnly([
              'status', 'acceptedAt', 'invitedAt', 'updatedAt', 'updatedBy', 'updatedFrom', 'role',
              'organizationId', 'email', 'firstName', 'surname', 'lastName', 'mobileNumber', 'passwordSet',
              'profilePhotoURL'
            ]) &&
            (!('role' in membershipChangedKeys()) ||
              request.resource.data.role == callerListedRole(membershipOrgId) ||
              (request.resource.data.role == 'admin' && isOrgCreatorViaParentGet(membershipOrgId))) &&
            (!('status' in membershipChangedKeys()) || request.resource.data.status == 'active') &&
            writeMetadataValidWhenPresent();
        }
        // 1.11.0 (inviteMembershipWrites): accepting a genuine, unused invitation creates the membership with exactly
        // the invitation's role and permissions — nothing more.
        function membershipFromInvitation() {
          let next = request.resource.data;
          let inv = get(/databases/(default)/documents/invitations/$(next.get('invitationId', ''))).data;
          return resource == null && request.auth.uid == userId &&
            next.keys().hasOnly(['organizationId', 'role', 'status', 'isSuperAdmin', 'accountActive', 'permissions',
              'invitationId', 'invitedBy', 'invitedAt', 'acceptedAt', 'updatedAt']) &&
            inviteBeingAccepted(next.get('invitationId', ''), membershipOrgId) &&
            next.get('organizationId', membershipOrgId) == membershipOrgId &&
            next.get('role', '') == invitationRole(inv) &&
            next.get('permissions', {}) == inv.get('permissions', {}) &&
            next.get('isSuperAdmin', false) == false &&
            next.get('accountActive', true) == true &&
            next.get('status', 'active') == 'active' &&
            next.get('invitedBy', inv.get('invitedBy', '')) == inv.get('invitedBy', '');
        }
        // 1.12.2: an admin of that organisation reads the membership too (iOS `writeOrgMembership` reads it before the
        // change user type write; before 1.12.2 the read was refused and the change stopped after users/{uid}).
        allow get: if request.auth != null && (
          request.auth.uid == userId ||
          isOrgAdminViaMembersMap(membershipOrgId) ||
          isOrganizationAdmin(membershipOrgId)
        );
        allow list: if request.auth != null && request.auth.uid == userId;
        // 1.12.0 (B4): `isSuperAdmin` on a membership changes only by that organisation's Super Admin.
        function membershipSuperAdminUnchanged() {
          return staffFlag(request.resource.data, 'isSuperAdmin') ==
            (resource == null ? false : staffFlag(resource.data, 'isSuperAdmin'));
        }
        allow create, update: if request.auth != null && (
          ((isOrgAdminViaMembersMap(membershipOrgId) || isOrganizationAdmin(membershipOrgId)) &&
           (membershipSuperAdminUnchanged() || callerIsSuperAdminOf(membershipOrgId))) ||
          (request.auth.uid == userId && membershipSelfWriteAllowed()) ||
          membershipFromInvitation()
        );
        allow delete: if request.auth != null && (
          request.auth.uid == userId ||
          isOrgAdminViaMembersMap(membershipOrgId) ||
          isOrganizationAdmin(membershipOrgId)
        );
      }
    }

    // Organizations - with strict access control
    match /organizations/{organizationId} {
      // One user per email per org (must stay above the catch-all so writes are not widened by {collection}/**)
      match /userEmails/{emailKey} {
        // Invitee may read the claim for their own email after they create Auth.
        // That id is the pending placeholder, not request.auth.uid. List of this
        // collection stays closed: emailKey == token email is only true for one doc.
        allow read: if request.auth != null && (
          canAccessOrganization(organizationId) ||
          (resource != null && resource.data.userId == request.auth.uid) ||
          (request.auth.token.email is string &&
           emailKey == request.auth.token.email.lower())
        );
        allow create, update: if request.auth != null && (
          isPlatformOwner() ||
          isAdminOfCompany(organizationId) ||
          isOwnEmailClaimWrite(organizationId, emailKey) ||
          (isManagerWithOperativesAccess() && userOrgIdMatchesPath(organizationId))
        );
        allow delete: if request.auth != null && (isPlatformOwner() || isAdminOfCompany(organizationId));
      }
      
      // Org root document: must not call get(organizations/{organizationId}) inside the rule (same doc → circular deny).
      // Use resource.data.members for membership; userOrgIdMatchesPath for users/{uid}.organizationId.
      // creatorUserId covers legacy orgs that predate a reliable members map.
      allow get: if request.auth != null && (
        isPlatformOwner() ||
        userOrgIdMatchesPath(organizationId) ||
        (resource != null && 'members' in resource.data && resource.data.members[request.auth.uid] != null) ||
        (resource != null && 'creatorUserId' in resource.data && resource.data.creatorUserId == request.auth.uid)
      );

      // Lists only the companies this account belongs to or created: the two queries both apps run
      // (`members.{uid} != ''` and `creatorUserId == uid`). Listing every company is refused.
      allow list: if request.auth != null && (
        isPlatformOwner() ||
        resource.data.members[request.auth.uid] != '' ||
        resource.data.creatorUserId == request.auth.uid
      );
      
      // Signed-in bootstrap (first setup or leftover Auth with no users/{uid}): any
      // authenticated user may create an organisation if they list themselves as admin.
      // Do not require an existing profile. Path 3 on users/{uid} then writes that profile.
      allow create: if request.auth != null && 
                     request.resource.data.members[request.auth.uid] == 'admin';
      
      // Admins of this company edit settings. Being the creator alone is not enough: a creator who
      // was demoted is no longer an admin (members map or users document) and cannot edit.
      // creatorUserId moves only in an ownership transfer: the platform owner, or the current
      // Super Admin (creator, or users/{uid}.isSuperAdmin in this company) who is still an admin,
      // handing it to someone who is an admin here (iOS transferOrganizationOwnership, web
      // userStore transfer). Billing stays server-only.
      function orgRootCallerIsAdmin() {
        return isOrganizationAdmin(organizationId) ||
          ('members' in resource.data && resource.data.members is map &&
           resource.data.members.get(request.auth.uid, null) == 'admin');
      }
      function orgRootCreatorUnchanged() {
        return request.resource.data.get('creatorUserId', null) == resource.data.get('creatorUserId', null);
      }
      function orgRootNewCreatorIsAdmin() {
        let newId = request.resource.data.get('creatorUserId', null);
        return newId is string && newId.size() > 0 && (
          (request.resource.data.get('members', {}) is map &&
           request.resource.data.get('members', {}).get(newId, null) == 'admin') || (
            exists(/databases/(default)/documents/users/$(newId)) &&
            userDocOrganizationMatches(get(/databases/(default)/documents/users/$(newId)).data, organizationId) &&
            adminLikeUser(get(/databases/(default)/documents/users/$(newId)).data) &&
            !isOperativeLikeUser(get(/databases/(default)/documents/users/$(newId)).data)
          )
        );
      }
      function orgRootCallerIsSuperAdmin() {
        return resource.data.get('creatorUserId', null) == request.auth.uid || (
          exists(/databases/(default)/documents/users/$(request.auth.uid)) &&
          staffFlag(get(/databases/(default)/documents/users/$(request.auth.uid)).data, 'isSuperAdmin') &&
          userOrgIdMatchesPath(organizationId)
        );
      }
      // 1.11.0 (inviteMembershipWrites): the person accepting an invitation adds only `members.{their uid}`, with the
      // invitation's role, in the batch that creates their membership from it and marks it used.
      function orgRootInviteJoin() {
        let membership = /databases/(default)/documents/users/$(request.auth.uid)/orgMemberships/$(organizationId);
        let invId = getAfter(membership).data.get('invitationId', '');
        let inv = get(/databases/(default)/documents/invitations/$(invId)).data;
        return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members']) &&
          request.resource.data.get('members', {}).diff(resource.data.get('members', {})).affectedKeys()
            .hasOnly([request.auth.uid]) &&
          resource.data.get('members', {}).get(request.auth.uid, null) == null &&
          inviteBeingAccepted(invId, organizationId) &&
          request.resource.data.members[request.auth.uid] == invitationRole(inv);
      }
      allow update: if billingUnchanged() && (
                     isPlatformOwner() || (
                       request.auth != null &&
                       orgRootCallerIsAdmin() && (
                         orgRootCreatorUnchanged() ||
                         (orgRootCallerIsSuperAdmin() && orgRootNewCreatorIsAdmin())
                       )
                     ) || (
                       request.auth != null && orgRootInviteJoin()
                     )
                   );
      
      allow delete: if false;
      
      // Rulebook 1.10.0 round 2 (lib/canonical/staffAccess.ts seesEveryJob / canCreateJob / canEditJob /
      // canChangeJobManagers): the caller's Projects / Small works add-edit-manage permission in THIS organisation —
      // users/{uid} flags when that is this organisation's profile, else this organisation's membership document
      // (nested permissions.{kind}, else the legacy flat key). Only a manager here counts (admins see everything).
      // `role` is callerOrgRole(organizationId), computed once per rule: these rules sit near the 1000-expression
      // limit, so the helpers take it as an argument instead of recomputing it.
      function callerJobToggle(role, kind) {
        let home = callerHomeData();
        let membership = /databases/(default)/documents/users/$(request.auth.uid)/orgMemberships/$(organizationId);
        return role == 'manager' && (
          homeOrgIs(home, organizationId)
            ? staffFlag(home, kind)
            : (exists(membership) &&
               truthyBool(get(membership).data.get('permissions', {}).get(kind, get(membership).data.get(kind, false))))
        );
      }
      // Sees, adds and edits every job of this kind, and changes its manager list (`seesEveryJob(role, kind)`).
      function callerSeesEveryJob(role, kind) {
        return role == 'admin' || callerJobToggle(role, kind) || isPlatformOwner();
      }
      // A single job document: every-job viewers; a manager listed on it (`isJobManager`); operatives and other
      // non-staff members of this organisation by id only (the jobs of their own bookings — the rules cannot see
      // which jobs those are, so `list` is refused to them).
      // 1.12.0: before `enforcedReads` (enforcedReadsOn), every member of this organisation reads every job, as
      // before 1.10.0 (`legacyMemberRead`).
      function legacyMemberRead(role) {
        return role != '' || canAccessOrganization(organizationId);
      }
      function jobGetAllowed(kind) {
        let role = callerOrgRole(organizationId);
        return role in ['operative', 'member'] ||
          (!enforcedReadsOn() && legacyMemberRead(role)) ||
          (role == 'manager' && resource != null && jobListsCaller(resource.data)) ||
          callerSeesEveryJob(role, kind);
      }
      // A job query: every-job viewers any query; other managers only `managerUserIds array-contains <uid>`.
      function jobListAllowed(kind) {
        let role = callerOrgRole(organizationId);
        return callerSeesEveryJob(role, kind) ||
          (role == 'manager' && request.auth.uid in resource.data.get('managerUserIds', [])) ||
          (!enforcedReadsOn() && legacyMemberRead(role));
      }
      function jobCreateAllowed(kind) {
        return callerSeesEveryJob(callerOrgRole(organizationId), kind);
      }
      // Editing a job: every-job viewers; a manager of the job edits its details but never its manager list.
      function jobUpdateAllowed(kind) {
        let role = callerOrgRole(organizationId);
        return callerSeesEveryJob(role, kind) || (
          role == 'manager' &&
          !request.resource.data.diff(resource.data).affectedKeys()
            .hasAny(['managerIds', 'managerId', 'assignedManagerUserIds', 'managerUserIds']) &&
          jobListsCaller(resource.data)
        );
      }
      // A job's health & safety subcollection is read by the people who may read the job.
      function jobDocReadable(kind, jobId) {
        let role = callerOrgRole(organizationId);
        let path = /databases/(default)/documents/organizations/$(organizationId)/$(kind)/$(jobId);
        return role in ['operative', 'member'] ||
          (!enforcedReadsOn() && legacyMemberRead(role)) ||
          (role == 'manager' && exists(path) && jobListsCaller(get(path).data)) ||
          callerSeesEveryJob(role, kind);
      }

      match /projects/{projectId} {
        allow get: if jobGetAllowed('projects');
        allow list: if jobListAllowed('projects');
        allow create: if jobCreateAllowed('projects');
        allow update: if jobUpdateAllowed('projects');
        allow delete: if isOrganizationAdmin(organizationId);

        match /healthSafety/{documentId} {
          allow read: if jobDocReadable('projects', projectId);
          allow create, update: if canAccessOrganization(organizationId);
          allow delete: if isOrganizationAdmin(organizationId);
        }
      }
      
      match /smallWorks/{smallWorkId} {
        allow get: if jobGetAllowed('smallWorks');
        allow list: if jobListAllowed('smallWorks');
        allow create: if jobCreateAllowed('smallWorks');
        allow update: if jobUpdateAllowed('smallWorks');
        allow delete: if isOrganizationAdmin(organizationId);

        match /healthSafety/{documentId} {
          allow read: if jobDocReadable('smallWorks', smallWorkId);
          allow create, update: if canAccessOrganization(organizationId);
          allow delete: if isOrganizationAdmin(organizationId);
        }
      }
      
      // Path already scopes to this org; body organizationId can drift or be typed oddly on some clients.
      match /clients/{clientId} {
        allow read: if canAccessOrganization(organizationId);
        allow create, update: if canAccessOrganization(organizationId);
        allow delete: if isOrganizationAdmin(organizationId);
      }
      
      // Pay on roster rows (operatives/{id}, managers/{id}): payRate.ts falls back to these when
      // users/{uid} has no rate, so they are pay too. Only keys whose value changes count.
      function rosterRowPayKeysChanged() {
        return (resource == null
          ? request.resource.data.keys().toSet()
          : request.resource.data.diff(resource.data).affectedKeys()
        ).hasAny(['dayRate', 'hourlyRate', 'payBasis', 'employmentType',
                  'employmentTypeTransitionFrom', 'employmentTypeEffectiveAt']);
      }
      // The operatives row is the caller's own when its email is the signed-in email.
      function operativeRowIsCaller() {
        return !(request.auth.token.email is string) ||
          string(request.resource.data.get('email', '')).lower() == request.auth.token.email.lower() ||
          (resource != null && string(resource.data.get('email', '')).lower() == request.auth.token.email.lower());
      }

      // Rulebook 1.12.0 (H3): a roster row's `email` is who it is — `jobListsCaller` (managers rows) and
      // `callerOwnsBookingId` (operatives rows) trust it. Changing the email of an existing row is admins (and, for an
      // operatives row that is not their own, managers with operatives access); a new row is staff only.
      function rosterRowEmailChanged() {
        return resource != null &&
          string(request.resource.data.get('email', '')).trim().lower() != string(resource.data.get('email', '')).trim().lower();
      }
      function rosterRowAdmin() {
        return isOrgAdminViaMembersMap(organizationId) || isPlatformOwner() || isOrganizationAdmin(organizationId);
      }
      function operativesManagerForOtherRow() {
        return isManagerWithOperativesAccess() && userOrgIdMatchesPath(organizationId) && !operativeRowIsCaller();
      }

      match /operatives/{operativeId} {
        allow read: if canAccessOrganization(organizationId);
        allow create, update: if canAccessOrganization(organizationId) &&
          (resource != null || isOrgManagerOrAdmin(organizationId) || isPlatformOwner()) &&
          (!rosterRowPayKeysChanged() || rosterRowAdmin() || operativesManagerForOtherRow()) &&
          (!rosterRowEmailChanged() || rosterRowAdmin() || operativesManagerForOtherRow()) &&
          writeMetadataValidWhenPresent();
        allow delete: if isOrganizationAdmin(organizationId);
      }
      
      // Deleted-booking tombstones (lib/canonical/bookingTombstones.ts). A delete of bookings/{id},
      // subcontractorBookings/{id} or managerSiteBookings/{id} writes deletedBookings/{id} in the same batch; while it exists the
      // booking cannot be created or updated again, so a queued offline save cannot bring it back.
      function bookingTombstoned(bookingId) {
        return exists(/databases/(default)/documents/organizations/$(organizationId)/deletedBookings/$(bookingId));
      }
      // Rulebook 1.10.0 (lib/canonical/staffAccess.ts canWriteBooking / canDeleteBooking): admins write every
      // booking; managers only bookings on a project or small works they manage; operatives never.
      // A job's managers: `managerUserIds` / `managerIds` / `managerId` naming the signed-in account (with or
      // without `user:`, without case), or `managerId` naming a managers-list row whose email is the signed-in
      // email. The job is projects/{id} or smallWorks/{id}, the booking's id as stored, then upper case.
      function jobListsCaller(job) {
        let uid = request.auth.uid.lower();
        let primary = job.get('managerId', '');
        return ((',' + job.get('managerUserIds', []).join(',').lower() + ',').matches('.*,(user:)?' + uid + ',.*')) ||
          ((',' + job.get('managerIds', []).join(',').lower() + ',').matches('.*,(user:)?' + uid + ',.*')) ||
          (primary is string && primary.lower() in [uid, 'user:' + uid]) ||
          (primary is string && primary.size() > 0 && !primary.matches('.*/.*') &&
            request.auth.token.email is string &&
            exists(/databases/(default)/documents/organizations/$(organizationId)/managers/$(primary)) &&
            string(get(/databases/(default)/documents/organizations/$(organizationId)/managers/$(primary)).data.get('email', '')).lower() == request.auth.token.email.lower());
      }
      function callerManagesJobAt(jobId) {
        return (exists(/databases/(default)/documents/organizations/$(organizationId)/projects/$(jobId)) &&
            jobListsCaller(get(/databases/(default)/documents/organizations/$(organizationId)/projects/$(jobId)).data)) ||
          (exists(/databases/(default)/documents/organizations/$(organizationId)/smallWorks/$(jobId)) &&
            jobListsCaller(get(/databases/(default)/documents/organizations/$(organizationId)/smallWorks/$(jobId)).data));
      }
      function callerManagesJob(jobId) {
        return jobId is string && jobId.size() > 0 && !jobId.matches('.*/.*') && (
          callerManagesJobAt(jobId) ||
          (jobId != jobId.upper() && callerManagesJobAt(jobId.upper())) ||
          (jobId != jobId.lower() && callerManagesJobAt(jobId.lower()))
        );
      }
      // 1.11.0: the job in one collection (`jobCollection` on the booking), any spelling of its id.
      function callerManagesJobInAt(kind, jobId) {
        let path = /databases/(default)/documents/organizations/$(organizationId)/$(kind)/$(jobId);
        return exists(path) && jobListsCaller(get(path).data);
      }
      function callerManagesJobIn(kind, jobId) {
        return jobId is string && jobId.size() > 0 && !jobId.matches('.*/.*') && kind in ['projects', 'smallWorks'] && (
          callerManagesJobInAt(kind, jobId) ||
          (jobId != jobId.upper() && callerManagesJobInAt(kind, jobId.upper())) ||
          (jobId != jobId.lower() && callerManagesJobInAt(kind, jobId.lower()))
        );
      }
      function bookingJobId(collection, data) {
        return collection == 'managerSiteBookings'
          ? data.get('locationId', '')
          : data.get('projectId', data.get('projectID', ''));
      }
      function bookingHasJob(collection, data) {
        return collection != 'managerSiteBookings' || data.get('locationType', '') in ['project', 'small_work'];
      }
      // 1.11.0 (bookingJobCollection): `jobCollection` is 'projects' or 'smallWorks', only on a booking with a job.
      function bookingJobCollectionValid(collection, data) {
        return !('jobCollection' in data) ||
          (data.jobCollection in ['projects', 'smallWorks'] && bookingHasJob(collection, data));
      }
      // The job part of canWriteBooking for a manager: the booking's job is one they manage (in the collection its
      // `jobCollection` names, when it carries one); a manager site booking with no job is their own.
      function managerMayWriteBookingData(collection, data) {
        return bookingHasJob(collection, data)
          ? ('jobCollection' in data
              ? callerManagesJobIn(data.jobCollection, bookingJobId(collection, data))
              : callerManagesJob(bookingJobId(collection, data)))
          : data.get('userId', '') == request.auth.uid;
      }
      // `op`: 'create' (request.resource), 'update' (stored and written), 'delete' (stored).
      function bookingWriteAllowed(collection, op) {
        let role = callerOrgRole(organizationId);
        return (op == 'delete' || bookingJobCollectionValid(collection, request.resource.data)) && (
          role == 'admin' || (
            role == 'manager' && (
              op == 'create' ? managerMayWriteBookingData(collection, request.resource.data) : (
                managerMayWriteBookingData(collection, resource.data) && (
                  op != 'update' ||
                  (bookingJobId(collection, request.resource.data) == bookingJobId(collection, resource.data) &&
                   bookingHasJob(collection, request.resource.data) == bookingHasJob(collection, resource.data) &&
                   request.resource.data.get('jobCollection', '') == resource.data.get('jobCollection', '') &&
                   request.resource.data.get('userId', '') == resource.data.get('userId', '')) ||
                  managerMayWriteBookingData(collection, request.resource.data)
                )
              )
            )
          ) || isPlatformOwner()
        );
      }
      // The tombstone of a stored booking: the people who may delete it (read as it was before the batch).
      function bookingTombstoneAllowed(collection, bookingId) {
        let role = callerOrgRole(organizationId);
        let path = /databases/(default)/documents/organizations/$(organizationId)/$(collection)/$(bookingId);
        return role == 'admin' || isPlatformOwner() || (
          role == 'manager' && exists(path) && managerMayWriteBookingData(collection, get(path).data)
        );
      }

      // A role in this organisation (callerOrgRole not '') is membership here, so these rules do not repeat
      // canAccessOrganization (it would cost most of the expression budget).
      // Rulebook 1.10.0 round 2 §17 (bookingQueryPlan): reads are enforced. Every-booking readers read everything;
      // other managers read the bookings on a job they manage (`projectId` / `locationId`, any spelling of the job
      // id) and their own; operatives only their own. Firestore rules are not filters: each app query names the job
      // (`projectId in [<one job's id spellings>]`) or the person, so the rules can prove every document. Each `in`
      // value costs a job lookup and a query may look up 10 documents, hence one job per query.
      function callerOwnsBookingId(personId) {
        let home = callerHomeData();
        let row = /databases/(default)/documents/organizations/$(organizationId)/operatives/$(personId);
        // 1.12.0 (B3): the caller's alias ids count only on their own company's users document (another company's
        // admin could write their own aliases there).
        return personId is string && personId.size() > 0 && (
          personId == request.auth.uid ||
          (homeOrgIs(home, organizationId) && (
            personId in home.get('formerUserIds', []) ||
            personId in home.get('sameEmailUserIds', []))) ||
          (!personId.matches('.*/.*') && request.auth.token.email is string && exists(row) &&
            string(get(row).data.get('email', '')).lower() == request.auth.token.email.lower())
        );
      }
      // Cheap tests first: when the rules cannot prove a query from its filters, they are evaluated document by
      // document against the 1000-expression budget, so a toggle or own-booking match must not pay for a job lookup.
      // 1.11.0 (owner decisions round 3): reads are limited by job kind. A manager with the Projects / Small works
      // toggle reads the bookings whose `jobCollection` is that kind (apps query `jobCollection == <kind>`); a booking
      // without `jobCollection` (written before 1.11.0, until the backfill) is read only by admins, the job's managers
      // and the people it books.
      function bookingReadAllowed(collection) {
        let role = callerOrgRole(organizationId);
        // 1.12.0: before `enforcedReads`, every member of this organisation reads every booking (as before 1.10.0).
        return role == 'admin' ||
          (!enforcedReadsOn() && (role != '' || canAccessOrganization(organizationId))) ||
          (role == 'manager' && resource.data.get('jobCollection', '') in ['projects', 'smallWorks'] &&
            callerJobToggle(role, resource.data.get('jobCollection', ''))) ||
          (collection == 'managerSiteBookings' && role == 'manager' && resource.data.userId == request.auth.uid) ||
          (collection == 'bookings' && role != '' && callerOwnsBookingId(resource.data.operativeId)) ||
          (role == 'manager' && callerManagesJob(
            collection == 'managerSiteBookings' ? resource.data.locationId : resource.data.projectId
          )) ||
          isPlatformOwner();
      }

      match /deletedBookings/{bookingId} {
        allow read: if canAccessOrganization(organizationId);
        allow create: if request.auth != null &&
          request.resource.data.keys().hasOnly(['bookingId', 'collection', 'deletedAt', 'deletedBy', 'deletedFrom']) &&
          request.resource.data.keys().hasAll(['bookingId', 'collection', 'deletedAt', 'deletedBy', 'deletedFrom']) &&
          request.resource.data.bookingId == bookingId &&
          request.resource.data.deletedBy == request.auth.uid &&
          request.resource.data.deletedAt == request.time &&
          request.resource.data.deletedFrom in ['web', 'ios', 'android'] &&
          request.resource.data.collection in ['bookings', 'managerSiteBookings', 'subcontractorBookings'] &&
          // 1.10.0: the same people who may delete that booking (canDeleteBooking), read as it was before the
          // batch. With the booking already gone, only an admin writes its tombstone.
          bookingTombstoneAllowed(request.resource.data.collection, bookingId);
        allow update: if false;
        allow delete: if isOrganizationAdmin(organizationId) || isOrgAdminViaMembersMap(organizationId) || isPlatformOwner();
      }

      match /bookings/{bookingId} {
        allow read: if bookingReadAllowed('bookings');
        allow create: if !bookingTombstoned(bookingId) && bookingWriteAllowed('bookings', 'create');
        // Only admins and the job's managers write (1.10.0), so a cancelled booking is reinstated only by them.
        allow update: if !bookingTombstoned(bookingId) && bookingWriteAllowed('bookings', 'update');
        allow delete: if bookingWriteAllowed('bookings', 'delete');
      }
      
      // 1.12.0 (M3, part): the qualification and skills catalogues are staff only (admins and managers of this
      // organisation, never an operative). A person's own qualification assignments and expiry dates live on their
      // operatives row, which iOS My Qualifications still lets them edit (not changed here).
      match /qualifications/{qualificationId} {
        allow read: if canAccessOrganization(organizationId);
        allow write: if isOrgManagerOrAdmin(organizationId) || isPlatformOwner();
      }
      
      match /skills/{skillId} {
        allow read: if canAccessOrganization(organizationId);
        allow write: if isOrgManagerOrAdmin(organizationId) || isPlatformOwner();
      }
      
      // Job types and other org settings (only jobTypes doc is used today). Org members need to sync job types when creating work.
      // Variation log / item docs live here as the iOS fallback. Operatives must not read them.
      match /settings/{settingId} {
        function isVariationSettingsDoc() {
          return settingId.matches('^variations_.*') || settingId.matches('^variationItem_.*');
        }
        function isTimesheetSettingsDoc() {
          return settingId.matches('^timesheet_.*');
        }
        // Doc id is timesheet_{userId}_{unix} (userId may itself contain underscores).
        // Prefer stored userId; fall back to id prefix timesheet_{auth.uid}_.
        // matches() is whole-string — the .* is required.
        function isOwnTimesheetSettings() {
          return request.auth != null && (
            (resource != null && 'userId' in resource.data && resource.data.userId == request.auth.uid) ||
            (request.method == 'create' &&
             'userId' in request.resource.data &&
             request.resource.data.userId == request.auth.uid) ||
            settingId.matches('^timesheet_' + request.auth.uid + '_.*')
          );
        }
        // Whose timesheet: stored userId, else the incoming one on create.
        function timesheetSubjectUid() {
          return resource != null && resource.data.get('userId', null) is string
            ? resource.data.userId
            : request.resource.data.get('userId', null);
        }
        // Admins, or the subject's line manager (their own id, or a former invite id on
        // users/{auth.uid}.formerUserIds — lib/canonical/userTimesheetAccess.ts).
        function isTimesheetReviewer() {
          return isPlatformOwner() ||
            isOrganizationAdmin(organizationId) ||
            isOrgAdminViaMembersMap(organizationId) || (
              timesheetSubjectUid() is string &&
              timesheetSubjectUid() != request.auth.uid &&
              exists(/databases/(default)/documents/users/$(timesheetSubjectUid())) &&
              // 1.12.0 (B3): former ids only from the caller's own company's users document.
              lineManagerIdList(get(/databases/(default)/documents/users/$(timesheetSubjectUid())).data).hasAny(
                [request.auth.uid].concat(
                  callerHomeData().get('formerUserIds', []) is list && homeOrgIs(callerHomeData(), organizationId)
                    ? callerHomeData().get('formerUserIds', [])
                    : []
                )
              )
            );
        }
        function timesheetSame(key) {
          return sameLooseValue(
            request.resource.data.get(key, null),
            resource == null ? null : resource.data.get(key, null)
          );
        }
        function timesheetSameInstant(key) {
          return sameInstantValue(
            request.resource.data.get(key, null),
            resource == null ? null : resource.data.get(key, null)
          );
        }
        // Manager counter-sign and export (timesheetSignOffWriteFields role 'manager',
        // timesheetExportWriteFields). The owner resends them unchanged on every save.
        function timesheetManagerFieldsUnchanged() {
          return timesheetSameInstant('managerSignedAt') &&
            timesheetSame('managerSignedByName') &&
            timesheetSame('managerSignedByUserId') &&
            timesheetSame('managerSignatureImageBase64') &&
            timesheetSameInstant('approvedAt') &&
            timesheetSame('approvedByName') &&
            timesheetSameInstant('exportedAt');
        }
        // Reviewer-only parts (lib/canonical/timesheetEntryReviews.ts). Rules cannot walk arrays, so
        // manager decisions on price work and expenses live in the `extraEntryReviews` map, not in
        // the owner-editable entry rows. `managerNote` is the owner's "Note to manager" and stays theirs.
        function timesheetEmptyish(value) {
          return value == null || value == {};
        }
        function timesheetWrittenKeys() {
          return resource == null
            ? request.resource.data.keys().toSet()
            : request.resource.data.diff(resource.data).affectedKeys();
        }
        // Unchanged (missing and an empty map are the same), so a full resend passes.
        function timesheetOwnerLeaves(key, written) {
          return !(key in written) || (
            timesheetEmptyish(request.resource.data.get(key, null)) &&
            timesheetEmptyish(resource == null ? null : resource.data.get(key, null))
          );
        }
        function timesheetOwnerLeavesList(key, written) {
          return !(key in written) || (
            (request.resource.data.get(key, null) == null || request.resource.data.get(key, null) == []) &&
            (resource == null || resource.data.get(key, null) == null || resource.data.get(key, null) == [])
          );
        }
        // lib/canonical timesheetSelfSigned: the owner writes the approved snapshot only without a current
        // line manager (hasCurrentLineManager: an inactive or self-only line manager is none).
        function timesheetSubjectHasLineManager() {
          return timesheetSubjectUid() is string &&
            exists(/databases/(default)/documents/users/$(timesheetSubjectUid())) &&
            hasCurrentLineManager(timesheetSubjectUid(), get(/databases/(default)/documents/users/$(timesheetSubjectUid())).data);
        }
        function timesheetStoredManagerSigned() {
          return resource != null && (
            resource.data.get('managerSignedAt', null) is timestamp ||
            resource.data.get('managerSignedAt', null) is number ||
            resource.data.get('approvedAt', null) is timestamp ||
            resource.data.get('approvedAt', null) is number
          );
        }
        // The owner never writes line reviews or entry decisions; writes the approved snapshot only
        // when they have no line manager (self-signed); and cannot change their price work or
        // expenses once the line manager has signed.
        function timesheetOwnerReviewFieldsUnchanged() {
          let written = timesheetWrittenKeys();
          return timesheetOwnerLeaves('payrollLineReviews', written) &&
            timesheetOwnerLeaves('extraEntryReviews', written) &&
            (timesheetOwnerLeaves('weeklyReportOverride', written) || !timesheetSubjectHasLineManager()) &&
            (!timesheetStoredManagerSigned() || (
              timesheetOwnerLeavesList('expenseEntries', written) &&
              timesheetOwnerLeavesList('priceWorkEntries', written)
            ));
        }
        function canWriteTimesheetSettings() {
          return isTimesheetReviewer() || (
            isOwnTimesheetSettings() &&
            timesheetManagerFieldsUnchanged() &&
            timesheetOwnerReviewFieldsUnchanged()
          );
        }
        function canDeleteTimesheetSettings() {
          return isTimesheetReviewer() || (
            isOwnTimesheetSettings() &&
            resource.data.get('managerSignedAt', null) == null &&
            resource.data.get('exportedAt', null) == null &&
            timesheetEmptyish(resource.data.get('payrollLineReviews', null)) &&
            timesheetEmptyish(resource.data.get('extraEntryReviews', null))
          );
        }
        // Per-job deadlines and the legacy health & safety copy: operatives update their own
        // deadlines and sign toolbox talks, so any member writes these.
        function isMemberWritableSettingsDoc() {
          return settingId.matches('^deadlines_.*') ||
            settingId == 'deadlineAssignments' ||
            settingId.matches('^healthSafety_.*');
        }
        allow read: if canAccessOrganization(organizationId) &&
          (!isVariationSettingsDoc() || canAccessVariationsStaff(organizationId));
        // Everything else (jobTypes, tradeTypeInventory, variationTrades, variation logs, and any new
        // company-wide setting) is admins and managers only. Operatives never write it.
        allow create, update: if canAccessOrganization(organizationId) && (
          isTimesheetSettingsDoc()
            ? canWriteTimesheetSettings()
            : (isMemberWritableSettingsDoc() || canAccessVariationsStaff(organizationId))
        );
        allow delete: if canAccessOrganization(organizationId) && (
          isTimesheetSettingsDoc()
            ? canDeleteTimesheetSettings()
            : (isMemberWritableSettingsDoc() || canAccessVariationsStaff(organizationId))
        );
      }
      
      match /tasks/{taskId} {
        allow read: if canAccessOrganization(organizationId);
        allow create, update: if canAccessOrganization(organizationId);
        allow delete: if isOrganizationAdmin(organizationId);
      }
      
      match /managers/{managerId} {
        allow read: if canAccessOrganization(organizationId);
        // A manager's pay is changed by admins only (never by the manager or another manager).
        // 1.12.0 (H3): a new row is staff only (a job form adds the row for a manager it names); an existing row's
        // email changes by admins only.
        allow create, update: if canAccessOrganization(organizationId) &&
          (resource != null || isOrgManagerOrAdmin(organizationId) || isPlatformOwner()) &&
          (!rosterRowPayKeysChanged() || rosterRowAdmin()) &&
          (!rosterRowEmailChanged() || rosterRowAdmin()) &&
          writeMetadataValidWhenPresent();
        allow delete: if isOrganizationAdmin(organizationId);
      }
      
      match /notifications/{notificationId} {
        function isOwnNotification() {
          return resource != null &&
            'userId' in resource.data &&
            resource.data.userId == request.auth.uid;
        }
        function canAdminNotifications() {
          return isOrganizationAdmin(organizationId) ||
            isOrgAdminViaMembersMap(organizationId) ||
            isPlatformOwner();
        }
        // Rulebook §13: `actorUserId` (who caused the row) is optional; when present it is the signed-in user,
        // so nobody can silence another person's push by naming them the actor.
        function actorUserIdValid() {
          return !('actorUserId' in request.resource.data) ||
            request.resource.data.actorUserId == request.auth.uid;
        }
        function actorUserIdUnchanged() {
          return !('actorUserId' in request.resource.data.diff(resource.data).affectedKeys());
        }
        // Rulebook 1.12.0 (H4, organizationMemberActive): a row is addressed to a member of this organisation — a key
        // of its members map, its creator, a users document of this organisation, or a person with a membership here.
        // Never a uid from anywhere on the platform, and never a row without `userId` (§13: not an inbox row).
        function notificationRecipientIsMember() {
          let uid = request.resource.data.get('userId', '');
          let org = get(/databases/(default)/documents/organizations/$(organizationId)).data;
          return uid is string && uid.size() > 0 && !uid.matches('.*/.*') && (
            org.get('members', {}).get(uid, null) != null ||
            org.get('creatorUserId', '') == uid ||
            (exists(/databases/(default)/documents/users/$(uid)) &&
             homeOrgIs(get(/databases/(default)/documents/users/$(uid)).data, organizationId)) ||
            exists(/databases/(default)/documents/users/$(uid)/orgMemberships/$(organizationId))
          );
        }
        // Inbox queries userId == signed-in user. Fan-out create stays org-member.
        allow read: if canAccessOrganization(organizationId) &&
          (isOwnNotification() || canAdminNotifications());
        allow create: if canAccessOrganization(organizationId) && actorUserIdValid() && notificationRecipientIsMember();
        allow update: if canAccessOrganization(organizationId) &&
          (isOwnNotification() || canAdminNotifications()) &&
          (actorUserIdUnchanged() || actorUserIdValid());
        allow delete: if canAdminNotifications();
      }

      match /materials/{materialId} {
        allow read: if canAccessOrganization(organizationId);
        allow create: if isOrganizationMaterialManager(organizationId) || canCreateOwnMaterial(organizationId);
        // The status branch goes first: it fails fast on any other field, and the rule stays under the
        // 1000-expression limit when a Send status write carries write metadata (1.9.0).
        allow update: if isStaffMaterialStatusWrite(organizationId) ||
          isOrganizationMaterialManager(organizationId) ||
          canUpdateOwnMaterial(organizationId) ||
          isOnlyClaimingLegacyOwnMaterial(organizationId);
        allow delete: if isOrganizationMaterialManager(organizationId) || canDeleteOwnMaterial(organizationId);
      }

      match /materialCatalogue/{catalogueItemId} {
        allow read: if canAccessOrganization(organizationId);
        allow create, update, delete: if isOrganizationMaterialManager(organizationId);
      }

      match /materialSendRecords/{recordId} {
        allow read: if belongsToOrganization(organizationId) &&
          exists(/databases/(default)/documents/users/$(request.auth.uid)) &&
          isOrgManagerOrAdmin(organizationId);
        allow create: if canWriteMaterialSendRecord(organizationId);
        allow update, delete: if isOrganizationAdmin(organizationId);
      }

      match /wholesalers/{wholesalerId} {
        allow read: if canAccessOrganization(organizationId);
        allow create, update, delete: if isOrganizationMaterialManager(organizationId);
      }
      
      match /managerSiteBookings/{bookingId} {
        allow read: if bookingReadAllowed('managerSiteBookings');
        allow create: if !bookingTombstoned(bookingId) && bookingWriteAllowed('managerSiteBookings', 'create');
        allow update: if !bookingTombstoned(bookingId) && bookingWriteAllowed('managerSiteBookings', 'update');
        allow delete: if bookingWriteAllowed('managerSiteBookings', 'delete');
      }
      
      match /subcontractors/{subcontractorId} {
        allow read: if canAccessOrganization(organizationId);
        allow create, update: if canAccessOrganization(organizationId);
        allow delete: if isOrganizationAdmin(organizationId);
      }
      
      match /subcontractorBookings/{bookingId} {
        allow read: if bookingReadAllowed('subcontractorBookings');
        allow create: if !bookingTombstoned(bookingId) && bookingWriteAllowed('subcontractorBookings', 'create');
        allow update: if !bookingTombstoned(bookingId) && bookingWriteAllowed('subcontractorBookings', 'update');
        allow delete: if bookingWriteAllowed('subcontractorBookings', 'delete');
      }
      
      // Annual leave. A requester asks (status 'pending') or asks to cancel (cancellationRequestedAt /
      // cancellationRequestedByUserId); only an admin or the requester's line manager decides
      // (status 'approved' / 'rejected', approvedByUserId, approvedAt, decisionNote). When the
      // requester has no line manager, or the row has no users document (legacy operativeId-only
      // row), an admin decides (never any manager). People who book their own leave
      // (lib/canonical canSelfBookAnnualLeave: annualLeaveSelfBook outside operative mode, or an admin
      // with no current line manager) save it approved. Both apps resend every field with setData merge, so
      // decision fields count only when the value really changes (null, missing and a sub-second
      // timestamp round-trip are the same).
      match /holidayBookings/{bookingId} {
        function hbCaller() {
          return get(/databases/(default)/documents/users/$(request.auth.uid)).data;
        }
        // Members-map admin first (one get), then the users-document admin of this company.
        function hbIsAdmin() {
          return isOrgAdminViaMembersMap(organizationId) ||
            isOrganizationAdmin(organizationId) ||
            isPlatformOwner();
        }
        // Staff (lib/canonical/staffAccess.ts isStaffAccount): admin of this company, or a manager not
        // in operative mode. Membership is already checked by canAccessOrganization on every rule below.
        function hbIsStaffManager() {
          return isOrgManagerOrAdmin(organizationId) || hbIsAdmin();
        }
        function hbRequesterUid(data) {
          return data.get('userId', null);
        }
        function hbRequesterExists(data) {
          return hbRequesterUid(data) is string &&
            hbRequesterUid(data).size() > 0 &&
            exists(/databases/(default)/documents/users/$(hbRequesterUid(data)));
        }
        function hbRequester(data) {
          return get(/databases/(default)/documents/users/$(hbRequesterUid(data))).data;
        }
        function hbIsOwner(data) {
          return hbRequesterUid(data) == request.auth.uid ||
            data.get('operativeId', null) == request.auth.uid;
        }
        // The caller's own users document says operative mode (no document: not operative). 1.11.0: an admin has
        // no operative mode (permissionLevelOf), so a stray flag on an admin does not count.
        function hbCallerIsOperative() {
          return exists(/databases/(default)/documents/users/$(request.auth.uid)) &&
            isOperativeProfile(hbCaller()) && !adminLikeUser(hbCaller());
        }
        // lib/canonical/leaveRequests.ts canDecideLeave: never the requester's own request (admins
        // included). The requester's line manager; otherwise an admin not in operative mode. With no
        // line manager (legacy data) the request waits for an admin — never any manager (rulebook 1.3.0).
        function hbCanDecide(data) {
          return !hbIsOwner(data) && (
            (hbRequesterExists(data) && request.auth.uid in lineManagerIdList(hbRequester(data))) ||
            (!hbCallerIsOperative() && hbIsAdmin())
          );
        }
        // lib/canonical canSelfBookAnnualLeave: the self-book flag outside operative mode, or an admin /
        // super admin outside operative mode with no current line manager (self-approved). Having no line
        // manager does not self-book an operative or manager (their request waits for an admin).
        function hbCallerSelfBooks() {
          return !hbCallerIsOperative() && (
            staffFlag(hbCaller(), 'annualLeaveSelfBook') ||
            (hbIsAdmin() && !hasCurrentLineManager(request.auth.uid, hbCaller()))
          );
        }
        function hbIsRequestShape(next) {
          return next.get('status', null) == 'pending' &&
            next.get('approvedByUserId', null) == null &&
            next.get('approvedAt', null) == null &&
            next.get('decisionNote', null) == null;
        }
        // A request (pending, no decision) or, for a self-booker, their own approved booking.
        function hbOwnerShapeAllowed(next) {
          return hbIsRequestShape(next) || (
            next.get('status', null) == 'approved' &&
            next.get('approvedByUserId', null) in [null, request.auth.uid] &&
            next.get('decisionNote', null) == null &&
            hbCallerSelfBooks()
          );
        }
        // Only a key that really changed is compared (null, missing and a sub-second round-trip are the same).
        function hbKeySame(changed, key) {
          return !(key in changed) ||
            sameLooseValue(request.resource.data.get(key, null), resource.data.get(key, null));
        }
        function hbKeySameInstant(changed, key) {
          return !(key in changed) ||
            sameInstantValue(request.resource.data.get(key, null), resource.data.get(key, null));
        }
        function hbDecisionUnchanged(changed) {
          return !changed.hasAny(['status', 'approvedByUserId', 'approvedAt', 'decisionNote']) || (
            hbKeySame(changed, 'status') && hbKeySame(changed, 'approvedByUserId') &&
            hbKeySameInstant(changed, 'approvedAt') && hbKeySame(changed, 'decisionNote')
          );
        }
        function hbDatesUnchanged(changed) {
          return !changed.hasAny(['startDate', 'endDate', 'timeSlot']) || (
            hbKeySameInstant(changed, 'startDate') && hbKeySameInstant(changed, 'endDate') &&
            !('timeSlot' in changed)
          );
        }
        function hbOwnerEditAllowed(changed) {
          return hbKeySame(changed, 'userId') && hbKeySame(changed, 'operativeId') && (
            // Ask to cancel (or withdraw that ask), or any edit that leaves decision and dates alone.
            (hbDecisionUnchanged(changed) && hbDatesUnchanged(changed)) ||
            // Edit a pending request, or a self-booker edits their own booking.
            ((resource.data.get('status', null) == 'pending' || hbCallerSelfBooks()) &&
              (hbDecisionUnchanged(changed) || hbOwnerShapeAllowed(request.resource.data)))
          );
        }
        function hbOwnerUpdateAllowed() {
          return hbIsOwner(resource.data) &&
            hbOwnerEditAllowed(request.resource.data.diff(resource.data).affectedKeys());
        }

        allow read: if canAccessOrganization(organizationId);
        allow create: if canAccessOrganization(organizationId) && (
          (hbIsOwner(request.resource.data) && hbOwnerShapeAllowed(request.resource.data)) ||
          hbCanDecide(request.resource.data) ||
          // A manager on the Team screen books a request for someone with a line manager: it waits there.
          (hbIsRequestShape(request.resource.data) && hbIsStaffManager())
        );
        allow update: if canAccessOrganization(organizationId) && (
          hbOwnerUpdateAllowed() ||
          (hbCanDecide(resource.data) && hbCanDecide(request.resource.data))
        );
        // Approving a cancellation (or a Team-screen removal, or an admin cleanup) deletes the row: only
        // someone who may decide this person's leave (hbCanDecide: never their own, admins included).
        // The requester may withdraw a pending or declined request; a self-booker may remove their own.
        allow delete: if canAccessOrganization(organizationId) && (
          (hbIsOwner(resource.data) && (
            resource.data.get('status', null) in ['pending', 'rejected'] ||
            hbCallerSelfBooks()
          )) ||
          hbCanDecide(resource.data)
        );
      }

      // Pay change on another path than users/{uid}: the person never changes their own pay
      // (lib/canonical/payAccess.ts canChangePersonPay; payRate.ts reads rate history first, then
      // the live profile). Admins, the platform owner, or a manager with operatives access for an
      // operative in this company (managerMayManageOperative, the same test as
      // canManagerUpdateOperativeProfile). Cheapest tests first: the 1,000-expression limit.
      function managerMayChangePayOf(subjectUserId) {
        return subjectUserId is string && subjectUserId.size() > 0 &&
          subjectUserId != request.auth.uid &&
          exists(/databases/(default)/documents/users/$(subjectUserId)) &&
          get(/databases/(default)/documents/users/$(subjectUserId)).data.get('organizationId', null) is string &&
          orgIdsMatch(get(/databases/(default)/documents/users/$(subjectUserId)).data.organizationId, organizationId) &&
          managerMayManageOperative(subjectUserId, get(/databases/(default)/documents/users/$(subjectUserId)).data);
      }
      // A manager-with-operatives write implies membership: the caller's users/{uid}.organizationId
      // is the subject's, which is this company. Admin of this company is checked members map first.
      function canChangePayOf(subjectUserId) {
        return isOrgAdminViaMembersMap(organizationId) ||
          managerMayChangePayOf(subjectUserId) ||
          isPlatformOwner() ||
          isOrganizationAdmin(organizationId);
      }

      // Mirror of users/{userId} pay and line manager (iOS saveOperativeProfileMetadataFallback,
      // web saveUser). iOS reads it over users/{uid} on roster load. Anyone in the company may
      // touch only the id and write stamps; pay, line manager and employment fields are
      // canChangePayOf. Only keys whose value changes count, so a resend of the same values passes.
      match /operativeProfiles/{userId} {
        function operativeProfileStampOnly() {
          return (resource == null
            ? request.resource.data.keys().toSet()
            : request.resource.data.diff(resource.data).affectedKeys()
          ).hasOnly(['userId', 'updatedAt', 'updatedBy', 'updatedFrom']);
        }
        allow read: if canAccessOrganization(organizationId);
        allow create, update: if request.auth != null &&
          request.resource.data.get('userId', userId) == userId &&
          (operativeProfileStampOnly() ? canAccessOrganization(organizationId) : canChangePayOf(userId)) &&
          writeMetadataValidWhenPresent();
        allow delete: if request.auth != null &&
          (request.auth.uid == userId ? canAccessOrganization(organizationId) : canChangePayOf(userId));
      }

      // Effective-dated pay rows { userId?, operativeId?, dayRate, payBasis?, effectiveAt, createdAt }.
      // userId names a users document; an operativeId-only row is an operatives/{id} record.
      // Never a row about the writer themselves (unless an admin, who may already set their own
      // pay on users/{uid}). Rows are not re-pointed at another person.
      match /operativeDayRateHistory/{entryId} {
        function rateRowUserId(data) {
          return data.get('userId', '') is string ? data.get('userId', '') : '';
        }
        function rateRowOperativeId(data) {
          return data.get('operativeId', '') is string ? data.get('operativeId', '') : '';
        }
        // The operatives row is the caller's own when its email is the signed-in email.
        function rateRowOperativeIsCaller(operativeId) {
          return operativeId.size() > 0 && (
            !(request.auth.token.email is string) ||
            !exists(/databases/(default)/documents/organizations/$(organizationId)/operatives/$(operativeId)) ||
            get(/databases/(default)/documents/organizations/$(organizationId)/operatives/$(operativeId)).data.get('email', '') == null ||
            string(get(/databases/(default)/documents/organizations/$(organizationId)/operatives/$(operativeId)).data.get('email', '')).lower() ==
              request.auth.token.email.lower()
          );
        }
        // Manager with operatives access in this company, for an operatives row that is not theirs.
        function managerMayRecordOperativeRow(operativeId) {
          return operativeId.size() > 0 &&
            isManagerWithOperativesAccess() &&
            get(/databases/(default)/documents/users/$(request.auth.uid)).data.get('organizationId', null) is string &&
            orgIdsMatch(get(/databases/(default)/documents/users/$(request.auth.uid)).data.organizationId, organizationId) &&
            !rateRowOperativeIsCaller(operativeId);
        }
        function managerMayRecordRateRow(data) {
          return rateRowUserId(data).size() > 0
            ? (managerMayChangePayOf(rateRowUserId(data)) && !rateRowOperativeIsCaller(rateRowOperativeId(data)))
            : managerMayRecordOperativeRow(rateRowOperativeId(data));
        }
        function canWriteRateRow(data) {
          return isOrgAdminViaMembersMap(organizationId) ||
            managerMayRecordRateRow(data) ||
            isPlatformOwner() ||
            isOrganizationAdmin(organizationId);
        }
        allow read: if canAccessOrganization(organizationId);
        allow create: if request.auth != null && canWriteRateRow(request.resource.data);
        allow update: if request.auth != null &&
          rateRowUserId(request.resource.data) == rateRowUserId(resource.data) &&
          rateRowOperativeId(request.resource.data) == rateRowOperativeId(resource.data) &&
          canWriteRateRow(request.resource.data);
        allow delete: if isOrganizationAdmin(organizationId);
      }

      match /siteAudits/{auditId} {
        allow read: if canAccessOrganization(organizationId);
        allow create, update: if canAccessOrganization(organizationId);
        allow delete: if isOrganizationAdmin(organizationId);
      }

      // Accepting a clash is a staff warning decision (lib/canonical/staffAccess.ts canViewStaffWarnings,
      // scheduleSources.ts acceptedClashWriteFields): admins and managers only, never operative mode.
      match /acceptedBookingClashes/{clashId} {
        allow read: if canAccessOrganization(organizationId);
        allow create, update: if canAccessVariationsStaff(organizationId) && writeMetadataValidWhenPresent();
        // Un-approving a clash: the same staff who may accept it.
        allow delete: if canAccessVariationsStaff(organizationId);
      }

      // Approved or dismissed warnings (lib/canonical/scheduleSources.ts warningResolutionWriteFields).
      // Document id is the warning's resolution key. Undoing an approval deletes it.
      match /warningResolutions/{resolutionKey} {
        allow read: if canAccessOrganization(organizationId);
        // Approving or dismissing a warning is staff only (canViewStaffWarnings): admins and managers.
        allow create, update: if canAccessVariationsStaff(organizationId) &&
          request.resource.data.keys().hasOnly(['resolutionKey', 'status', 'resolvedByUserId', 'resolvedAt', 'updatedBy', 'updatedFrom', 'updatedAt']) &&
          writeMetadataValidWhenPresent() &&
          request.resource.data.keys().hasAll(['resolutionKey', 'status', 'resolvedByUserId', 'resolvedAt']) &&
          request.resource.data.resolutionKey == resolutionKey &&
          request.resource.data.status in ['approved', 'dismissed'] &&
          request.resource.data.resolvedByUserId == request.auth.uid &&
          request.resource.data.resolvedAt is timestamp;
        // Un-approving: the same staff who may approve, whoever approved it (rulebook 1.2.0 decision 5).
        allow delete: if canAccessVariationsStaff(organizationId);
      }

      // Dismissed warnings (expired qualifications). Document id is the canonical dismiss key.
      match /dismissedWarnings/{dismissKey} {
        allow read: if canAccessOrganization(organizationId);
        // Rulebook §16 / 1.9.0: only admins and managers dismiss a warning (the same staff who accept clashes).
        allow create, update: if canAccessVariationsStaff(organizationId) && writeMetadataValidWhenPresent();
        allow delete: if isOrganizationAdmin(organizationId);
      }

      // Report a problem with this file (lib/canonical/fileReports.ts).
      // Anyone in the organisation files a report as themselves; only admins and
      // the platform owner read and close them. Reports are never deleted.
      match /fileReports/{reportId} {
        allow create: if canAccessOrganization(organizationId) &&
          request.resource.data.keys().hasOnly(['organizationId', 'storagePath', 'surface', 'parentId', 'fileName', 'reason', 'details', 'reportedByUserId', 'status', 'createdAt']) &&
          request.resource.data.keys().hasAll(['organizationId', 'storagePath', 'surface', 'parentId', 'fileName', 'reason', 'details', 'reportedByUserId', 'status', 'createdAt']) &&
          request.resource.data.organizationId == organizationId &&
          request.resource.data.reportedByUserId == request.auth.uid &&
          request.resource.data.status == 'open' &&
          request.resource.data.createdAt == request.time &&
          request.resource.data.reason in ['copyright', 'personal_data', 'offensive', 'wrong_file', 'other'] &&
          request.resource.data.surface in ['site_audit', 'task_attachment', 'health_safety', 'deadline', 'variation_evidence', 'qualification_certificate'] &&
          request.resource.data.storagePath is string &&
          request.resource.data.storagePath.size() <= 1024 &&
          request.resource.data.storagePath.matches('^organizations/' + organizationId + '/.+') &&
          !request.resource.data.storagePath.matches('.*[.][.].*') &&
          request.resource.data.parentId is string &&
          request.resource.data.parentId.size() > 0 &&
          request.resource.data.parentId.size() <= 200 &&
          request.resource.data.fileName is string &&
          request.resource.data.fileName.size() <= 200 &&
          request.resource.data.details is string &&
          request.resource.data.details.size() <= 1000;
        allow read: if isOrganizationAdmin(organizationId) || isPlatformOwner();
        allow update: if (isOrganizationAdmin(organizationId) || isPlatformOwner()) &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'reviewedByUserId', 'reviewedAt']) &&
          request.resource.data.status in ['reviewed', 'removed'] &&
          request.resource.data.reviewedByUserId == request.auth.uid &&
          request.resource.data.reviewedAt == request.time;
        allow delete: if false;
      }

      match /dashboardLayouts/{layoutUserId} {
        allow read: if canAccessOrganization(organizationId);
        allow create, update, delete: if canAccessOrganization(organizationId) &&
          (request.auth.uid == layoutUserId || isOrganizationAdmin(organizationId));
      }

      // Variations are not covered by the read-only catch-all below.
      // Admins and managers read and write every job. Operatives never do.
      // Hard delete is denied; rows are soft-deleted.
      match /variations/{variationId} {
        allow read: if resource.data.parentId is string &&
          canAccessVariationsStaff(organizationId);
        allow create: if request.resource.data.parentId is string &&
          request.resource.data.isDeleted == false &&
          canAccessVariationsStaff(organizationId);
        allow update: if resource.data.parentId is string &&
          request.resource.data.parentId == resource.data.parentId &&
          canAccessVariationsStaff(organizationId);
        allow delete: if false;
      }

      match /variationTrackers/{parentId} {
        allow read: if canAccessVariationsStaff(organizationId);
        allow create, update: if canAdminVariations(organizationId);
        allow delete: if false;
      }

      // Unknown subcollections: allow org-scoped read fallback only.
      // Keep writes explicit per known subcollection rules above.
      match /{collection}/{document=**} {
        allow read: if canAccessOrganization(organizationId) &&
          collection != 'variations' &&
          collection != 'variationTrackers' &&
          collection != 'notifications' &&
          collection != 'materialSendRecords' &&
          collection != 'fileReports' &&
          // 1.10.0 round 2: job and booking reads are enforced above (§17); never re-opened here.
          !(collection in ['projects', 'smallWorks', 'bookings', 'managerSiteBookings', 'subcontractorBookings']);
      }
    }

    // Shared product ideas board — every signed-in organisation can read and submit.
    // The owner console (info@projectplanner.us) can hide, merge, and write private notes.
    match /productFeedback/{suggestionId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null &&
        request.resource.data.authorUserId == request.auth.uid &&
        (!('hidden' in request.resource.data) || request.resource.data.hidden != true);
      allow update: if isPlatformOwner() || (
        request.auth != null &&
        resource.data.authorUserId == request.auth.uid &&
        request.resource.data.diff(resource.data).changedKeys().hasOnly(['title', 'details', 'category', 'updatedAt', 'voteCount', 'commentCount'])
      ) || (
        request.auth != null &&
        request.resource.data.diff(resource.data).changedKeys().hasOnly(['voteCount', 'commentCount', 'updatedAt'])
      );
      allow delete: if isPlatformOwner();

      match /private/{docId} {
        allow read: if isPlatformOwner();
        allow write: if isPlatformOwner();
      }
    }

    match /productFeedbackVotes/{voteId} {
      allow read: if isPlatformOwner() ||
        (request.auth != null && resource.data.userId == request.auth.uid);
      allow create: if request.auth != null &&
        request.resource.data.userId == request.auth.uid &&
        voteId == request.resource.data.suggestionId + '_' + request.auth.uid;
      allow delete: if request.auth != null && resource.data.userId == request.auth.uid;
      allow update: if false;
    }

    match /productFeedbackFollows/{followId} {
      allow read: if isPlatformOwner() ||
        (request.auth != null && resource.data.userId == request.auth.uid);
      allow create: if request.auth != null &&
        request.resource.data.userId == request.auth.uid &&
        followId == request.resource.data.suggestionId + '_' + request.auth.uid;
      allow delete: if request.auth != null && resource.data.userId == request.auth.uid;
      allow update: if false;
    }

    match /productFeedbackComments/{commentId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.resource.data.authorUserId == request.auth.uid;
      allow update: if isPlatformOwner() || (
        request.auth != null && resource.data.authorUserId == request.auth.uid
      );
      allow delete: if isPlatformOwner() || (
        request.auth != null && resource.data.authorUserId == request.auth.uid
      );
    }

    match /productFeedbackHistory/{historyId} {
      allow read: if isPlatformOwner();
      allow write: if isPlatformOwner();
    }

    match /productEvents/{eventId} {
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
      allow read: if isPlatformOwner();
      allow update: if false;
      allow delete: if false;
    }

    match /productSessions/{sessionId} {
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
      allow update: if request.auth != null && resource.data.userId == request.auth.uid;
      allow read: if isPlatformOwner() || (request.auth != null && resource.data.userId == request.auth.uid);
      allow delete: if false;
    }

    match /adminAuditLog/{id} {
      allow read: if isPlatformOwner();
      allow create: if isPlatformOwner();
      allow update, delete: if false;
    }

    match /supportRequests/{id} {
      allow read: if isPlatformOwner() ||
        (request.auth != null && resource.data.requestedByUid == request.auth.uid);
      allow create: if request.auth != null &&
        request.resource.data.requestedByUid == request.auth.uid &&
        request.resource.data.status == 'open';
      allow update: if isPlatformOwner();
      allow delete: if false;
    }

    match /stripeEvents/{id} {
      allow read, write: if false;
    }

    match /publicStats/{id} {
      allow read: if true;
      allow write: if false;
    }

    match /analyticsDaily/{id} {
      allow read: if isPlatformOwner();
      allow write: if false;
    }

    match /analyticsMonthly/{id} {
      allow read: if isPlatformOwner();
      allow write: if false;
    }

    match /analyticsTotals/{id} {
      allow read: if isPlatformOwner();
      allow write: if false;
    }

    match /ownerAlerts/{id} {
      allow read: if isPlatformOwner();
      allow write: if false;
    }

    match /adminJobs/{id} {
      allow read: if isPlatformOwner();
      allow write: if false;
    }

    match /deletedOrganisations/{id} {
      allow read: if isPlatformOwner();
      allow write: if false;
    }

    // Rulebook 1.12.0 (§18, appUpdateRequired): `platformConfig/app` { minimumIosBuild, minimumWebVersion? } is read
    // before sign-in (the forced-update gate), so anyone reads it; the rest (toolbox library) stays signed-in. Only the
    // platform owner (verified token email) writes.
    match /platformConfig/{id} {
      allow read: if id == 'app' || request.auth != null;
      allow write: if isPlatformOwner();
    }

    // Interest registrations are created only by the website Admin API. Clients cannot write this collection.
    match /interestRegistrations/{id} {
      allow create: if false;
      allow read, update, delete: if isPlatformOwner();
    }

    // Marketing suppression list. Admin API only — no client reads or writes.
    // There is no root catch-all; this match is explicit so the collection is never world-readable.
    match /emailSuppressions/{email} {
      allow read, write: if false;
    }
  }
}
