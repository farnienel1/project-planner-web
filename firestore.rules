            next.get('accountActive', true) == true &&
            next.get('status', 'active') == 'active' &&
            next.get('invitedBy', inv.get('invitedBy', '')) == inv.get('invitedBy', '');
        }
        allow get: if request.auth != null && (
          request.auth.uid == userId ||
          isOrgAdminViaMembersMap(membershipOrgId) ||
          isOrganizationAdmin(membershipOrgId)
        );
        allow list: if request.auth != null && request.auth.uid == userId;
        allow create, update: if request.auth != null && (
          ((isOrgAdminViaMembersMap(membershipOrgId) || isOrganizationAdmin(membershipOrgId)) &&
           ((privilegeFlag(request.resource.data, 'isSuperAdmin') ==
             (resource == null ? false : privilegeFlag(resource.data, 'isSuperAdmin'))) || callerIsSuperAdminOf(membershipOrgId))) ||
          (request.auth.uid == userId && membershipSelfWriteAllowed()) ||
          membershipFromInvitation()
        );
        allow delete: if request.auth != null && (
          request.auth.uid == userId ||
          isOrgAdminViaMembersMap(membershipOrgId) ||
          isOrganizationAdmin(membershipOrgId) ||
          (exists(/databases/(default)/documents/users/$(userId)) &&
           managerMayManageOperative(userId, get(/databases/(default)/documents/users/$(userId)).data))
        );
      }
    }

    match /organizations/{organizationId} {
      match /userEmails/{emailKey} {
        allow read: if request.auth != null && (
          canAccessOrganization(organizationId) ||
          (resource != null && resource.data.userId == request.auth.uid) ||
          (request.auth.token.email is string &&
           emailKey == request.auth.token.email.lower())
        );
        allow create, update: if request.auth != null && (
          isPlatformOwner() ||
          isAdminOfCompany(organizationId) ||
          isOwnEmailClaimWrite(organizationId, emailKey) ||
          (isManagerWithOperativesAccess() && userOrgIdMatchesPath(organizationId))
        );
        allow delete: if request.auth != null && (
          isPlatformOwner() || isAdminOfCompany(organizationId) ||
          (isManagerWithOperativesAccess() && userOrgIdMatchesPath(organizationId) &&
           resource.data.get('userId', '') is string && resource.data.get('userId', '') != request.auth.uid &&
           !string(resource.data.get('userId', '')).matches('(|.*/.*)') &&
           exists(/databases/(default)/documents/users/$(resource.data.userId)) &&
           isOperativeProfile(get(/databases/(default)/documents/users/$(resource.data.userId)).data) &&
           manageableOperative(get(/databases/(default)/documents/users/$(resource.data.userId)).data)) || (
            resource.data.get('userId', '') == request.auth.uid &&
            request.auth.token.email is string &&
            request.auth.token.email_verified == true &&
            emailKey != request.auth.token.email.lower()
          )
        );
      }

      allow get: if request.auth != null && (
        isPlatformOwner() ||
        userOrgIdMatchesPath(organizationId) ||
        (resource != null && 'members' in resource.data && resource.data.members[request.auth.uid] != null) ||
        (resource != null && 'creatorUserId' in resource.data && resource.data.creatorUserId == request.auth.uid)
      );

      allow list: if request.auth != null && (
        isPlatformOwner() ||
        resource.data.members[request.auth.uid] != '' ||
        resource.data.creatorUserId == request.auth.uid
      );

      allow create: if request.auth != null &&
                     request.resource.data.members[request.auth.uid] == 'admin';

      function orgRootNewCreatorIsAdmin() {
        let newId = request.resource.data.get('creatorUserId', null);
        return newId is string && newId.size() > 0 && (
          (request.resource.data.get('members', {}) is map &&
           request.resource.data.get('members', {}).get(newId, null) == 'admin') || (
            exists(/databases/(default)/documents/users/$(newId)) &&
            userDocOrganizationMatches(get(/databases/(default)/documents/users/$(newId)).data, organizationId) &&
            adminLikeUser(get(/databases/(default)/documents/users/$(newId)).data) &&
            !isOperativeLikeUser(get(/databases/(default)/documents/users/$(newId)).data)
          )
        );
      }
      function orgRootCallerIsSuperAdmin() {
        return resource.data.get('creatorUserId', null) == request.auth.uid || (
          exists(/databases/(default)/documents/users/$(request.auth.uid)) &&
          staffFlag(get(/databases/(default)/documents/users/$(request.auth.uid)).data, 'isSuperAdmin') &&
          userOrgIdMatchesPath(organizationId)
        );
      }
      function orgRootInviteJoin() {
        let membership = /databases/(default)/documents/users/$(request.auth.uid)/orgMemberships/$(organizationId);
        let invId = getAfter(membership).data.get('invitationId', '');
        let inv = get(/databases/(default)/documents/invitations/$(invId)).data;
        return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members']) &&
          request.resource.data.get('members', {}).diff(resource.data.get('members', {})).affectedKeys()
            .hasOnly([request.auth.uid]) &&
          resource.data.get('members', {}).get(request.auth.uid, null) == null &&
          inviteBeingAccepted(invId, organizationId) &&
          request.resource.data.members[request.auth.uid] == invitationRole(inv);
      }
      function orgRootSuperAdminRestore() {
        let d = resource.data.get('deletion', {});
        return orgScheduledForErasure() &&
          d.get('restoreBy', 'super_admin') != 'platform_owner' &&
          !('deletion' in request.resource.data) &&
          request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['deletion', 'updatedAt', 'updatedBy', 'updatedFrom']) &&
          orgRootCallerIsSuperAdmin();
      }
      function orgRootOperativesManagerRemovesMember() {
        let home = callerHomeData();
        return staffFlag(home, 'operatives') && !adminLikeUser(home) && staffFlag(home, 'manager') &&
          !isOperativeProfile(home) && homeOrgIs(home, organizationId) && home.get('isActive', true) != false &&
          orgRootRemovesOneOperativeMember();
      }
      function orgRootRemovesOneOperativeMember() {
        let gone = request.resource.data.get('members', {}).diff(resource.data.get('members', {}));
        let removed = resource.data.get('members', {}).keys().removeAll(request.resource.data.get('members', {}).keys());
        let uid = removed.size() == 1 ? removed[0] : '_';
        return gone.removedKeys().size() == 1 && gone.addedKeys().size() == 0 && gone.changedKeys().size() == 0 &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members']) &&
          resource.data.members[uid] == 'operative' && uid != request.auth.uid &&
          !existsAfter(/databases/(default)/documents/users/$(uid)) &&
          billingUnchanged() && deletionUnchanged();
      }
      allow update: if (request.auth != null && orgRootOperativesManagerRemovesMember()) ||
                   billingUnchanged() && (isPlatformOwner() || (request.auth != null && orgRootSuperAdminRestore())) ||
                   billingUnchanged() && deletionUnchanged() && !orgScheduledForErasure() && (
                     isPlatformOwner() || (
                       request.auth != null &&
                       (isOrganizationAdminAnyBilling(organizationId) ||
                         ('members' in resource.data && resource.data.members is map &&
                          resource.data.members.get(request.auth.uid, null) == 'admin')) && (
                         (request.resource.data.get('creatorUserId', null) == resource.data.get('creatorUserId', null)) ||
                         (orgRootCallerIsSuperAdmin() && orgRootNewCreatorIsAdmin())
                       )
                     ) || (
                       request.auth != null && orgRootInviteJoin()
                     )
                   );

      function callerJobToggle(role, kind) {
        let home = callerHomeData();
        let membership = /databases/(default)/documents/users/$(request.auth.uid)/orgMemberships/$(organizationId);
        return role == 'manager' && (
          homeOrgIs(home, organizationId)
            ? staffFlag(home, kind)
            : (exists(membership) &&
               truthyBool(get(membership).data.get('permissions', {}).get(kind, get(membership).data.get(kind, false))))
        );
      }
      function callerSeesEveryJob(role, kind) {
        return role == 'admin' || callerJobToggle(role, kind) || isPlatformOwner();
      }
      function legacyMemberRead(role) {
        return role != '' || canAccessOrganization(organizationId);
      }
      function jobGetAllowed(kind) {
        let role = callerOrgRole(organizationId);
        return role in ['operative', 'member'] ||
          (!enforcedReadsOn(organizationId) && legacyMemberRead(role)) ||
          (role == 'manager' && resource != null && jobListsCaller(resource.data)) ||
          callerSeesEveryJob(role, kind);
      }
      function jobListAllowed(kind) {
        let role = callerOrgRole(organizationId);
        return callerSeesEveryJob(role, kind) ||
          (role == 'manager' && request.auth.uid in resource.data.get('managerUserIds', [])) ||
          (!enforcedReadsOn(organizationId) && legacyMemberRead(role));
      }
      function jobCreateAllowed(kind) {
        let next = request.resource.data;
        return (next.get('managerIds', []).size() > 0 || next.get('managerUserIds', []).size() > 0 ||
                next.get('assignedManagerUserIds', []).size() > 0 ||
                (next.get('managerId', '') is string && next.get('managerId', '') != '')) &&
          callerSeesEveryJob(callerOrgRole(organizationId), kind);
      }
      function jobUpdateAllowed(kind) {
        let role = callerOrgRole(organizationId);
        return callerSeesEveryJob(role, kind) || (
          role == 'manager' &&
          !request.resource.data.diff(resource.data).affectedKeys()
            .hasAny(['managerIds', 'managerId', 'assignedManagerUserIds', 'managerUserIds']) &&
          jobListsCaller(resource.data)
        );
      }
      function jobDocReadable(kind, jobId) {
        let role = callerOrgRole(organizationId);
        let path = /databases/(default)/documents/organizations/$(organizationId)/$(kind)/$(jobId);
        return role in ['operative', 'member'] ||
          (!enforcedReadsOn(organizationId) && legacyMemberRead(role)) ||
          (role == 'manager' && exists(path) && jobListsCaller(get(path).data)) ||
          callerSeesEveryJob(role, kind);
      }

      match /projects/{projectId} {
        allow get: if jobGetAllowed('projects');
        allow list: if jobListAllowed('projects');
        allow create: if jobCreateAllowed('projects');
        allow update: if jobUpdateAllowed('projects');
        allow delete: if isOrganizationAdmin(organizationId);

        match /healthSafety/{documentId} {
          allow read: if jobDocReadable('projects', projectId);
          allow create, update: if canAccessOrganization(organizationId);
          allow delete: if isOrganizationAdmin(organizationId);
        }
      }

      match /smallWorks/{smallWorkId} {
        allow get: if jobGetAllowed('smallWorks');
        allow list: if jobListAllowed('smallWorks');
        allow create: if jobCreateAllowed('smallWorks');
        allow update: if jobUpdateAllowed('smallWorks');
        allow delete: if isOrganizationAdmin(organizationId);

        match /healthSafety/{documentId} {
          allow read: if jobDocReadable('smallWorks', smallWorkId);
          allow create, update: if canAccessOrganization(organizationId);
          allow delete: if isOrganizationAdmin(organizationId);
        }
      }

      match /clients/{clientId} {
        allow read: if canAccessOrganization(organizationId);
        allow create, update: if canAccessOrganization(organizationId);
        allow delete: if isOrganizationAdmin(organizationId);
      }

      function rosterRowPayKeysChanged() {
        return (resource == null
          ? request.resource.data.keys().toSet()
          : request.resource.data.diff(resource.data).affectedKeys()
        ).hasAny(['dayRate', 'hourlyRate', 'payBasis', 'employmentType',
                  'employmentTypeTransitionFrom', 'employmentTypeEffectiveAt']);
      }
      function operativeRowIsCaller() {
        return !(request.auth.token.email is string) ||
          string(request.resource.data.get('email', '')).lower() == request.auth.token.email.lower() ||
          (resource != null && string(resource.data.get('email', '')).lower() == request.auth.token.email.lower());
      }

      function rosterRowEmailChanged() {
        return resource != null &&
          string(request.resource.data.get('email', '')).trim().lower() != string(resource.data.get('email', '')).trim().lower();
      }
      function rosterRowAdmin() {
        return isOrgAdminViaMembersMap(organizationId) || isPlatformOwner() || isOrganizationAdmin(organizationId);
      }
      function operativesManagerForOtherRow() {
        return isManagerWithOperativesAccess() && userOrgIdMatchesPath(organizationId) && !operativeRowIsCaller();
      }

      match /operatives/{operativeId} {
        allow read: if canAccessOrganization(organizationId);
        allow create, update: if canAccessOrganization(organizationId) &&
          (resource != null || isOrgManagerOrAdmin(organizationId) || isPlatformOwner()) &&
          (!rosterRowPayKeysChanged() || rosterRowAdmin() || operativesManagerForOtherRow()) &&
          (!rosterRowEmailChanged() || rosterRowAdmin() || operativesManagerForOtherRow()) &&
          payStaysPrivate(organizationId) &&
          writeMetadataValidWhenPresent();
        allow delete: if isOrganizationAdmin(organizationId) || (
          isManagerWithOperativesAccess() && userOrgIdMatchesPath(organizationId) &&
          !(request.auth.token.email is string &&
            string(resource.data.get('email', '')).lower() == request.auth.token.email.lower())
        );
      }

      function bookingTombstoned(bookingId) {
        return exists(/databases/(default)/documents/organizations/$(organizationId)/deletedBookings/$(bookingId));
      }
      function jobListsCaller(job) {
        let uid = request.auth.uid.lower();
        let primary = job.get('managerId', '');
        return ((',' + job.get('managerUserIds', []).join(',').lower() + ',').matches('.*,(user:)?' + uid + ',.*')) ||
          ((',' + job.get('managerIds', []).join(',').lower() + ',').matches('.*,(user:)?' + uid + ',.*')) ||
          (primary is string && primary.lower() in [uid, 'user:' + uid]) ||
          (primary is string && primary.size() > 0 && !primary.matches('.*/.*') &&
            request.auth.token.email is string &&
            exists(/databases/(default)/documents/organizations/$(organizationId)/managers/$(primary)) &&
            string(get(/databases/(default)/documents/organizations/$(organizationId)/managers/$(primary)).data.get('email', '')).lower() == request.auth.token.email.lower());
      }
      function callerManagesJobAt(jobId) {
        return (exists(/databases/(default)/documents/organizations/$(organizationId)/projects/$(jobId)) &&
            jobListsCaller(get(/databases/(default)/documents/organizations/$(organizationId)/projects/$(jobId)).data)) ||
          (exists(/databases/(default)/documents/organizations/$(organizationId)/smallWorks/$(jobId)) &&
            jobListsCaller(get(/databases/(default)/documents/organizations/$(organizationId)/smallWorks/$(jobId)).data));
      }
      function callerManagesJob(jobId) {
        return jobId is string && jobId.size() > 0 && !jobId.matches('.*/.*') && (
          callerManagesJobAt(jobId) ||
          (jobId != jobId.upper() && callerManagesJobAt(jobId.upper())) ||
          (jobId != jobId.lower() && callerManagesJobAt(jobId.lower()))
        );
      }
      function callerManagesJobInAt(kind, jobId) {
        let path = /databases/(default)/documents/organizations/$(organizationId)/$(kind)/$(jobId);
        return exists(path) && jobListsCaller(get(path).data);
      }
      function callerManagesJobIn(kind, jobId) {
        return jobId is string && jobId.size() > 0 && !jobId.matches('.*/.*') && kind in ['projects', 'smallWorks'] && (
          callerManagesJobInAt(kind, jobId) ||
          (jobId != jobId.upper() && callerManagesJobInAt(kind, jobId.upper())) ||
          (jobId != jobId.lower() && callerManagesJobInAt(kind, jobId.lower()))
        );
      }
      function bookingJobId(collection, data) {
        return collection == 'managerSiteBookings'
          ? data.get('locationId', '')
          : data.get('projectId', data.get('projectID', ''));
      }
      function bookingHasJob(collection, data) {
        return collection != 'managerSiteBookings' || data.get('locationType', '') in ['project', 'small_work'];
      }
      function bookingJobCollectionValid(collection, data) {
        return !('jobCollection' in data) ||
          (data.jobCollection in ['projects', 'smallWorks'] && bookingHasJob(collection, data));
      }
      function managerMayWriteBookingData(collection, data) {
        return bookingHasJob(collection, data)
          ? ('jobCollection' in data
              ? callerManagesJobIn(data.jobCollection, bookingJobId(collection, data))
              : callerManagesJob(bookingJobId(collection, data)))
          : data.get('userId', '') == request.auth.uid;
      }
      function bookingWriteAllowed(collection, op) {
        let role = callerOrgRole(organizationId);
        return (op == 'delete' || bookingJobCollectionValid(collection, request.resource.data)) && (
          role == 'admin' || (
            role == 'manager' && (
              op == 'create' ? managerMayWriteBookingData(collection, request.resource.data) : (
                managerMayWriteBookingData(collection, resource.data) && (
                  op != 'update' ||
                  (bookingJobId(collection, request.resource.data) == bookingJobId(collection, resource.data) &&
                   bookingHasJob(collection, request.resource.data) == bookingHasJob(collection, resource.data) &&
                   request.resource.data.get('jobCollection', '') == resource.data.get('jobCollection', '') &&
                   request.resource.data.get('userId', '') == resource.data.get('userId', '')) ||
                  managerMayWriteBookingData(collection, request.resource.data)
                )
              )
            )
          ) || isPlatformOwner()
        );
      }
      function bookingTombstoneAllowed(collection, bookingId) {
        let role = callerOrgRole(organizationId);
        let path = /databases/(default)/documents/organizations/$(organizationId)/$(collection)/$(bookingId);
        return role == 'admin' || isPlatformOwner() || (
          role == 'manager' && exists(path) && (
            (collection == 'bookings' && operativesManagerRemovesOrphanBooking(get(path).data)) ||
            managerMayWriteBookingData(collection, get(path).data)
          )
        );
      }
      function operativesManagerRemovesOrphanBooking(data) {
        let home = callerHomeData();
        let opId = data.get('operativeId', '');
        return staffFlag(home, 'operatives') && !adminLikeUser(home) && staffFlag(home, 'manager') &&
          !isOperativeProfile(home) && homeOrgIs(home, organizationId) && home.get('isActive', true) != false &&
          data.get('date', null) is timestamp && data.date > request.time &&
          opId is string && opId.size() > 0 && !opId.matches('.*/.*') &&
          !exists(/databases/(default)/documents/users/$(opId));
      }

      function callerOwnsBookingId(personId) {
        let home = callerHomeData();
        let row = /databases/(default)/documents/organizations/$(organizationId)/operatives/$(personId);
        return personId is string && personId.size() > 0 && (
          personId == request.auth.uid ||
          (homeOrgIs(home, organizationId) && (
            personId in home.get('formerUserIds', []) ||
            personId in home.get('sameEmailUserIds', []))) ||
          (!personId.matches('.*/.*') && request.auth.token.email is string && exists(row) &&
            string(get(row).data.get('email', '')).lower() == request.auth.token.email.lower())
        );
      }
      function bookingReadAllowed(collection) {
        let role = callerOrgRole(organizationId);
        return role == 'admin' ||
          (!enforcedReadsOn(organizationId) && (role != '' || canAccessOrganization(organizationId))) ||
          (role == 'manager' && resource.data.get('jobCollection', '') in ['projects', 'smallWorks'] &&
            callerJobToggle(role, resource.data.get('jobCollection', ''))) ||
          (collection == 'managerSiteBookings' && role == 'manager' && resource.data.userId == request.auth.uid) ||
          (collection == 'bookings' && role != '' && callerOwnsBookingId(resource.data.operativeId)) ||
          (role == 'manager' && callerManagesJob(
            collection == 'managerSiteBookings' ? resource.data.locationId : resource.data.projectId
          )) ||
          isPlatformOwner();
      }

      match /deletedBookings/{bookingId} {
        allow read: if canAccessOrganization(organizationId);
        allow create: if request.auth != null &&
          request.resource.data.keys().toSet() == ['bookingId', 'collection', 'deletedAt', 'deletedBy', 'deletedFrom'].toSet() &&
          request.resource.data.bookingId == bookingId &&
          request.resource.data.deletedBy == request.auth.uid &&
          request.resource.data.deletedAt == request.time &&
          request.resource.data.deletedFrom in ['web', 'ios', 'android'] &&
          request.resource.data.collection in ['bookings', 'managerSiteBookings', 'subcontractorBookings'] &&
          bookingTombstoneAllowed(request.resource.data.collection, bookingId);
        allow delete: if isOrganizationAdmin(organizationId) || isOrgAdminViaMembersMap(organizationId) || isPlatformOwner();
      }

      function bookingPersonId(collection, data) {
        return collection == 'managerSiteBookings' ? data.get('userId', '') : data.get('operativeId', '');
      }
      function callerLineManagesUser(uid) {
        let path = /databases/(default)/documents/users/$(uid);
        return uid is string && uid.size() > 0 && !uid.matches('.*/.*') && uid != request.auth.uid &&
          exists(path) && homeOrgIs(get(path).data, organizationId) &&
          get(path).data.get('hasNoLineManager', false) != true &&
          request.auth.uid in lineManagerIdList(get(path).data) &&
          !callerHomeIsOperative();
      }
      function overtimeMultiplierWriteValid() {
        let m = request.resource.data.get('otMultiplierOverride', null);
        return m == null || m == resource.data.get('otMultiplierOverride', null) ||
          (m is number && m >= 1 && m <= 3 && m * 4 == math.floor(m * 4));
      }
      function overtimeCallerIsStaffHere() {
        let home = callerHomeData();
        return homeOrgIs(home, organizationId) && home.get('isActive', true) != false &&
          (adminLikeUser(home) || !isOperativeProfile(home)) && orgBillingOpen(organizationId);
      }
      function overtimeTextFieldValid(affected, key, maxSize) {
        return !(key in affected) || (request.resource.data[key] is string && request.resource.data[key].size() <= maxSize);
      }
      function overtimeLineManagerBookingUpdate(collection) {
        let affected = request.resource.data.diff(resource.data).affectedKeys();
        return affected.hasOnly([
            'workStartTime', 'workEndTime', 'timeSlot', 'otMultiplierOverride', 'status', 'updatedAt', 'updatedBy', 'updatedFrom'
          ]) ? (
          overtimeTextFieldValid(affected, 'workStartTime', 8) &&
          overtimeTextFieldValid(affected, 'workEndTime', 8) &&
          (!('timeSlot' in affected) || request.resource.data.timeSlot in ['CUSTOM_HOURS', 'CUSTOM', 'FULL DAY', 'FULL_DAY', 'AM', 'PM']) &&
          (request.resource.data.get('status', null) == resource.data.get('status', null) ||
            request.resource.data.get('status', null) == 'Cancelled') &&
          overtimeMultiplierWriteValid() &&
          writeMetadataValidWhenPresent() &&
          callerLineManagesUser(bookingPersonId(collection, resource.data)) &&
          overtimeCallerIsStaffHere()) : false;
      }
      function overtimeViewer(uid) {
        return canAccessOrganization(organizationId) &&
          (isOrgAdminOrOwner(organizationId) || (uid is string && uid.size() > 0 && (uid == request.auth.uid || callerLineManagesUser(uid))));
      }
      function overtimeOwnBookingEditable(collection, bookingId) {
        let role = callerOrgRole(organizationId);
        let path = /databases/(default)/documents/organizations/$(organizationId)/$(collection)/$(bookingId);
        return role == 'admin' || (role == 'manager' && exists(path) && managerMayWriteBookingData(collection, get(path).data));
      }

      match /overtimeRequests/{requestId} {
        allow read: if overtimeViewer(resource.data.get('userId', ''));
        allow create: if canAccessOrganization(organizationId) &&
          callerOrgRole(organizationId) != '' &&
          request.resource.data.keys().hasOnly(['userId', 'rangeStart', 'rangeEnd', 'status', 'lines', 'createdAt', 'updatedAt', 'updatedBy', 'updatedFrom']) &&
          request.resource.data.keys().hasAll(['userId', 'rangeStart', 'rangeEnd', 'status', 'lines']) &&
          request.resource.data.userId == request.auth.uid &&
          request.resource.data.status == 'pending' &&
          request.resource.data.lines is list && request.resource.data.lines.size() > 0 &&
          request.resource.data.rangeStart is string && request.resource.data.rangeEnd is string &&
          writeMetadataValidWhenPresent();
        allow update: if canAccessOrganization(organizationId) &&
          resource.data.status == 'pending' &&
          request.resource.data.userId == resource.data.userId &&
          writeMetadataValidWhenPresent() && (
            (resource.data.userId == request.auth.uid &&
              request.resource.data.status == 'withdrawn' &&
              request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'withdrawnAt', 'updatedAt', 'updatedBy', 'updatedFrom'])) ||
            (resource.data.userId != request.auth.uid &&
              (isOrgAdminOrOwner(organizationId) || callerLineManagesUser(resource.data.userId)) &&
              request.resource.data.status == 'approved' &&
              request.resource.data.get('decidedBy', '') == request.auth.uid &&
              request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                'status', 'decisions', 'decidedBy', 'decidedAt', 'appliedBookingIds', 'droppedBookingIds', 'updatedAt', 'updatedBy', 'updatedFrom'
              ]))
          );
      }

      match /overtimeReviews/{reviewId} {
        allow read: if overtimeViewer(resource.data.get('userId', ''));
        allow create, update: if canAccessOrganization(organizationId) &&
          request.resource.data.keys().hasOnly(['userId', 'bookingId', 'collection', 'decision', 'fingerprint', 'reviewedBy', 'reviewedAt', 'requestId', 'updatedAt', 'updatedBy', 'updatedFrom']) &&
          request.resource.data.keys().hasAll(['userId', 'bookingId', 'collection', 'decision', 'fingerprint', 'reviewedBy']) &&
          request.resource.data.userId is string && request.resource.data.bookingId is string &&
          reviewId == request.resource.data.userId + '_' + request.resource.data.bookingId &&
          request.resource.data.reviewedBy == request.auth.uid &&
          request.resource.data.collection in ['bookings', 'managerSiteBookings'] &&
          request.resource.data.decision in ['approved', 'edited', 'trimmed', 'cancelled'] &&
          writeMetadataValidWhenPresent() && (
            request.resource.data.userId == request.auth.uid
              ? overtimeOwnBookingEditable(request.resource.data.collection, request.resource.data.bookingId)
              : (callerLineManagesUser(request.resource.data.userId) || isOrgAdminOrOwner(organizationId))
          );
        allow delete: if isOrgAdminOrOwner(organizationId);
      }

      match /overtimeReports/{reportId} {
        allow read: if overtimeViewer(resource.data.get('userId', ''));
        allow create: if canAccessOrganization(organizationId) &&
          callerOrgRole(organizationId) != '' &&
          request.resource.data.keys().hasOnly(['userId', 'userName', 'companyName', 'rangeStart', 'rangeEnd', 'kind', 'lines', 'totals', 'generatedBy', 'generatedAt', 'updatedAt', 'updatedBy', 'updatedFrom']) &&
          request.resource.data.keys().hasAll(['userId', 'rangeStart', 'rangeEnd', 'kind', 'lines', 'totals', 'generatedBy']) &&
          request.resource.data.userId == request.auth.uid &&
          request.resource.data.generatedBy == request.auth.uid &&
          request.resource.data.kind == 'overtime' &&
          request.resource.data.lines is list &&
          writeMetadataValidWhenPresent();
      }

      function payeClaimDayKey(v) {
        return v is string && v.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$');
      }
      function payeClaimText(data, key, minSize, maxSize) {
        return data.get(key, '') is string && data.get(key, '').size() >= minSize && data.get(key, '').size() <= maxSize;
      }
      function payeClaimEvidenceAt(list, i, pattern) {
        return list.size() <= i || (
          list[i] is map && list[i].get('path', '').matches(pattern) && list[i].get('contentType', '') != 'image/svg+xml'
        );
      }
      function payeClaimEvidenceValid(list, uid) {
        let pattern = 'organizations/' + organizationId + '/payeClaims/' + uid + '/[A-Za-z0-9_.-]+';
        return list is list && list.size() <= 20 &&
          payeClaimEvidenceAt(list, 0, pattern) && payeClaimEvidenceAt(list, 1, pattern) &&
          payeClaimEvidenceAt(list, 2, pattern) && payeClaimEvidenceAt(list, 3, pattern) &&
          payeClaimEvidenceAt(list, 4, pattern);
      }
      function payeClaimCommonValid(data) {
        return data.userId == request.auth.uid &&
          data.get('createdBy', request.auth.uid) == request.auth.uid &&
          payeClaimText(data, 'title', 1, 200) &&
          payeClaimText(data, 'details', 0, 4000) &&
          payeClaimText(data, 'currency', 0, 3) &&
          data.amount is number && data.amount > 0 && data.amount <= 1000000 &&
          payeClaimEvidenceValid(data.evidence, data.userId) &&
          writeMetadataValidWhenPresent();
      }
      function priceWorkApproverValid(approverId) {
        return approverId is string && approverId.size() > 0 && !approverId.matches('.*/.*') &&
          approverId != request.auth.uid &&
          exists(/databases/(default)/documents/users/$(approverId)) &&
          priceWorkApproverData(get(/databases/(default)/documents/users/$(approverId)).data);
      }
      function priceWorkApproverData(d) {
        return homeOrgIs(d, organizationId) && d.get('isActive', true) != false &&
          (adminLikeUser(d) || (!isOperativeProfile(d) && (staffFlag(d, 'manager') || d.get('role', '') == 'manager')));
      }
      function priceWorkItemValid(data) {
        return data.keys().hasOnly(['userId', 'title', 'details', 'jobNumber', 'startDate', 'endDate', 'approvedByUserId', 'approvedByName', 'amount', 'currency', 'evidence', 'createdBy', 'createdAt', 'updatedAt', 'updatedBy', 'updatedFrom']) &&
          data.keys().hasAll(['userId', 'title', 'startDate', 'endDate', 'approvedByUserId', 'amount', 'evidence']) &&
          payeClaimCommonValid(data) &&
          payeClaimDayKey(data.startDate) && payeClaimDayKey(data.endDate) && data.endDate >= data.startDate &&
          payeClaimText(data, 'approvedByName', 0, 200) &&
          (!('jobNumber' in data) || (data.jobNumber is string && data.jobNumber.size() >= 1 && data.jobNumber.size() <= 60)) &&
          priceWorkApproverValid(data.approvedByUserId);
      }
      function expenseItemValid(data) {
        return data.keys().hasOnly(['userId', 'title', 'details', 'jobNumber', 'date', 'amount', 'currency', 'evidence', 'createdBy', 'createdAt', 'updatedAt', 'updatedBy', 'updatedFrom']) &&
          data.keys().hasAll(['userId', 'title', 'date', 'amount', 'evidence']) &&
          payeClaimCommonValid(data) &&
          payeClaimDayKey(data.date) &&
          payeClaimText(data, 'jobNumber', 0, 60) &&
          data.evidence.size() >= 1;
      }
      function payeClaimOwnerWriter(uid) {
        return uid == request.auth.uid && callerOrgRole(organizationId) != '';
      }

      match /priceWorkItems/{itemId} {
        allow read: if overtimeViewer(resource.data.get('userId', ''));
        allow create: if payeClaimOwnerWriter(request.resource.data.get('userId', '')) &&
          payeClaimText(request.resource.data, 'jobNumber', 1, 60) &&
          priceWorkItemValid(request.resource.data);
        allow update: if payeClaimOwnerWriter(resource.data.get('userId', '')) &&
          request.resource.data.userId == resource.data.userId &&
          request.resource.data.get('createdBy', '') == resource.data.get('createdBy', '') &&
          priceWorkItemValid(request.resource.data);
        allow delete: if payeClaimOwnerWriter(resource.data.get('userId', ''));
      }

      match /expenseItems/{itemId} {
        allow read: if overtimeViewer(resource.data.get('userId', ''));
        allow create: if payeClaimOwnerWriter(request.resource.data.get('userId', '')) && expenseItemValid(request.resource.data);
        allow update: if payeClaimOwnerWriter(resource.data.get('userId', '')) &&
          request.resource.data.userId == resource.data.userId &&
          request.resource.data.get('createdBy', '') == resource.data.get('createdBy', '') &&
          expenseItemValid(request.resource.data);
        allow delete: if payeClaimOwnerWriter(resource.data.get('userId', ''));
      }

      match /payeClaimReports/{reportId} {
        allow read: if overtimeViewer(resource.data.get('userId', ''));
        allow create: if payeClaimOwnerWriter(request.resource.data.get('userId', '')) &&
          request.resource.data.keys().hasOnly(['userId', 'userName', 'companyName', 'kind', 'rangeStart', 'rangeEnd', 'currency', 'items', 'totals', 'generatedBy', 'generatedAt', 'updatedAt', 'updatedBy', 'updatedFrom']) &&
          request.resource.data.keys().hasAll(['userId', 'kind', 'rangeStart', 'rangeEnd', 'items', 'totals', 'generatedBy']) &&
          request.resource.data.generatedBy == request.auth.uid &&
          request.resource.data.kind in ['priceWork', 'expense'] &&
          request.resource.data.items is list && request.resource.data.items.size() <= 500 &&
          writeMetadataValidWhenPresent();
      }

      match /personalSiteAudits/{auditId} {
        allow read: if canAccessOrganization(organizationId) && resource.data.get('ownerUserId', '') == request.auth.uid;
        allow create: if payeClaimOwnerWriter(request.resource.data.get('ownerUserId', '')) &&
          request.resource.data.keys().hasOnly(['ownerUserId', 'jobNumber', 'jobName', 'type', 'customTitle', 'date', 'authorName', 'items', 'createdAt', 'updatedAt', 'updatedBy', 'updatedFrom']) &&
          request.resource.data.keys().hasAll(['ownerUserId', 'jobName', 'date', 'items']) &&
          payeClaimText(request.resource.data, 'jobName', 1, 200) &&
          payeClaimText(request.resource.data, 'jobNumber', 0, 60) &&
          payeClaimDayKey(request.resource.data.date) &&
          request.resource.data.items is list && request.resource.data.items.size() >= 1 && request.resource.data.items.size() <= 100 &&
          writeMetadataValidWhenPresent();
        allow update: if payeClaimOwnerWriter(resource.data.get('ownerUserId', '')) &&
          request.resource.data.ownerUserId == resource.data.ownerUserId &&
          request.resource.data.keys().hasOnly(['ownerUserId', 'jobNumber', 'jobName', 'type', 'customTitle', 'date', 'authorName', 'items', 'createdAt', 'updatedAt', 'updatedBy', 'updatedFrom']) &&
          payeClaimText(request.resource.data, 'jobName', 1, 200) &&
          payeClaimText(request.resource.data, 'jobNumber', 0, 60) &&
          payeClaimDayKey(request.resource.data.get('date', null)) &&
          request.resource.data.items is list && request.resource.data.items.size() >= 1 && request.resource.data.items.size() <= 100 &&
          writeMetadataValidWhenPresent();
        allow delete: if payeClaimOwnerWriter(resource.data.get('ownerUserId', ''));
      }

      match /bookings/{bookingId} {
        allow read: if bookingReadAllowed('bookings');
        allow create: if !bookingTombstoned(bookingId) && bookingWriteAllowed('bookings', 'create');
        allow update: if !bookingTombstoned(bookingId) &&
          (overtimeLineManagerBookingUpdate('bookings') || bookingWriteAllowed('bookings', 'update'));
        allow delete: if operativesManagerRemovesOrphanBooking(resource.data) || bookingWriteAllowed('bookings', 'delete');
      }

      match /qualifications/{qualificationId} {
        allow read: if canAccessOrganization(organizationId);
        allow write: if isOrgManagerOrAdmin(organizationId) || isPlatformOwner();
      }

      match /skills/{skillId} {
        allow read: if canAccessOrganization(organizationId);
        allow write: if isOrgManagerOrAdmin(organizationId) || isPlatformOwner();
      }

      match /settings/{settingId} {
        function isVariationSettingsDoc() {
          return settingId.matches('^variations_.*') || settingId.matches('^variationItem_.*');
        }
        function isTimesheetSettingsDoc() {
          return settingId.matches('^timesheet_.*');
        }
        function isOwnTimesheetSettings() {
          return request.auth != null && (
            (resource != null && 'userId' in resource.data && resource.data.userId == request.auth.uid) ||
            (request.method == 'create' &&
             'userId' in request.resource.data &&
             request.resource.data.userId == request.auth.uid) ||
            settingId.matches('^timesheet_' + request.auth.uid + '_.*')
          );
        }
        function timesheetSubjectUid() {
          return resource != null && resource.data.get('userId', null) is string
            ? resource.data.userId
            : request.resource.data.get('userId', null);
        }
        function timesheetIdIsCallers(id) {
          return id == request.auth.uid || timesheetIdIsCallerAlias(id);
        }
        function timesheetIdIsCallerAlias(id) {
          let home = callerHomeData();
          return (home.get('formerUserIds', []) is list && id in home.get('formerUserIds', [])) ||
            (home.get('sameEmailUserIds', []) is list && id in home.get('sameEmailUserIds', []));
        }
        function timesheetSubjectIsCaller() {
          return timesheetSubjectUid() is string && timesheetIdIsCallers(timesheetSubjectUid());
        }
        function timesheetCallerIsSubject() {
          return isOwnTimesheetSettings() || timesheetSubjectIsCaller();
        }
        function timesheetOwnerKeepsSubject() {
          let next = request.resource.data.get('userId', null);
          return (next == null || timesheetIdIsCallers(next)) && (
            resource == null ||
            next == resource.data.get('userId', null) ||
            (resource.data.get('userId', null) == null && next == request.auth.uid)
          );
        }
        function timesheetSelfSignedOwnerWrite() {
          let uid = timesheetSubjectUid();
          return uid is string && settingId.matches('^timesheet_' + uid + '_.*') && timesheetSelfSignsUid(uid);
        }
        function isTimesheetReviewer() {
          return isPlatformOwner() || (!timesheetCallerIsSubject() && timesheetReviewerOfOthers());
        }
        function timesheetReviewerOfOthers() {
          return (
            isOrganizationAdmin(organizationId) ||
            isOrgAdminViaMembersMap(organizationId) || (
              !callerHomeIsOperative() &&
              timesheetSubjectUid() is string &&
              exists(/databases/(default)/documents/users/$(timesheetSubjectUid())) &&
              lineManagerIdList(get(/databases/(default)/documents/users/$(timesheetSubjectUid())).data).hasAny(
                [request.auth.uid].concat(
                  callerHomeData().get('formerUserIds', []) is list && homeOrgIs(callerHomeData(), organizationId)
                    ? callerHomeData().get('formerUserIds', [])
                    : []
                )
              )
            )
          );
        }
        function timesheetSame(key) {
          return sameLooseValue(
            request.resource.data.get(key, null),
            resource == null ? null : resource.data.get(key, null)
          );
        }
        function timesheetSameInstant(key) {
          return sameInstantValue(
            request.resource.data.get(key, null),
            resource == null ? null : resource.data.get(key, null)
          );
        }
        function timesheetManagerFieldsUnchanged() {
          return timesheetSameInstant('managerSignedAt') &&
            timesheetSame('managerSignedByName') &&
            timesheetSame('managerSignedByUserId') &&
            timesheetSame('managerSignatureImageBase64') &&
            timesheetSameInstant('approvedAt') &&
            timesheetSame('approvedByName') &&
            timesheetSameInstant('exportedAt');
        }
        function timesheetEmptyish(value) {
          return value == null || value == {};
        }
        function timesheetOwnerLeaves(key, written) {
          return !(key in written) || (
            timesheetEmptyish(request.resource.data.get(key, null)) &&
            timesheetEmptyish(resource == null ? null : resource.data.get(key, null))
          );
        }
        function timesheetOwnerLeavesList(key, written) {
          return !(key in written) || (
            (request.resource.data.get(key, null) == null || request.resource.data.get(key, null) == []) &&
            (resource == null || resource.data.get(key, null) == null || resource.data.get(key, null) == [])
          );
        }
        function timesheetSelfSignsUid(uid) {
          return orgCreatorIs(organizationId, uid) || orgSelfManageFlag(uid, organizationId, 'timesheetSelfSign', true);
        }
        function timesheetStoredManagerSigned() {
          return resource != null && (
            resource.data.get('managerSignedAt', null) is timestamp ||
            resource.data.get('managerSignedAt', null) is number ||
            resource.data.get('approvedAt', null) is timestamp ||
            resource.data.get('approvedAt', null) is number
          );
        }
        function timesheetOwnerReviewFieldsUnchanged() {
          let written = writtenKeys();
          return timesheetOwnerLeaves('payrollLineReviews', written) &&
            timesheetOwnerLeaves('extraEntryReviews', written) &&
            timesheetOwnerLeaves('weeklyReportOverride', written) &&
            (!timesheetStoredManagerSigned() || (
              timesheetOwnerLeavesList('expenseEntries', written) &&
              timesheetOwnerLeavesList('priceWorkEntries', written)
            ));
        }
        function canWriteTimesheetSettings() {
          return isPlatformOwner() || (timesheetCallerIsSubject() ? (
            timesheetOwnerKeepsSubject() && (
              (timesheetManagerFieldsUnchanged() && timesheetOwnerReviewFieldsUnchanged()) ||
              timesheetSelfSignedOwnerWrite()
            )
          ) : timesheetReviewerOfOthers());
        }
        function canDeleteTimesheetSettings() {
          return isPlatformOwner() || (timesheetCallerIsSubject() ? (
            (resource.data.get('userId', null) == null || timesheetSubjectIsCaller()) &&
            resource.data.get('managerSignedAt', null) == null &&
            resource.data.get('exportedAt', null) == null &&
            timesheetEmptyish(resource.data.get('payrollLineReviews', null)) &&
            timesheetEmptyish(resource.data.get('extraEntryReviews', null))
          ) : timesheetReviewerOfOthers());
        }
        function isMemberWritableSettingsDoc() {
          return settingId.matches('^deadlines_.*') ||
            settingId == 'deadlineAssignments' ||
            settingId.matches('^healthSafety_.*');
        }
        function canReadTimesheetSettings() {
          return !privatePayOn(organizationId) || isOwnTimesheetSettings() ||
            isOrgAdminViaMembersMap(organizationId) || isOrganizationAdmin(organizationId) || isPlatformOwner() ||
            (timesheetSubjectUid() is string && canViewPayOfAsMember(timesheetSubjectUid())) ||
            isTimesheetReviewer();
        }
        allow read: if canAccessOrganization(organizationId) &&
          (!isVariationSettingsDoc() || canAccessVariationsStaff(organizationId)) &&
          (!isTimesheetSettingsDoc() || canReadTimesheetSettings());
        allow create, update: if canAccessOrganization(organizationId) && (
          isTimesheetSettingsDoc()
            ? canWriteTimesheetSettings()
            : (isMemberWritableSettingsDoc() || canAccessVariationsStaff(organizationId))
        );
        allow delete: if canAccessOrganization(organizationId) && (
          isTimesheetSettingsDoc()
            ? canDeleteTimesheetSettings()
            : (isMemberWritableSettingsDoc() || canAccessVariationsStaff(organizationId))
        );
      }

      match /tasks/{taskId} {
        allow read: if canAccessOrganization(organizationId);
        allow create, update: if canAccessOrganization(organizationId);
        allow delete: if isOrganizationAdmin(organizationId);
      }

      match /managers/{managerId} {
        allow read: if canAccessOrganization(organizationId);
        allow create, update: if canAccessOrganization(organizationId) &&
          (resource != null || isOrgManagerOrAdmin(organizationId) || isPlatformOwner()) &&
          (!rosterRowPayKeysChanged() || rosterRowAdmin()) &&
          (!rosterRowEmailChanged() || rosterRowAdmin()) &&
          payStaysPrivate(organizationId) &&
          writeMetadataValidWhenPresent();
        allow delete: if isOrganizationAdmin(organizationId);
      }

      match /notifications/{notificationId} {
        function isOwnNotification() {
          return resource != null &&
            'userId' in resource.data &&
            resource.data.userId == request.auth.uid;
        }
        function actorUserIdValid() {
          return !('actorUserId' in request.resource.data) ||
            request.resource.data.actorUserId == request.auth.uid;
        }
        function notificationRecipientIsMember() {
          let uid = request.resource.data.get('userId', '');
          let org = get(/databases/(default)/documents/organizations/$(organizationId)).data;
          return uid is string && uid.size() > 0 && !uid.matches('.*/.*') && (
            org.get('members', {}).get(uid, null) != null ||
            org.get('creatorUserId', '') == uid ||
            (exists(/databases/(default)/documents/users/$(uid)) &&
             homeOrgIs(get(/databases/(default)/documents/users/$(uid)).data, organizationId)) ||
            exists(/databases/(default)/documents/users/$(uid)/orgMemberships/$(organizationId))
          );
        }
        allow read: if canAccessOrganization(organizationId) &&
          (isOwnNotification() || isOrgAdminOrOwner(organizationId));
        allow create: if canAccessOrganization(organizationId) && actorUserIdValid() && notificationRecipientIsMember();
        allow update: if canAccessOrganization(organizationId) &&
          (isOwnNotification() || isOrgAdminOrOwner(organizationId)) &&
          ((!('actorUserId' in request.resource.data.diff(resource.data).affectedKeys())) || actorUserIdValid());
        allow delete: if isOrgAdminOrOwner(organizationId);
      }

      match /materials/{materialId} {
        allow read: if canAccessOrganization(organizationId);
        allow create: if isOrgManagerOrAdmin(organizationId) || canCreateOwnMaterial(organizationId);
        allow update: if materialUpdateAllowed();
        function materialUpdateAllowed() {
          let affected = request.resource.data.diff(resource.data).affectedKeys();
          let mine = request.auth != null && resource.data.get('addedByUserId', null) == request.auth.uid;
          let claim = request.auth != null && affected.hasOnly(['addedByUserId']) &&
            request.resource.data.get('addedByUserId', null) == request.auth.uid;
          return (affected.hasOnly(['status', 'lastSentAt', 'lastSentRequestType', 'updatedAt', 'updatedBy', 'updatedFrom'])
              ? isStaffMaterialStatusWrite(organizationId) : false) ||
            (mine ? canUpdateOwnMaterial(organizationId) : false) ||
            (claim ? isOnlyClaimingLegacyOwnMaterial(organizationId) : false) ||
            isOrgManagerOrAdmin(organizationId);
        }
        allow delete: if isOrgManagerOrAdmin(organizationId) || canDeleteOwnMaterial(organizationId);
      }

      match /materialCatalogue/{catalogueItemId} {
        allow read: if canAccessOrganization(organizationId);
        allow create, update, delete: if isOrgManagerOrAdmin(organizationId);
      }

      match /materialSendRecords/{recordId} {
        allow read: if belongsToOrganization(organizationId) &&
          exists(/databases/(default)/documents/users/$(request.auth.uid)) &&
          isOrgManagerOrAdmin(organizationId);
        allow create: if canWriteMaterialSendRecord(organizationId);
        allow update, delete: if isOrganizationAdmin(organizationId);
      }

      match /wholesalers/{wholesalerId} {
        allow read: if canAccessOrganization(organizationId);
        allow create, update, delete: if isOrgManagerOrAdmin(organizationId);
      }

      match /managerSiteBookings/{bookingId} {
        allow read: if bookingReadAllowed('managerSiteBookings');
        allow create: if !bookingTombstoned(bookingId) && bookingWriteAllowed('managerSiteBookings', 'create');
        allow update: if !bookingTombstoned(bookingId) &&
          (overtimeLineManagerBookingUpdate('managerSiteBookings') || bookingWriteAllowed('managerSiteBookings', 'update'));
        allow delete: if bookingWriteAllowed('managerSiteBookings', 'delete');
      }

      match /subcontractors/{subcontractorId} {
        allow read: if canAccessOrganization(organizationId);
        allow create, update: if canAccessOrganization(organizationId);
        allow delete: if isOrganizationAdmin(organizationId);
      }

      match /subcontractorBookings/{bookingId} {
        allow read: if bookingReadAllowed('subcontractorBookings');
        allow create: if !bookingTombstoned(bookingId) && bookingWriteAllowed('subcontractorBookings', 'create');
        allow update: if !bookingTombstoned(bookingId) && bookingWriteAllowed('subcontractorBookings', 'update');
        allow delete: if bookingWriteAllowed('subcontractorBookings', 'delete');
      }

      match /holidayBookings/{bookingId} {
        function hbCaller() {
          return get(/databases/(default)/documents/users/$(request.auth.uid)).data;
        }
        function hbCallerIsOperative() {
          return exists(/databases/(default)/documents/users/$(request.auth.uid)) &&
            isOperativeProfile(hbCaller()) && !adminLikeUser(hbCaller());
        }
        function hbIsAdmin() {
          return isOrgAdminViaMembersMapAnyBilling(organizationId) ||
            isOrganizationAdminAnyBilling(organizationId) ||
            isPlatformOwner();
        }
        function hbIsStaffManager() {
          return callerOrgRoleAnyBilling(organizationId) in ['admin', 'manager'] || hbIsAdmin();
        }
        function hbRequesterUid(data) {
          return data.get('userId', null);
        }
        function hbRequesterExists(data) {
          return hbRequesterUid(data) is string &&
            hbRequesterUid(data).size() > 0 &&
            exists(/databases/(default)/documents/users/$(hbRequesterUid(data)));
        }
        function hbRequester(data) {
          return get(/databases/(default)/documents/users/$(hbRequesterUid(data))).data;
        }
        function hbIsOwner(data) {
          return hbRequesterUid(data) == request.auth.uid ||
            data.get('operativeId', null) == request.auth.uid;
        }
        function hbCanDecide(data) {
          return !hbIsOwner(data) && (
            (hbRequesterExists(data) && request.auth.uid in lineManagerIdList(hbRequester(data)) && !hbCallerIsOperative()) ||
            (!hbCallerIsOperative() && hbIsAdmin())
          );
        }
        function hbCanDecideBeforeAndAfter() {
          return !hbIsOwner(resource.data) && !hbIsOwner(request.resource.data) && (
            (hbRequesterExists(resource.data) && request.auth.uid in lineManagerIdList(hbRequester(resource.data)) &&
             hbRequesterExists(request.resource.data) && request.auth.uid in lineManagerIdList(hbRequester(request.resource.data)) &&
             !hbCallerIsOperative()) ||
            (!hbCallerIsOperative() && hbIsAdmin())
          );
        }
        function hbCallerSelfBooks() {
          return orgCreatorIs(organizationId, request.auth.uid) ||
            orgSelfManageFlag(request.auth.uid, organizationId, 'annualLeaveSelfBook', false);
        }
        function hbIsRequestShape(next) {
          return next.get('status', null) == 'pending' &&
            next.get('approvedByUserId', null) == null &&
            next.get('approvedAt', null) == null &&
            next.get('decisionNote', null) == null;
        }
        function hbOwnerShapeAllowed(next) {
          return hbIsRequestShape(next) || (
            next.get('status', null) == 'approved' &&
            next.get('approvedByUserId', null) in [null, request.auth.uid] &&
            next.get('decisionNote', null) == null &&
            hbCallerSelfBooks()
          );
        }
        function hbKeySame(changed, key) {
          return !(key in changed) ||
            sameLooseValue(request.resource.data.get(key, null), resource.data.get(key, null));
        }
        function hbKeySameInstant(changed, key) {
          return !(key in changed) ||
            sameInstantValue(request.resource.data.get(key, null), resource.data.get(key, null));
        }
        function hbDecisionUnchanged(changed) {
          return !changed.hasAny(['status', 'approvedByUserId', 'approvedAt', 'decisionNote']) || (
            hbKeySame(changed, 'status') && hbKeySame(changed, 'approvedByUserId') &&
            hbKeySameInstant(changed, 'approvedAt') && hbKeySame(changed, 'decisionNote')
          );
        }
        function hbDatesUnchanged(changed) {
          return !changed.hasAny(['startDate', 'endDate', 'timeSlot']) || (
            hbKeySameInstant(changed, 'startDate') && hbKeySameInstant(changed, 'endDate') &&
            !('timeSlot' in changed)
          );
        }
        function hbOwnerEditAllowed(changed) {
          return hbKeySame(changed, 'userId') && hbKeySame(changed, 'operativeId') && (
            (hbDecisionUnchanged(changed) && hbDatesUnchanged(changed)) ||
            ((resource.data.get('status', null) == 'pending' || hbCallerSelfBooks()) &&
              (hbDecisionUnchanged(changed) || hbOwnerShapeAllowed(request.resource.data)))
          );
        }
        function hbOwnerUpdateAllowed() {
          return hbIsOwner(resource.data) &&
            hbOwnerEditAllowed(request.resource.data.diff(resource.data).affectedKeys());
        }

        allow read: if canAccessOrganization(organizationId);
        allow create: if canAccessOrganization(organizationId) && (
          (hbIsOwner(request.resource.data) && hbOwnerShapeAllowed(request.resource.data)) ||
          hbCanDecide(request.resource.data) ||
          (hbIsRequestShape(request.resource.data) && hbIsStaffManager())
        );
        allow update: if canAccessOrganization(organizationId) && (
          hbOwnerUpdateAllowed() ||
          hbCanDecideBeforeAndAfter()
        );
        allow delete: if canAccessOrganization(organizationId) && (
          (hbIsOwner(resource.data) && (
            resource.data.get('status', null) in ['pending', 'rejected'] ||
            hbCallerSelfBooks()
          )) ||
          hbCanDecide(resource.data)
        );
      }

      function managerMayChangePayOf(subjectUserId) {
        return subjectUserId is string && subjectUserId.size() > 0 &&
          subjectUserId != request.auth.uid &&
          exists(/databases/(default)/documents/users/$(subjectUserId)) &&
          get(/databases/(default)/documents/users/$(subjectUserId)).data.get('organizationId', null) is string &&
          orgIdsMatch(get(/databases/(default)/documents/users/$(subjectUserId)).data.organizationId, organizationId) &&
          managerMayManageOperative(subjectUserId, get(/databases/(default)/documents/users/$(subjectUserId)).data);
      }
      function canChangePayOf(subjectUserId) {
        return isOrgAdminViaMembersMap(organizationId) ||
          managerMayChangePayOf(subjectUserId) ||
          isPlatformOwner() ||
          isOrganizationAdmin(organizationId);
      }

      function payUserPath(subjectId) {
        return /databases/(default)/documents/users/$(subjectId);
      }
      function payOperativeRowPath(subjectId) {
        return /databases/(default)/documents/organizations/$(organizationId)/operatives/$(subjectId);
      }
      function canViewPayOfUser(subjectId, subject) {
        return request.auth.uid == subjectId ||
          (request.auth.token.email is string && subject.get('email', '') is string &&
           subject.get('email', '').lower() == request.auth.token.email.lower()) ||
          (lineManagerIdList(subject).hasAny([request.auth.uid]) && !callerHomeIsOperative()) ||
          managerMayManageOperative(subjectId, subject);
      }
      function payRowLinkText(row, key) {
        return row.get(key, '') is string ? row.get(key, '') : '';
      }
      function payOperativeRowIsCatalogue(subjectId) {
        let row = get(payOperativeRowPath(subjectId)).data;
        let email = payRowLinkText(row, 'email').lower();
        return payRowLinkText(row, 'linkedUserId') == '' && payRowLinkText(row, 'userId') == '' &&
          payRowLinkText(row, 'uid') == '' &&
          (email == '' ||
           !exists(/databases/(default)/documents/organizations/$(organizationId)/userEmails/$(email)));
      }
      function canViewPayOfRow(subjectId) {
        return (
          request.auth.token.email is string &&
          string(get(payOperativeRowPath(subjectId)).data.get('email', '')).lower() == request.auth.token.email.lower()
        ) || (
          isManagerWithOperativesAccess() && userOrgIdMatchesPath(organizationId) && payOperativeRowIsCatalogue(subjectId)
        );
      }
      function canViewPayOf(subjectId) {
        return isPlatformOwner() || (
          canAccessOrganization(organizationId) && (
            isOrgAdminViaMembersMap(organizationId) ||
            isOrganizationAdmin(organizationId) ||
            canViewPayOfAsMember(subjectId)
          )
        );
      }
      function canViewPayOfAsMember(subjectId) {
        return subjectId is string && subjectId.size() > 0 && (
          (exists(payUserPath(subjectId)) && canViewPayOfUser(subjectId, get(payUserPath(subjectId)).data)) ||
          (!exists(payUserPath(subjectId)) && exists(payOperativeRowPath(subjectId)) && canViewPayOfRow(subjectId))
        );
      }
      function canChangePayOfSubject(subjectId) {
        return exists(payUserPath(subjectId))
          ? canChangePayOf(subjectId)
          : (isOrgAdminViaMembersMap(organizationId) || isOrganizationAdmin(organizationId) || isPlatformOwner() || (
              exists(payOperativeRowPath(subjectId)) &&
              isManagerWithOperativesAccess() && userOrgIdMatchesPath(organizationId) &&
              !(request.auth.token.email is string &&
                string(get(payOperativeRowPath(subjectId)).data.get('email', '')).lower() == request.auth.token.email.lower())
            ));
      }
      match /payProfiles/{subjectId} {
        function payProfileKeysValid() {
          return request.resource.data.keys().hasOnly([
            'userId', 'payBasis', 'dayRate', 'hourlyRate', 'employmentType', 'employmentTypeTransitionFrom',
            'employmentTypeEffectiveAt', 'updatedAt', 'updatedBy', 'updatedFrom'
          ]);
        }
        allow get: if request.auth != null && canViewPayOf(subjectId);
        allow list: if request.auth != null && (
          isPlatformOwner() ||
          (canAccessOrganization(organizationId) &&
           (isOrgAdminViaMembersMap(organizationId) || isOrganizationAdmin(organizationId)))
        );
        function invitedPayCopyFields() {
          return ['payBasis', 'dayRate', 'hourlyRate', 'employmentType', 'employmentTypeTransitionFrom', 'employmentTypeEffectiveAt'];
        }
        function copiesInvitedPay(placeholderId) {
          let invited = get(/databases/(default)/documents/organizations/$(organizationId)/payProfiles/$(placeholderId)).data;
          let next = request.resource.data;
          return next.get('payBasis', null) == invited.get('payBasis', null) &&
            next.get('dayRate', null) == invited.get('dayRate', null) &&
            next.get('hourlyRate', null) == invited.get('hourlyRate', null) &&
            next.get('employmentType', null) == invited.get('employmentType', null) &&
            next.get('employmentTypeTransitionFrom', null) == invited.get('employmentTypeTransitionFrom', null) &&
            next.get('employmentTypeEffectiveAt', null) == invited.get('employmentTypeEffectiveAt', null) &&
            next.keys().hasAny(invitedPayCopyFields());
        }
        function inviteeCopiesOwnInvitedPay() {
          let emailKey = request.auth.token.email is string ? request.auth.token.email.lower() : '';
          let claimPath = /databases/(default)/documents/organizations/$(organizationId)/userEmails/$(emailKey);
          let placeholderId = emailKey != '' && exists(claimPath) ? get(claimPath).data.get('userId', '') : '';
          return subjectId == request.auth.uid &&
            emailKey != '' &&
            privatePayOn(organizationId) &&
            placeholderId is string && placeholderId != '' && placeholderId != request.auth.uid &&
            inviteClaimIsPendingPlaceholder(organizationId, emailKey) &&
            exists(/databases/(default)/documents/organizations/$(organizationId)/payProfiles/$(placeholderId)) &&
            copiesInvitedPay(placeholderId);
        }
        allow create: if request.auth != null &&
          request.resource.data.get('userId', subjectId) == subjectId &&
          payProfileKeysValid() &&
          writeMetadataValidWhenPresent() &&
          (inviteeCopiesOwnInvitedPay() || (canAccessOrganization(organizationId) && canChangePayOfSubject(subjectId)));
        allow update: if request.auth != null &&
          request.resource.data.get('userId', subjectId) == subjectId &&
          payProfileKeysValid() &&
          canAccessOrganization(organizationId) &&
          canChangePayOfSubject(subjectId) &&
          writeMetadataValidWhenPresent();
        allow delete: if isOrganizationAdmin(organizationId) || isPlatformOwner();
      }

      match /operativeProfiles/{userId} {
        function operativeProfileStampOnly() {
          return (resource == null
            ? request.resource.data.keys().toSet()
            : request.resource.data.diff(resource.data).affectedKeys()
          ).hasOnly(['userId', 'updatedAt', 'updatedBy', 'updatedFrom']);
        }
        allow read: if canAccessOrganization(organizationId) && (
          !privatePayOn(organizationId) || isOrgAdminViaMembersMap(organizationId) || isOrganizationAdmin(organizationId) ||
          canViewPayOfAsMember(userId)
        );
        allow create, update: if request.auth != null &&
          request.resource.data.get('userId', userId) == userId &&
          (operativeProfileStampOnly() ? canAccessOrganization(organizationId) : canChangePayOf(userId)) &&
          writeMetadataValidWhenPresent();
        allow delete: if request.auth != null &&
          (request.auth.uid == userId ? canAccessOrganization(organizationId) : canChangePayOf(userId));
      }

      match /operativeDayRateHistory/{entryId} {
        function rateRowUserId(data) {
          return data.get('userId', '') is string ? data.get('userId', '') : '';
        }
        function rateRowOperativeId(data) {
          return data.get('operativeId', '') is string ? data.get('operativeId', '') : '';
        }
        function rateRowOperativeIsCaller(operativeId) {
          return operativeId.size() > 0 && (
            !(request.auth.token.email is string) ||
            !exists(/databases/(default)/documents/organizations/$(organizationId)/operatives/$(operativeId)) ||
            get(/databases/(default)/documents/organizations/$(organizationId)/operatives/$(operativeId)).data.get('email', '') == null ||
            string(get(/databases/(default)/documents/organizations/$(organizationId)/operatives/$(operativeId)).data.get('email', '')).lower() ==
              request.auth.token.email.lower()
          );
        }
        function managerMayRecordOperativeRow(operativeId) {
          return operativeId.size() > 0 &&
            isManagerWithOperativesAccess() &&
            get(/databases/(default)/documents/users/$(request.auth.uid)).data.get('organizationId', null) is string &&
            orgIdsMatch(get(/databases/(default)/documents/users/$(request.auth.uid)).data.organizationId, organizationId) &&
            !rateRowOperativeIsCaller(operativeId);
        }
        function managerMayRecordRateRow(data) {
          return rateRowUserId(data).size() > 0
            ? (managerMayChangePayOf(rateRowUserId(data)) && !rateRowOperativeIsCaller(rateRowOperativeId(data)))
            : managerMayRecordOperativeRow(rateRowOperativeId(data));
        }
        function canWriteRateRow(data) {
          return isOrgAdminViaMembersMap(organizationId) ||
            managerMayRecordRateRow(data) ||
            isPlatformOwner() ||
            isOrganizationAdmin(organizationId);
        }
        function canViewRateRow(data) {
          return isOrgAdminViaMembersMap(organizationId) || isOrganizationAdmin(organizationId) || isPlatformOwner() ||
            canViewPayOfAsMember(rateRowUserId(data).size() > 0 ? rateRowUserId(data) : rateRowOperativeId(data));
        }
        allow read: if canAccessOrganization(organizationId) && (!privatePayOn(organizationId) || canViewRateRow(resource.data));
        allow create: if request.auth != null && canWriteRateRow(request.resource.data);
        allow update: if request.auth != null &&
          rateRowUserId(request.resource.data) == rateRowUserId(resource.data) &&
          rateRowOperativeId(request.resource.data) == rateRowOperativeId(resource.data) &&
          canWriteRateRow(request.resource.data);
        allow delete: if isOrganizationAdmin(organizationId);
      }

      match /siteAudits/{auditId} {
        allow read: if canAccessOrganization(organizationId);
        allow create, update: if canAccessOrganization(organizationId);
        allow delete: if isOrganizationAdmin(organizationId);
      }

      match /acceptedBookingClashes/{clashId} {
        allow read: if canAccessOrganization(organizationId);
        allow create, update: if canAccessVariationsStaff(organizationId) && writeMetadataValidWhenPresent();
        allow delete: if canAccessVariationsStaff(organizationId);
      }

      match /warningResolutions/{resolutionKey} {
        allow read: if canAccessOrganization(organizationId);
        allow create, update: if canAccessVariationsStaff(organizationId) &&
          request.resource.data.keys().hasOnly(['resolutionKey', 'status', 'resolvedByUserId', 'resolvedAt', 'updatedBy', 'updatedFrom', 'updatedAt']) &&
          writeMetadataValidWhenPresent() &&
          request.resource.data.keys().hasAll(['resolutionKey', 'status', 'resolvedByUserId', 'resolvedAt']) &&
          request.resource.data.resolutionKey == resolutionKey &&
          request.resource.data.status in ['approved', 'dismissed'] &&
          request.resource.data.resolvedByUserId == request.auth.uid &&
          request.resource.data.resolvedAt is timestamp;
        allow delete: if canAccessVariationsStaff(organizationId);
      }

      match /dismissedWarnings/{dismissKey} {
        allow read: if canAccessOrganization(organizationId);
        allow create, update: if canAccessVariationsStaff(organizationId) && writeMetadataValidWhenPresent();
        allow delete: if isOrganizationAdmin(organizationId);
      }

      match /fileReports/{reportId} {
        allow create: if canAccessOrganization(organizationId) &&
          request.resource.data.keys().toSet() == ['organizationId', 'storagePath', 'surface', 'parentId', 'fileName', 'reason', 'details', 'reportedByUserId', 'status', 'createdAt'].toSet() &&
          request.resource.data.organizationId == organizationId &&
          request.resource.data.reportedByUserId == request.auth.uid &&
          request.resource.data.status == 'open' &&
          request.resource.data.createdAt == request.time &&
          request.resource.data.reason in ['copyright', 'personal_data', 'offensive', 'wrong_file', 'other'] &&
          request.resource.data.surface in ['site_audit', 'task_attachment', 'health_safety', 'deadline', 'variation_evidence', 'qualification_certificate'] &&
          request.resource.data.storagePath is string &&
          request.resource.data.storagePath.size() <= 1024 &&
          request.resource.data.storagePath.matches('^organizations/' + organizationId + '/.+') &&
          !request.resource.data.storagePath.matches('.*[.][.].*') &&
          request.resource.data.parentId is string &&
          request.resource.data.parentId.size() > 0 &&
          request.resource.data.parentId.size() <= 200 &&
          request.resource.data.fileName is string &&
          request.resource.data.fileName.size() <= 200 &&
          request.resource.data.details is string &&
          request.resource.data.details.size() <= 1000;
        allow read: if isOrganizationAdmin(organizationId) || isPlatformOwner();
        allow update: if (isOrganizationAdmin(organizationId) || isPlatformOwner()) &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'reviewedByUserId', 'reviewedAt']) &&
          request.resource.data.status in ['reviewed', 'removed'] &&
          request.resource.data.reviewedByUserId == request.auth.uid &&
          request.resource.data.reviewedAt == request.time;
      }

      match /dashboardLayouts/{layoutUserId} {
        allow read: if canAccessOrganization(organizationId);
        allow create, update, delete: if canAccessOrganization(organizationId) &&
          (request.auth.uid == layoutUserId || isOrganizationAdmin(organizationId));
      }

      match /variations/{variationId} {
        allow read: if resource.data.parentId is string &&
          canAccessVariationsStaff(organizationId);
        allow create: if request.resource.data.parentId is string &&
          request.resource.data.isDeleted == false &&
          canAccessVariationsStaff(organizationId);
        allow update: if resource.data.parentId is string &&
          request.resource.data.parentId == resource.data.parentId &&
          canAccessVariationsStaff(organizationId);
      }

      match /variationTrackers/{parentId} {
        allow read: if canAccessVariationsStaff(organizationId);
        allow create, update: if isOrgAdminOrOwner(organizationId);
      }

      match /{collection}/{document=**} {
        allow read: if canAccessOrganization(organizationId) &&
          collection != 'variations' &&
          collection != 'variationTrackers' &&
          collection != 'notifications' &&
          collection != 'materialSendRecords' &&
          collection != 'fileReports' &&
          !(collection in ['projects', 'smallWorks', 'bookings', 'managerSiteBookings', 'subcontractorBookings']) &&
          !(collection in ['payProfiles', 'operativeDayRateHistory', 'operativeProfiles', 'settings']) &&
          !(collection in ['overtimeRequests', 'overtimeReviews', 'overtimeReports']) &&
          !(collection in ['priceWorkItems', 'expenseItems', 'payeClaimReports', 'personalSiteAudits']);
      }
    }

    match /productFeedback/{suggestionId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null &&
        request.resource.data.authorUserId == request.auth.uid &&
        (!('hidden' in request.resource.data) || request.resource.data.hidden != true);
      allow update: if isPlatformOwner() || (
        request.auth != null &&
        resource.data.authorUserId == request.auth.uid &&
        request.resource.data.diff(resource.data).changedKeys().hasOnly(['title', 'details', 'category', 'updatedAt', 'voteCount', 'commentCount'])
      ) || (
        request.auth != null &&
        request.resource.data.diff(resource.data).changedKeys().hasOnly(['voteCount', 'commentCount', 'updatedAt'])
      );
      allow delete: if isPlatformOwner();

      match /private/{docId} {
        allow read: if isPlatformOwner();
        allow write: if isPlatformOwner();
      }
    }

    match /productFeedbackVotes/{voteId} {
      allow read: if isPlatformOwner() ||
        (request.auth != null && resource.data.userId == request.auth.uid);
      allow create: if request.auth != null &&
        request.resource.data.userId == request.auth.uid &&
        voteId == request.resource.data.suggestionId + '_' + request.auth.uid;
      allow delete: if request.auth != null && resource.data.userId == request.auth.uid;
    }

    match /productFeedbackFollows/{followId} {
      allow read: if isPlatformOwner() ||
        (request.auth != null && resource.data.userId == request.auth.uid);
      allow create: if request.auth != null &&
        request.resource.data.userId == request.auth.uid &&
        followId == request.resource.data.suggestionId + '_' + request.auth.uid;
      allow delete: if request.auth != null && resource.data.userId == request.auth.uid;
    }

    match /productFeedbackComments/{commentId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.resource.data.authorUserId == request.auth.uid;
      allow update: if isPlatformOwner() || (
        request.auth != null && resource.data.authorUserId == request.auth.uid
      );
      allow delete: if isPlatformOwner() || (
        request.auth != null && resource.data.authorUserId == request.auth.uid
      );
    }

    match /productFeedbackHistory/{historyId} {
      allow read: if isPlatformOwner();
      allow write: if isPlatformOwner();
    }

    match /productEvents/{eventId} {
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
      allow read: if isPlatformOwner();
    }

    match /productSessions/{sessionId} {
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
      allow update: if request.auth != null && resource.data.userId == request.auth.uid;
      allow read: if isPlatformOwner() || (request.auth != null && resource.data.userId == request.auth.uid);
    }

    match /adminAuditLog/{id} {
      allow read: if isPlatformOwner();
      allow create: if isPlatformOwner();
    }

    match /supportRequests/{id} {
      allow read: if isPlatformOwner() ||
        (request.auth != null && resource.data.requestedByUid == request.auth.uid);
      allow create: if request.auth != null &&
        request.resource.data.requestedByUid == request.auth.uid &&
        request.resource.data.status == 'open';
      allow update: if isPlatformOwner();
    }

    match /publicStats/{id} {
      allow read: if true;
    }

    match /analyticsDaily/{id} {
      allow read: if isPlatformOwner();
    }

    match /analyticsMonthly/{id} {
      allow read: if isPlatformOwner();
    }

    match /analyticsTotals/{id} {
      allow read: if isPlatformOwner();
    }

    match /ownerAlerts/{id} {
      allow read: if isPlatformOwner();
    }

    match /adminJobs/{id} {
      allow read: if isPlatformOwner();
    }

    match /deletedOrganisations/{id} {
      allow read: if isPlatformOwner();
    }

    match /platformConfig/{id} {
      allow read: if id == 'app' || request.auth != null;
      allow write: if isPlatformOwner();
    }

    match /interestRegistrations/{id} {
      allow read, update, delete: if isPlatformOwner();
    }
  }
}
