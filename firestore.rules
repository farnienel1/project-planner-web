rules_version = '2';
service cloud.firestore {
  function orgIdsMatch(a, b) {
    return a is string && b is string && (
      a.lower() == b.lower() ||
      a.lower().matches('^\\s*' + b.lower() + '\\s*$')
    );
  }

  function truthyBool(v) {
    return v == true || v == 1;
  }

  function adminLikeUser(userData) {
    return ('isSuperAdmin' in userData && truthyBool(userData.isSuperAdmin)) ||
           ('adminAccess' in userData && truthyBool(userData.adminAccess)) ||
           ('permissions' in userData && userData.permissions is map &&
             ('adminAccess' in userData.permissions && truthyBool(userData.permissions.adminAccess))) ||
           ('role' in userData && userData.role == 'admin');
  }

  function materialManagerLikeUser(userData) {
    return adminLikeUser(userData) ||
           ('manager' in userData && truthyBool(userData.manager)) ||
           ('permissions' in userData && userData.permissions is map &&
             ('manager' in userData.permissions && truthyBool(userData.permissions.manager))) ||
           ('role' in userData && userData.role == 'manager');
  }

  function callerHomeIsOperative() {
    let home = callerHomeData();
    return isOperativeProfile(home) && !adminLikeUser(home);
  }

  function userDocOrganizationMatches(userData, organizationId) {
    return 'organizationId' in userData && (
      (userData.organizationId is string &&
       orgIdsMatch(userData.organizationId, organizationId)) ||
      (userData.organizationId is string &&
       string(userData.organizationId).lower().matches('(^|.*/)organizations/' + organizationId.lower() + '$')) ||
      (userData.organizationId is path &&
       orgIdsMatch(userData.organizationId[4], organizationId)) ||
      userData.organizationId == /databases/(default)/documents/organizations/$(organizationId) ||
      (userData.organizationId is path &&
       string(userData.organizationId).lower().matches('.*/organizations/' + organizationId.lower() + '$'))
    );
  }

  function userOrgIdMatchesPath(organizationId) {
    return request.auth != null &&
           exists(/databases/(default)/documents/users/$(request.auth.uid)) &&
           userDocOrganizationMatches(
             get(/databases/(default)/documents/users/$(request.auth.uid)).data,
             organizationId
           );
  }

  function isOrgMemberViaParentGet(organizationId) {
    return request.auth != null &&
           exists(/databases/(default)/documents/organizations/$(organizationId)) &&
           'members' in get(/databases/(default)/documents/organizations/$(organizationId)).data &&
           get(/databases/(default)/documents/organizations/$(organizationId)).data.members[request.auth.uid] != null;
  }

  function isOrgCreatorViaParentGet(organizationId) {
    return request.auth != null &&
           exists(/databases/(default)/documents/organizations/$(organizationId)) &&
           'creatorUserId' in get(/databases/(default)/documents/organizations/$(organizationId)).data &&
           get(/databases/(default)/documents/organizations/$(organizationId)).data.creatorUserId == request.auth.uid;
  }

  function isOrgBootstrapAdminProfileCreate(userId) {
    return request.auth != null &&
           request.auth.uid == userId &&
           'organizationId' in request.resource.data &&
           organizationExists(request.resource.data.organizationId) &&
           exists(/databases/(default)/documents/organizations/$(request.resource.data.organizationId)) &&
           'members' in get(/databases/(default)/documents/organizations/$(request.resource.data.organizationId)).data &&
           get(/databases/(default)/documents/organizations/$(request.resource.data.organizationId)).data.members[request.auth.uid] == 'admin';
  }

  function selfCreateHasAgeConfirmation() {
    return request.resource.data.ageConfirmed == true &&
           request.resource.data.ageConfirmedYears is number &&
           request.resource.data.ageConfirmedAt is timestamp;
  }

  function inviteClaimIsPendingPlaceholder(organizationId, emailKey) {
    let claimPath = /databases/(default)/documents/organizations/$(organizationId)/userEmails/$(emailKey);
    let claimed = exists(claimPath) ? get(claimPath).data.get('userId', '') : '';
    return claimed is string && claimed != '' && !claimed.matches('.*/.*') &&
      pendingPlaceholderFor(claimed, organizationId, emailKey);
  }
  function pendingPlaceholderFor(placeholderId, organizationId, emailKey) {
    let path = /databases/(default)/documents/users/$(placeholderId);
    let placeholder = exists(path) ? get(path).data : {};
    return exists(path) &&
           placeholder.get('passwordSet', false) != true &&
           placeholder.get('email', null) is string &&
           placeholder.email.lower() == emailKey &&
           'organizationId' in placeholder &&
           userDocOrganizationMatches(placeholder, organizationId);
  }

  function permissionValue(data, key) {
    return data.get('permissions', {}) is map ? data.get('permissions', {}).get(key, null) : null;
  }

  function staffFlag(data, key) {
    return data.get(key, null) == null ? truthyBool(permissionValue(data, key)) : truthyBool(data.get(key, false));
  }

  function privilegeFlag(d, key) {
    return truthyBool(d.get(key, false)) ||
      (d.get('permissions', {}) is map && truthyBool(d.get('permissions', {}).get(key, false)));
  }
  function noPrivilegeFlags(d) {
    let p = d.get('permissions', {}) is map ? d.get('permissions', {}) : {};
    let v = [d.get('isSuperAdmin', false), d.get('adminAccess', false), d.get('manager', false), d.get('operatives', false),
      d.get('annualLeaveSelfBook', false), d.get('timesheetSelfSign', false), p.get('isSuperAdmin', false),
      p.get('adminAccess', false), p.get('manager', false), p.get('operatives', false), p.get('annualLeaveSelfBook', false),
      p.get('timesheetSelfSign', false)];
    return !(d.get('role', '') in ['admin', 'manager']) && !(true in v) && !(1 in v);
  }

  function isOperativeProfile(data) {
    return staffFlag(data, 'operativeMode') || data.get('role', '') == 'operative';
  }

  function noMorePrivilegeThan(next, source) {
    return (!privilegeFlag(next, 'isSuperAdmin') || privilegeFlag(source, 'isSuperAdmin')) &&
           (!privilegeFlag(next, 'adminAccess') || privilegeFlag(source, 'adminAccess')) &&
           (!privilegeFlag(next, 'manager') || privilegeFlag(source, 'manager')) &&
           (!privilegeFlag(next, 'operatives') || privilegeFlag(source, 'operatives')) &&
           (!privilegeFlag(next, 'annualLeaveSelfBook') || privilegeFlag(source, 'annualLeaveSelfBook')) &&
           (!privilegeFlag(next, 'timesheetSelfSign') || privilegeFlag(source, 'timesheetSelfSign')) &&
           (!(next.get('role', '') in ['admin', 'manager']) || next.get('role', '') == source.get('role', '')) &&
           (!isOperativeProfile(source) || isOperativeProfile(next));
  }

  function selfCreateSelfManageOff(organizationId) {
    return (!privilegeFlag(request.resource.data, 'annualLeaveSelfBook') &&
            !privilegeFlag(request.resource.data, 'timesheetSelfSign')) ||
           orgCreatorIs(organizationId, request.auth.uid);
  }

  function raisesPrivileges(next) {
    return privilegeFlag(next, 'isSuperAdmin') ||
           privilegeFlag(next, 'adminAccess') ||
           privilegeFlag(next, 'manager') ||
           privilegeFlag(next, 'operatives') ||
           next.get('role', '') in ['admin', 'manager'];
  }

  function selfCreateJoinsCompany(organizationId, emailKey) {
    let claimPath = /databases/(default)/documents/organizations/$(organizationId)/userEmails/$(emailKey);
    return (
      inviteClaimIsPendingPlaceholder(organizationId, emailKey) ?
        selfCreateCopiesPlaceholder(get(claimPath).data.userId) : false
    ) || (
      (exists(claimPath) && get(claimPath).data.userId == request.auth.uid) ? (
        isOrgMemberViaParentGet(organizationId) ? (
          selfCreateKeepsManagedFields(callerListedRole(organizationId)) ? (
            selfCreateAliasesWithin(request.resource.data, {}, '') &&
            selfCreateSelfManageOff(organizationId) &&
            (
              !raisesPrivileges(request.resource.data) ||
              get(/databases/(default)/documents/organizations/$(organizationId)).data.members[request.auth.uid] == 'admin'
            )
          ) : false
        ) : false
      ) : false
    );
  }
  function selfCreateKeepsManagedFields(listed) {
    return listed == 'admin' || (
      !request.resource.data.keys().hasAny([
        'dayRate', 'hourlyRate', 'payBasis', 'employmentType', 'employmentTypeTransitionFrom', 'employmentTypeEffectiveAt',
        'hasNoLineManager', 'assignedManagerUserId', 'assignedManagerUserIds'
      ]) &&
      (listed != 'operative' || isOperativeProfile(request.resource.data))
    );
  }

  function selfCreateCopiesPlaceholder(placeholderId) {
    let placeholder = get(/databases/(default)/documents/users/$(placeholderId)).data;
    return noMorePrivilegeThan(request.resource.data, placeholder) &&
      selfCreateAliasesWithin(request.resource.data, placeholder, placeholderId);
  }

  function isAdminOfCompany(organizationId) {
    return organizationId is string &&
           (isOrgAdminViaMembersMap(organizationId) || isOrganizationAdmin(organizationId));
  }

  function isOwnEmailClaimWrite(organizationId, emailKey) {
    return request.resource.data.userId == request.auth.uid &&
           request.auth.token.email is string &&
           emailKey == request.auth.token.email.lower() &&
           (
             resource == null ||
             resource.data.userId == request.auth.uid ||
             inviteClaimIsPendingPlaceholder(organizationId, emailKey) ||
             !exists(/databases/(default)/documents/users/$(resource.data.userId))
           );
  }

  function enforcedReadsOn(organizationId) {
    let config = /databases/(default)/documents/platformConfig/app;
    let data = exists(config) ? get(config).data : {};
    return data.get('enforcedReads', false) == true ||
      (data.get('enforcedReadsOrganizationIds', []) is list && organizationId in data.get('enforcedReadsOrganizationIds', []));
  }

  function privatePayOn(organizationId) {
    let config = /databases/(default)/documents/platformConfig/app;
    let data = exists(config) ? get(config).data : {};
    return data.get('privatePay', false) == true ||
      (data.get('privatePayOrganizationIds', []) is list && organizationId in data.get('privatePayOrganizationIds', []));
  }
  function payValueWritten() {
    let next = request.resource.data;
    let prev = resource == null ? {} : resource.data;
    return (next.get('dayRate', null) != null && next.get('dayRate', null) != prev.get('dayRate', null)) ||
      (next.get('hourlyRate', null) != null && next.get('hourlyRate', null) != prev.get('hourlyRate', null)) ||
      (next.get('payBasis', null) != null && next.get('payBasis', null) != prev.get('payBasis', null)) ||
      (next.get('employmentType', null) != null && next.get('employmentType', null) != prev.get('employmentType', null)) ||
      (next.get('employmentTypeTransitionFrom', null) != null &&
        next.get('employmentTypeTransitionFrom', null) != prev.get('employmentTypeTransitionFrom', null)) ||
      (next.get('employmentTypeEffectiveAt', null) != null &&
        next.get('employmentTypeEffectiveAt', null) != prev.get('employmentTypeEffectiveAt', null));
  }
  function payStaysPrivate(organizationId) {
    return !privatePayOn(organizationId) || !payValueWritten();
  }

  function orgBillingOpen(organizationId) {
    let path = /databases/(default)/documents/organizations/$(organizationId);
    let org = exists(path) ? get(path).data : {};
    let b = org.get('billing', {});
    let d = org.get('deletion', {});
    return !(d is map && d.get('status', '') == 'scheduled') && (!(b is map) || (
      b.get('accessOpen', true) != false &&
      !(b.get('accessClosesAt', null) is timestamp && request.time >= b.get('accessClosesAt', null))
    ));
  }

  function callerHomeInactiveIn(organizationId) {
    let home = callerHomeData();
    return home.get('isActive', true) == false && homeOrgIs(home, organizationId);
  }
  function callerMembershipDeactivated(organizationId) {
    let membership = /databases/(default)/documents/users/$(request.auth.uid)/orgMemberships/$(organizationId);
    return exists(membership) &&
      get(membership).data.get('accountActive', get(membership).data.get('isActive', true)) == false;
  }

  function belongsToOrganization(organizationId) {
    return request.auth != null && orgBillingOpen(organizationId) && (
      userOrgIdMatchesPath(organizationId)
        ? callerHomeData().get('isActive', true) != false
        : ((isOrgMemberViaParentGet(organizationId) || isOrgCreatorViaParentGet(organizationId)) &&
           !callerMembershipDeactivated(organizationId))
    );
  }

  function canAccessOrganization(organizationId) {
    return isPlatformOwner() || belongsToOrganization(organizationId);
  }

  function billingUnchanged() {
    return (!('billing' in resource.data) && !('billing' in request.resource.data))
      || request.resource.data.billing == resource.data.billing;
  }

  function deletionUnchanged() {
    return (!('deletion' in resource.data) && !('deletion' in request.resource.data))
      || request.resource.data.get('deletion', null) == resource.data.get('deletion', null);
  }
  function orgScheduledForErasure() {
    return resource.data.get('deletion', {}) is map && resource.data.get('deletion', {}).get('status', '') == 'scheduled';
  }

  function resourceMaterialHasNonEmptyOwnerUid() {
    return resource != null &&
           'addedByUserId' in resource.data &&
           resource.data.addedByUserId is string &&
           resource.data.addedByUserId.size() > 0;
  }

  function legacyMaterialAddedByMatchesCurrentUser() {
    return request.auth != null &&
           exists(/databases/(default)/documents/users/$(request.auth.uid)) &&
           resource.data.addedBy is string &&
           addedByNamesUser(resource.data.addedBy.lower(), get(/databases/(default)/documents/users/$(request.auth.uid)).data);
  }
  function addedByNamesUser(addedBy, u) {
    return ('email' in u && u.email is string && addedBy == u.email.lower()) ||
           ('firstName' in u && 'surname' in u && u.firstName is string && u.surname is string &&
            addedBy == (u.firstName + ' ' + u.surname).lower()) ||
           ('firstName' in u && 'lastName' in u && u.firstName is string && u.lastName is string &&
            addedBy == (u.firstName + ' ' + u.lastName).lower());
  }

  function canClaimLegacyOwnMaterial(organizationId) {
    return (!resourceMaterialHasNonEmptyOwnerUid() &&
            request.resource.data.addedByUserId is string &&
            request.resource.data.addedByUserId.size() > 0 &&
            request.resource.data.addedByUserId == request.auth.uid) ? (
      legacyMaterialAddedByMatchesCurrentUser() ? (
        canAccessOrganization(organizationId) ? userOrgIdMatchesPath(organizationId) : false
      ) : false
    ) : false;
  }

  function isOnlyClaimingLegacyOwnMaterial(organizationId) {
    return canClaimLegacyOwnMaterial(organizationId) &&
           request.resource.data.diff(resource.data).affectedKeys().hasOnly(['addedByUserId']);
  }

  function canCreateOwnMaterial(organizationId) {
    return canAccessOrganization(organizationId) &&
           request.resource.data.addedByUserId is string &&
           request.resource.data.addedByUserId.size() > 0 &&
           request.resource.data.addedByUserId == request.auth.uid;
  }

  function canUpdateOwnMaterial(organizationId) {
    return (request.auth != null && (
               (resourceMaterialHasNonEmptyOwnerUid() && resource.data.addedByUserId == request.auth.uid) ||
               (
                 request.resource.data.addedByUserId is string &&
                 request.resource.data.addedByUserId.size() > 0 &&
                 request.resource.data.addedByUserId == request.auth.uid
               )
             ) &&
           (request.resource.data.addedByUserId == resource.data.addedByUserId)) ? canAccessOrganization(organizationId) : false;
  }

  function canDeleteOwnMaterial(organizationId) {
    return canAccessOrganization(organizationId) && (
      (resourceMaterialHasNonEmptyOwnerUid() && resource.data.addedByUserId == request.auth.uid) ||
      (!resourceMaterialHasNonEmptyOwnerUid() && legacyMaterialAddedByMatchesCurrentUser())
    );
  }

  function isOrganizationAdmin(organizationId) {
    return isOrganizationAdminAnyBilling(organizationId) && orgBillingOpen(organizationId);
  }
  function isOrganizationAdminAnyBilling(organizationId) {
    return request.auth != null &&
           exists(/databases/(default)/documents/users/$(request.auth.uid)) &&
           userOrgIdMatchesPath(organizationId) &&
           adminLikeUser(get(/databases/(default)/documents/users/$(request.auth.uid)).data) &&
           get(/databases/(default)/documents/users/$(request.auth.uid)).data.get('isActive', true) != false;
  }

  function callerListedRole(organizationId) {
    return exists(/databases/(default)/documents/organizations/$(organizationId)) ?
      get(/databases/(default)/documents/organizations/$(organizationId)).data.get('members', {}).get(request.auth.uid, '') : '';
  }
  function callerHomeData() {
    return exists(/databases/(default)/documents/users/$(request.auth.uid)) ?
      get(/databases/(default)/documents/users/$(request.auth.uid)).data : {};
  }
  function homeOrgIs(home, organizationId) {
    let v = home.get('organizationId', '');
    let org = organizationId.lower();
    return (v is string && (v.trim().lower() == org || v.lower().matches('(^|.*/)organizations/' + org + '$'))) ||
      (v is path && string(v).lower().matches('.*/organizations/' + org + '$'));
  }
  function callerOrgRole(organizationId) {
    return orgBillingOpen(organizationId) ? callerOrgRoleAnyBilling(organizationId) : '';
  }
  function callerOrgRoleAnyBilling(organizationId) {
    let listed = callerListedRole(organizationId);
    let home = callerHomeData();
    return homeOrgIs(home, organizationId) ? (
      home.get('isActive', true) == false ? '' : (
        (listed == 'admin' || adminLikeUser(home)) ? 'admin' : (
          isOperativeProfile(home) ? 'operative' : (materialManagerLikeUser(home) ? 'manager' : 'member')
        )
      )
    ) : ((listed != '' && callerMembershipDeactivated(organizationId)) ? '' : listed);
  }

  function invitationRole(inv) {
    let perms = inv.get('permissions', {});
    return inv.get('role', '') in ['admin', 'manager', 'operative', 'member'] ? inv.get('role', '') : (
      !(perms is map) || perms.size() == 0 ? 'member' : (
        perms.get('adminAccess', false) == true ? 'admin' : (perms.get('operativeMode', false) == true ? 'operative' : 'manager')
      )
    );
  }

  function invitationIsOperativeOnly(inv) {
    let perms = inv.get('permissions', {}) is map ? inv.get('permissions', {}) : {};
    return invitationRole(inv) == 'operative' &&
      (truthyBool(perms.get('operativeMode', false)) || inv.get('role', '') == 'operative') &&
      !truthyBool(perms.get('adminAccess', false)) && !truthyBool(perms.get('isSuperAdmin', false)) &&
      !truthyBool(perms.get('manager', false)) && !truthyBool(perms.get('operatives', false)) &&
      !truthyBool(inv.get('adminAccess', false)) && !truthyBool(inv.get('isSuperAdmin', false)) &&
      !truthyBool(inv.get('manager', false)) && !truthyBool(inv.get('operatives', false));
  }

  function inviteBeingAccepted(invId, organizationId) {
    let path = /databases/(default)/documents/invitations/$(invId);
    return invId is string && invId.size() > 0 && !invId.matches('.*/.*') && exists(path) &&
      get(path).data.get('isUsed', false) != true &&
      getAfter(path).data.get('isUsed', false) == true &&
      get(path).data.get('organizationId', '') == organizationId &&
      request.auth.token.email is string &&
      string(get(path).data.get('email', '')).lower() == request.auth.token.email.lower();
  }
  function isOrgManagerOrAdmin(organizationId) {
    return request.auth != null && organizationId is string &&
      callerOrgRole(organizationId) in ['admin', 'manager'];
  }
  function isOrgNonOperativeMember(organizationId) {
    return request.auth != null && (
      callerOrgRole(organizationId) in ['admin', 'manager'] ||
      (homeOrgIs(callerHomeData(), organizationId) && !isOperativeLikeUser(callerHomeData()))
    );
  }

  function isOperativeLikeUser(userData) {
    return ('operativeMode' in userData && truthyBool(userData.operativeMode)) ||
           ('role' in userData && userData.role == 'operative');
  }

  function canWriteMaterialSendRecord(organizationId) {
    return request.auth != null &&
           canAccessOrganization(organizationId) &&
           isOrgNonOperativeMember(organizationId);
  }

  function isStaffMaterialStatusWrite(organizationId) {
    let affected = request.resource.data.diff(resource.data).affectedKeys();
    return affected.hasOnly(['status', 'lastSentAt', 'lastSentRequestType', 'updatedAt', 'updatedBy', 'updatedFrom']) &&
           (!('updatedBy' in affected) || request.resource.data.updatedBy == request.auth.uid) &&
           (!('updatedFrom' in affected) || request.resource.data.updatedFrom in ['web', 'ios', 'android']) &&
           canWriteMaterialSendRecord(organizationId);
  }

  function isOrgAdminViaMembersMap(organizationId) {
    return isOrgAdminViaMembersMapAnyBilling(organizationId) && orgBillingOpen(organizationId);
  }
  function isOrgAdminViaMembersMapAnyBilling(organizationId) {
    return request.auth != null &&
           exists(/databases/(default)/documents/organizations/$(organizationId)) &&
           'members' in get(/databases/(default)/documents/organizations/$(organizationId)).data &&
           get(/databases/(default)/documents/organizations/$(organizationId)).data.members[request.auth.uid] == 'admin' &&
           !callerHomeInactiveIn(organizationId);
  }

  function isManagerWithOperativesAccess() {
    return request.auth != null &&
           exists(/databases/(default)/documents/users/$(request.auth.uid)) &&
           !('operativeMode' in get(/databases/(default)/documents/users/$(request.auth.uid)).data &&
             truthyBool(get(/databases/(default)/documents/users/$(request.auth.uid)).data.operativeMode)) &&
           ('manager' in get(/databases/(default)/documents/users/$(request.auth.uid)).data &&
             truthyBool(get(/databases/(default)/documents/users/$(request.auth.uid)).data.manager)) &&
           ('operatives' in get(/databases/(default)/documents/users/$(request.auth.uid)).data &&
             truthyBool(get(/databases/(default)/documents/users/$(request.auth.uid)).data.operatives));
  }
  function operativesManagerFlags(me) {
    return !('operativeMode' in me && truthyBool(me.operativeMode)) &&
           ('manager' in me && truthyBool(me.manager)) &&
           ('operatives' in me && truthyBool(me.operatives));
  }
  function managerOfSameOrg(me, organizationId) {
    return 'organizationId' in me && orgIdsMatch(me.organizationId, organizationId) &&
           !('operativeMode' in me && truthyBool(me.operativeMode)) &&
           ('manager' in me && truthyBool(me.manager)) &&
           ('operatives' in me && truthyBool(me.operatives));
  }

  function managerCanCreateOperativeUser() {
    return isManagerWithOperativesAccess() ? (
           'organizationId' in request.resource.data &&
           'organizationId' in get(/databases/(default)/documents/users/$(request.auth.uid)).data &&
           orgIdsMatch(
             get(/databases/(default)/documents/users/$(request.auth.uid)).data.organizationId,
             request.resource.data.organizationId
           ) &&
           (
             ('operativeMode' in request.resource.data && truthyBool(request.resource.data.operativeMode)) ||
             ('role' in request.resource.data && request.resource.data.role == 'operative')
           ) &&
           noPrivilegeFlags(request.resource.data)) : false;
  }

  function isPlatformOwner() {
    return request.auth != null &&
      request.auth.token.email is string &&
      request.auth.token.email.lower() == 'info@projectplanner.us' &&
      request.auth.token.email_verified == true;
  }

  function isOrgAdminOrOwner(organizationId) {
    return isOrganizationAdmin(organizationId) ||
      isOrgAdminViaMembersMap(organizationId) ||
      isPlatformOwner();
  }

  function canAccessVariationsStaff(organizationId) {
    return isOrgAdminOrOwner(organizationId) || isOrgManagerOrAdmin(organizationId);
  }

  function managerMayManageOperative(targetUserId, targetData) {
    let home = callerHomeData();
    return (request.auth.uid != targetUserId && operativesManagerFlags(home)) ? (
      'organizationId' in home && 'organizationId' in targetData &&
      orgIdsMatch(home.organizationId, targetData.organizationId) &&
      manageableOperative(targetData)
    ) : false;
  }


  function canManagerUpdateOperativeProfile(me) {
    return ('organizationId' in resource.data && 'organizationId' in me &&
            orgIdsMatch(me.organizationId, resource.data.organizationId) &&
            manageableOperative(resource.data)) ? (
      request.resource.data.diff(resource.data).affectedKeys().hasAny([
        'email', 'organizationId', 'formerUserIds', 'sameEmailUserIds'
      ]) ? false : (
      request.resource.data.diff(resource.data).changedKeys().hasOnly([
        'assignedManagerUserId', 'assignedManagerUserIds', 'hasNoLineManager', 'firstName', 'surname', 'lastName',
        'name', 'displayName', 'mobileNumber', 'tradeTypePreset', 'tradeTypeCustom', 'isActive', 'materials',
        'siteAudit', 'permissions', 'timesheetsEnabled', 'annualLeaveYearAllowance', 'annualLeaveYearAllowanceKey',
        'dayRate', 'hourlyRate', 'payBasis', 'annualLeaveEnabled', 'annualLeaveDaysPerYear',
        'annualLeaveYearStartMonth', 'annualLeaveYearEndMonth', 'annualLeaveCarriesOver', 'employmentStartDate',
        'employmentType', 'employmentTypeTransitionFrom', 'employmentTypeEffectiveAt', 'updatedAt', 'updatedBy',
        'updatedFrom'
      ]) ? (
        request.resource.data.get('hasNoLineManager', false) != true &&
        plainOperative(request.resource.data) &&
        writeMetadataValidWhenPresent()
      ) : false)
    ) : false;
  }
  function manageableOperative(t) {
    let p = t.get('permissions', {}) is map ? t.get('permissions', {}) : {};
    let v = [t.get('isSuperAdmin', false), t.get('adminAccess', false), t.get('manager', false),
      p.get('isSuperAdmin', false), p.get('adminAccess', false), p.get('manager', false)];
    return operativeTarget(t) && !(t.get('role', '') in ['admin', 'manager']) && !(true in v) && !(1 in v);
  }
  function operativeTarget(t) {
