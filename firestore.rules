    allow create: if isPlatformOwner() && request.resource.data.keys().hasOnly(['requestId', 'action', 'phase', 'actorUid', 'targetOrgId', 'targetUserId', 'reason', 'before', 'after', 'ip', 'userAgent', 'at']) &&
      request.resource.data.actorUid == request.auth.uid && request.resource.data.phase in ['requested', 'completed', 'failed'] &&
      request.resource.data.requestId is string && request.resource.data.action is string && request.resource.data.action.size() > 0 &&
      request.resource.data.at is timestamp;
  }

  match /ownerNotes/{id} {
    allow read, write: if isPlatformOwner();
  }

  match /supportRequests/{id} {
    allow read: if isPlatformOwner() ||
      request.auth != null && resource.data.requestedByUid == request.auth.uid;
    allow create: if request.auth != null &&
      request.resource.data.requestedByUid == request.auth.uid &&
      request.resource.data.status == 'open';
    allow update: if isPlatformOwner();
  }

  match /publicStats/{id} {
    allow read: if true;
  }

  match /adminJobs/{id} {
    allow read: if isPlatformOwner();
  }

  match /erasedOrganizations/{id} {
    allow read: if isPlatformOwner();
  }

  match /platformConfig/{id} {
    allow read: if id == 'app' || request.auth != null;
    allow write: if isPlatformOwner();
  }

  match /interestRegistrations/{id} {
    allow read, update, delete: if isPlatformOwner();
  }
  }
}
