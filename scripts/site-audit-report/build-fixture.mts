/**
 * Regenerates `lib/canonical/siteAuditReportFixture.ts` (rulebook 1.68.0 §29): the expected text lines and page
 * breaks of each shared fixture input. Run after a deliberate layout change: `npx tsx scripts/site-audit-report/build-fixture.mts`.
 */
import { writeFileSync } from 'node:fs'
import { siteAuditReportLayout, siteAuditReportTextLines } from '../../lib/canonical/siteAuditReport'
import { SITE_AUDIT_REPORT_FIXTURE_INPUTS } from '../../lib/canonical/siteAuditReportFixtureInputs'

const expected = SITE_AUDIT_REPORT_FIXTURE_INPUTS.map(({ name, input }) => {
  const layout = siteAuditReportLayout(input)
  return { name, fileName: layout.fileName, pageCount: layout.pages.length, opCount: layout.pages.reduce((n, p) => n + p.ops.length, 0), pages: siteAuditReportTextLines(layout) }
})
writeFileSync(
  new URL('../../lib/canonical/siteAuditReportFixture.ts', import.meta.url),
  `/** Generated by scripts/site-audit-report/build-fixture.mts — the shared site audit report fixture (rulebook 1.68.0 §29). Do not edit by hand. */\n` +
    `export const SITE_AUDIT_REPORT_FIXTURE_EXPECTED: ReadonlyArray<{ name: string; fileName: string; pageCount: number; opCount: number; pages: string[][] }> = ${JSON.stringify(expected)}\n`
)
