# Firebase (required)
# Copy these from QUICK_START.md if you use the project-planner-f986c Firebase project:
# NEXT_PUBLIC_FIREBASE_API_KEY=AIzaSyCPafzxnt3q2Q_xQ4N6BYrhNyUOJSiL1Yc
# NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=project-planner-f986c.firebaseapp.com
# NEXT_PUBLIC_FIREBASE_PROJECT_ID=project-planner-f986c
# NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=project-planner-f986c.firebasestorage.app
# (iOS GoogleService-Info.plist uses .firebasestorage.app. Legacy .appspot.com may still work for the same bucket.)
# NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=980527300983
# NEXT_PUBLIC_FIREBASE_APP_ID=1:980527300983:web:89bd0c7a69881d1b1be172
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Google Maps Geocoding (required for reliable UK site addresses on the web)
# 1. Open https://console.cloud.google.com/apis/library (project: project-planner-f986c)
# 2. Enable "Geocoding API"
# 3. Create an API key under APIs & Services → Credentials
# 4. Restrict the key to Geocoding API only
# 5. For Netlify/server: add GOOGLE_MAPS_API_KEY
# 6. For browser fallback: add the same key as NEXT_PUBLIC_GOOGLE_MAPS_API_KEY
#    with HTTP referrer restriction (your Netlify domain + localhost)
GOOGLE_MAPS_API_KEY=
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# Stripe (sandbox / test mode)
# Dashboard: https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_MODE=test
STRIPE_PRODUCT_ID=prod_VJO1l93ObO0yN4
STRIPE_PRICE_MONTHLY=price_1UIlFqQZYhBFKpOTfGAGMonZ
STRIPE_PRICE_ANNUAL=price_1UIlFvQZYhBFKpOTAPEu7iDu
STRIPE_PORTAL_CONFIGURATION_ID=bpc_1UIlG8QZYhBFKpOTpPqrcFfU
# Keep true (card collected at checkout). Set false later for no-card trials.
STRIPE_TRIAL_REQUIRES_CARD=true
# Stripe Tax is pending until the head office address is set. Leave false in sandbox.
STRIPE_AUTOMATIC_TAX=false
# Legacy single price — unused. Monthly/annual lookup keys are preferred.
# STRIPE_PRICE_ID=
# Used for Stripe redirects and invite emails.
# Local: http://localhost:3000
# Production MUST be the public site, not Firebase Hosting:
#   https://www.projectplanner.us
# https://project-planner-f986c.web.app is a stale marketing deploy; /setup there is not the wizard.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Email (same Cloud Function as iOS → Outlook / Microsoft 365)
# Default: https://us-central1-project-planner-f986c.cloudfunctions.net/sendProjectPlannerEmail
# EMAIL_FUNCTION_URL=
# EMAIL_FROM_NAME=Project Planner
# EMAIL_REPLY_TO=info@projectplanner.us

# Email 2FA (HMAC for the verification-code cookie). Production should set a long random secret.
# MFA_SIGNING_SECRET=

# Optional Admin SDK JSON (stringified service account) for owner change-email / recursive org delete.
# Required to update a user's Firebase Auth email from the owner console.
# FIREBASE_SERVICE_ACCOUNT_JSON=

