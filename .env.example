# Firebase (required)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Google Maps Geocoding (required for reliable UK site addresses on the web)
# 1. Open https://console.cloud.google.com/apis/library (project: project-planner-f986c)
# 2. Enable "Geocoding API"
# 3. Create an API key under APIs & Services → Credentials
# 4. Restrict the key to Geocoding API only
# 5. For Netlify/server: add GOOGLE_MAPS_API_KEY
# 6. For browser fallback: add the same key as NEXT_PUBLIC_GOOGLE_MAPS_API_KEY
#    with HTTP referrer restriction (your Netlify domain + localhost)
GOOGLE_MAPS_API_KEY=
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# Stripe (required for organisation setup / subscriptions)
# Dashboard: https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# Webhook signing secret from: Developers → Webhooks → your endpoint
STRIPE_WEBHOOK_SECRET=
# Price IDs from: Products → your tier → Pricing → Price ID (price_...)
STRIPE_PRICE_STARTER=
STRIPE_PRICE_PROFESSIONAL=
STRIPE_PRICE_ENTERPRISE=
# Used for Stripe redirect URLs (local: http://localhost:3000)
NEXT_PUBLIC_APP_URL=http://localhost:3000
