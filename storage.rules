rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() {
      return request.auth != null;
    }

    function userData() {
      return firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data;
    }

    function userDocExists() {
      return signedIn()
        && firestore.exists(/databases/(default)/documents/users/$(request.auth.uid));
    }

    function truthyBool(v) {
      return v == true || v == 1;
    }

    // Same membership as today's blanket org prefix. No public read.
    function callerOrgMatches(orgId) {
      return signedIn()
        && firestore.exists(/databases/(default)/documents/users/$(request.auth.uid))
        && (
          (userData().organizationId is string
            && userData().organizationId.lower() == orgId.lower())
          || userData().organizationId == /databases/(default)/documents/organizations/$(orgId)
        );
    }

    function callerIsMember(orgId) {
      return signedIn()
        && firestore.exists(/databases/(default)/documents/organizations/$(orgId))
        && 'members' in firestore.get(/databases/(default)/documents/organizations/$(orgId)).data
        && request.auth.uid in firestore.get(/databases/(default)/documents/organizations/$(orgId)).data.members;
    }

    function orgMember(orgId) {
      return callerOrgMatches(orgId) || callerIsMember(orgId);
    }

    // members[uid] == 'admin' covers org-setup logo upload before users/{uid} has adminAccess.
    function callerIsAdminMember(orgId) {
      return signedIn()
        && firestore.exists(/databases/(default)/documents/organizations/$(orgId))
        && 'members' in firestore.get(/databases/(default)/documents/organizations/$(orgId)).data
        && request.auth.uid in firestore.get(/databases/(default)/documents/organizations/$(orgId)).data.members
        && firestore.get(/databases/(default)/documents/organizations/$(orgId)).data.members[request.auth.uid] == 'admin';
    }

    function adminLike(orgId) {
      return callerIsAdminMember(orgId) || (
        userDocExists() && (
          ('isSuperAdmin' in userData() && truthyBool(userData().isSuperAdmin))
          || ('adminAccess' in userData() && truthyBool(userData().adminAccess))
          || ('role' in userData() && userData().role == 'admin')
          || ('permissions' in userData() && userData().permissions is map
            && 'adminAccess' in userData().permissions
            && truthyBool(userData().permissions.adminAccess))
        )
      );
    }

    function isOperativeUser() {
      return userDocExists() && (
        ('operativeMode' in userData() && truthyBool(userData().operativeMode))
        || ('role' in userData() && userData().role == 'operative')
      );
    }

    function managerLike() {
      return userDocExists() && (
        ('manager' in userData() && truthyBool(userData().manager))
        || ('role' in userData() && userData().role == 'manager')
        || ('permissions' in userData() && userData().permissions is map
          && 'manager' in userData().permissions
          && truthyBool(userData().permissions.manager))
      );
    }

    // Staff = not operative, and admin or manager. Used only for logo/export role gates.
    function staffLike(orgId) {
      return orgMember(orgId)
        && !isOperativeUser()
        && (adminLike(orgId) || managerLike());
    }

    function sized(maxBytes) {
      return request.resource.size <= maxBytes;
    }

    function contentTypeString() {
      return request.resource.contentType is string;
    }

    function isImageContent() {
      return contentTypeString() && request.resource.contentType.matches('image/.*');
    }

    function isPdf() {
      return contentTypeString() && request.resource.contentType == 'application/pdf';
    }

    function isCertificateType() {
      return contentTypeString() && (
        request.resource.contentType == 'application/pdf'
        || request.resource.contentType == 'image/jpeg'
        || request.resource.contentType == 'image/jpg'
        || request.resource.contentType == 'image/pjpeg'
      );
    }

    // Tasks / H&S / variation evidence: types the apps already send, including
    // octet-stream (web fallback + iOS putFile with nil metadata).
    function isWorkFileType() {
      return contentTypeString() && (
        request.resource.contentType.matches('image/.*')
        || request.resource.contentType == 'application/pdf'
        || request.resource.contentType == 'application/octet-stream'
        || request.resource.contentType == 'application/vnd.ms-excel'
        || request.resource.contentType == 'application/vnd.openxmlformats-officedocument.spreadsheetml.sheet'
        || request.resource.contentType == 'application/msword'
        || request.resource.contentType == 'application/vnd.openxmlformats-officedocument.wordprocessingml.document'
        || request.resource.contentType == 'application/vnd.ms-excel.sheet.macroenabled.12'
        || request.resource.contentType == 'text/csv'
        || request.resource.contentType == 'application/zip'
        || request.resource.contentType == 'application/x-zip-compressed'
      );
    }

    function memberSizedWrite(orgId, maxBytes, typed) {
      return orgMember(orgId) && sized(maxBytes) && typed;
    }

    // Rulebook 1.25.0 §24 (fileDeletePermission): uploaded files are never lost.
    // Admin of THIS organisation outside operative mode: 'admin' in its members map, or admin flags on a users
    // document whose organizationId is this organisation. An admin of another company never counts.
    function orgFileAdmin(orgId) {
      return !isOperativeUser() && (
        callerIsAdminMember(orgId) || (
          callerOrgMatches(orgId) && (
            ('isSuperAdmin' in userData() && truthyBool(userData().isSuperAdmin))
            || ('adminAccess' in userData() && truthyBool(userData().adminAccess))
            || ('role' in userData() && userData().role == 'admin')
            || ('permissions' in userData() && userData().permissions is map
              && 'adminAccess' in userData().permissions
              && truthyBool(userData().permissions.adminAccess))
          )
        )
      );
    }

    // Create is a new object. The emulator (and possibly production) evaluates a write over an existing object
    // with `create` too, so every create rule also refuses an existing object unless the overwrite is allowed.
    function isNewObject() {
      return resource == null;
    }

    // Last path segment of the stored object (delete / overwrite: the object exists).
    function storedObjectName() {
      return resource.name.split('/')[resource.name.split('/').size() - 1];
    }

    // The uploader, inside FILE_UNDO_WINDOW_MINUTES (15) of the server upload time. Uploads are named
    // {uid}_{unixMs}.{ext} on both apps (storedFileObjectName), so the name says who uploaded it.
    function uploaderWithinUndoWindow() {
      return signedIn()
        && storedObjectName().split('_').size() > 1
        && storedObjectName().split('_')[0] == request.auth.uid
        && request.time < resource.timeCreated + duration.value(15, 'm');
    }

    // Delete: the uploader within the undo window, or an admin of this organisation.
    function canDeleteStoredFile(orgId) {
      return orgMember(orgId) && (uploaderWithinUndoWindow() || orgFileAdmin(orgId));
    }

    // A new object, or the uploader's own retry within the undo window.
    function newOrOwnRetry() {
      return isNewObject() || uploaderWithinUndoWindow();
    }

    // Overwrite of an existing object: only the uploader within the undo window (a retried upload).
    function canOverwriteStoredFile(orgId, maxBytes, typed) {
      return memberSizedWrite(orgId, maxBytes, typed) && uploaderWithinUndoWindow();
    }

    // Profile photo. Web + iOS: .../userProfiles/{userId}/profile.jpg
    match /organizations/{orgId}/userProfiles/{userId}/profile.jpg {
      allow read: if orgMember(orgId);
      // The person's own photo, or an admin of this organisation. Replacing it keeps the fixed name (both apps
      // read this path); the replaced version is kept by the bucket's soft delete (§24).
      allow delete: if orgMember(orgId) && (request.auth.uid == userId || orgFileAdmin(orgId));
      allow create, update: if orgMember(orgId)
        && (request.auth.uid == userId || adminLike(orgId))
        && sized(2 * 1024 * 1024)
        && isImageContent();
    }

    // Company logo. Web + iOS: .../branding/company_logo/{file}
    match /organizations/{orgId}/branding/company_logo/{fileName} {
      allow read: if orgMember(orgId);
      // Each upload is a new {uid}_{ms} object; only an admin of this organisation deletes or overwrites one.
      allow delete: if orgMember(orgId) && orgFileAdmin(orgId);
      allow create: if (isNewObject() || orgFileAdmin(orgId))
        && orgMember(orgId)
        && adminLike(orgId)
        && sized(5 * 1024 * 1024)
        && (isImageContent() || isPdf());
      allow update: if orgMember(orgId)
        && orgFileAdmin(orgId)
        && sized(5 * 1024 * 1024)
        && (isImageContent() || isPdf());
    }

    // Timesheet export PDFs. iOS operatives do not getDownloadURL these objects.
    match /organizations/{orgId}/timesheetExports/{fileName} {
      allow read: if staffLike(orgId);
      // Staff create; only an admin of this organisation deletes or overwrites an export.
      allow delete: if orgMember(orgId) && orgFileAdmin(orgId);
      allow create: if (isNewObject() || orgFileAdmin(orgId))
        && staffLike(orgId)
        && sized(10 * 1024 * 1024)
        && isPdf();
      allow update: if staffLike(orgId)
        && orgFileAdmin(orgId)
        && sized(10 * 1024 * 1024)
        && isPdf();
    }

    // Qualification certificates. Member + size/type only — do not staff-lock.
    match /organizations/{orgId}/operatives/{operativeId}/qualifications/{qualificationId}/certificates/{fileName} {
      allow read: if orgMember(orgId);
      allow delete: if canDeleteStoredFile(orgId);
      allow create: if newOrOwnRetry() && memberSizedWrite(orgId, 10 * 1024 * 1024, isCertificateType());
      allow update: if canOverwriteStoredFile(orgId, 10 * 1024 * 1024, isCertificateType());
    }

    // Variation evidence — web path (20MB; iOS client already allows 20MB).
    match /organizations/{orgId}/healthSafety/{parentId}/variations/{fileName} {
      allow read: if orgMember(orgId);
      allow delete: if canDeleteStoredFile(orgId);
      allow create: if newOrOwnRetry() && memberSizedWrite(orgId, 20 * 1024 * 1024, isWorkFileType());
      allow update: if canOverwriteStoredFile(orgId, 20 * 1024 * 1024, isWorkFileType());
    }

    // Variation evidence — iOS primary path.
    match /organizations/{orgId}/healthSafety/{parentId}/variationEvidence/{fileName} {
      allow read: if orgMember(orgId);
      allow delete: if canDeleteStoredFile(orgId);
      allow create: if newOrOwnRetry() && memberSizedWrite(orgId, 20 * 1024 * 1024, isWorkFileType());
      allow update: if canOverwriteStoredFile(orgId, 20 * 1024 * 1024, isWorkFileType());
    }

    // Variation evidence — iOS fallback path.
    match /organizations/{orgId}/variations/{variationId}/{fileName} {
      allow read: if orgMember(orgId);
      allow delete: if canDeleteStoredFile(orgId);
      allow create: if newOrOwnRetry() && memberSizedWrite(orgId, 20 * 1024 * 1024, isWorkFileType());
      allow update: if canOverwriteStoredFile(orgId, 20 * 1024 * 1024, isWorkFileType());
    }

    // Site audit images. Member + size/type only — do not staff-lock.
    match /organizations/{orgId}/siteAudits/{allPaths=**} {
      allow read: if orgMember(orgId);
      allow delete: if canDeleteStoredFile(orgId);
      allow create: if newOrOwnRetry() && memberSizedWrite(orgId, 10 * 1024 * 1024, isImageContent());
      allow update: if canOverwriteStoredFile(orgId, 10 * 1024 * 1024, isImageContent());
    }

    // Tasks: web flat .../tasks/{taskId}/{file}; iOS .../files/ and .../images/.
    // Member + size/type only — do not staff-lock.
    match /organizations/{orgId}/tasks/{allPaths=**} {
      allow read: if orgMember(orgId);
      allow delete: if canDeleteStoredFile(orgId);
      allow create: if newOrOwnRetry() && memberSizedWrite(orgId, 10 * 1024 * 1024, isWorkFileType());
      allow update: if canOverwriteStoredFile(orgId, 10 * 1024 * 1024, isWorkFileType());
    }

    // H&S talks/RAMS/other/deadlines. More-specific variation matches above win via OR.
    // Member + size/type only — do not staff-lock.
    match /organizations/{orgId}/healthSafety/{allPaths=**} {
      allow read: if orgMember(orgId);
      allow delete: if canDeleteStoredFile(orgId);
      allow create: if newOrOwnRetry() && memberSizedWrite(orgId, 10 * 1024 * 1024, isWorkFileType());
      allow update: if canOverwriteStoredFile(orgId, 10 * 1024 * 1024, isWorkFileType());
    }

    // Rulebook 1.30.0 §26: a person's line manager — listed on that person's users document, which names this
    // organisation (never an operatives row) — the same test as Firestore callerLineManagesUser.
    function callerLineManagesUser(orgId, uid) {
      let path = /databases/(default)/documents/users/$(uid);
      return signedIn() && uid != request.auth.uid
        // 1.30.0 review: the caller is active (as Firestore canAccessOrganization requires).
        && userDocExists() && userData().get('isActive', true) != false
        && firestore.exists(path)
        && (
          (firestore.get(path).data.get('organizationId', '') is string
            && firestore.get(path).data.get('organizationId', '').lower() == orgId.lower())
        )
        && (
          request.auth.uid in firestore.get(path).data.get('assignedManagerUserIds', [])
          || firestore.get(path).data.get('assignedManagerUserId', '') == request.auth.uid
        )
        && firestore.get(path).data.get('hasNoLineManager', false) != true
        // 1.31.0 (no rights carry over on a level change): an operative is nobody's line manager.
        && !(truthyBool(userData().get('operativeMode', false)) || userData().get('role', '') == 'operative');
    }

    // An admin of this organisation, as Firestore isOrganizationAdmin and canonical isAdminOutsideOperativeMode read it
    // (1.11.0: a stray operativeMode never demotes an admin), active.
    function claimAdmin(orgId) {
      return callerIsAdminMember(orgId) || (
        callerOrgMatches(orgId) && userData().get('isActive', true) != false && (
          ('isSuperAdmin' in userData() && truthyBool(userData().isSuperAdmin))
          || ('adminAccess' in userData() && truthyBool(userData().adminAccess))
          || ('role' in userData() && userData().role == 'admin')
          || ('permissions' in userData() && userData().permissions is map
            && 'adminAccess' in userData().permissions
            && truthyBool(userData().permissions.adminAccess))
        )
      );
    }

    function isClaimImageOrPdf() {
      return (isImageContent() && request.resource.contentType != 'image/svg+xml') || isPdf();
    }

    // Price work / expense evidence (and frozen personal site audit copies), in the person's own folder. The person
    // uploads (a new {uid}_{ms} object each time); the person, their line managers and admins of this organisation
    // read; delete as §24 (the uploader within the undo window, or an admin). Images and PDFs, 10MB.
    match /organizations/{orgId}/payeClaims/{userId}/{fileName} {
      allow read: if orgMember(orgId) && (request.auth.uid == userId || claimAdmin(orgId) || callerLineManagesUser(orgId, userId));
      allow delete: if canDeleteStoredFile(orgId);
      allow create: if request.auth.uid == userId && newOrOwnRetry()
        && memberSizedWrite(orgId, 10 * 1024 * 1024, isClaimImageOrPdf());
      allow update: if request.auth.uid == userId && canOverwriteStoredFile(orgId, 10 * 1024 * 1024, isClaimImageOrPdf());
    }

    // Personal site audit photos: the owner only — read, write and delete (within the undo window). No admin.
    match /organizations/{orgId}/personalSiteAudits/{ownerId}/{allPaths=**} {
      allow read: if orgMember(orgId) && request.auth.uid == ownerId;
      allow delete: if orgMember(orgId) && request.auth.uid == ownerId && uploaderWithinUndoWindow();
      allow create: if request.auth.uid == ownerId && newOrOwnRetry()
        && memberSizedWrite(orgId, 10 * 1024 * 1024, isImageContent() && request.resource.contentType != 'image/svg+xml');
      allow update: if request.auth.uid == ownerId && canOverwriteStoredFile(orgId, 10 * 1024 * 1024, isImageContent() && request.resource.contentType != 'image/svg+xml');
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
