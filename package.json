{
  "name": "project-planner-web",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:webpack": "next dev --webpack",
    "dev:clean": "sh scripts/clean-dev.sh",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint . --ext .js,.jsx,.ts,.tsx --ignore-pattern '.next/**' --ignore-pattern 'node_modules/**'",
    "test": "node scripts/build-canonical-bundle.mjs && node scripts/build-canonical-bundle.mjs --check && tsx --test lib/*.test.ts lib/**/*.test.ts lib/security/*.test.ts lib/email/*.test.ts && node --test functions/prunePushTokens.test.js",
    "test:rules": "PATH=\"/opt/homebrew/opt/openjdk@21/bin:$PATH\" JAVA_HOME=\"${JAVA_HOME:-/opt/homebrew/opt/openjdk@21}\" firebase emulators:exec --only firestore --project demo-project-planner-rules \"tsx --test tests/firestore.rules.test.ts\"",
    "test:rules:storage": "PATH=\"/opt/homebrew/opt/openjdk@21/bin:$PATH\" JAVA_HOME=\"${JAVA_HOME:-/opt/homebrew/opt/openjdk@21}\" firebase emulators:exec --only firestore,storage --project demo-project-planner-rules \"tsx --test tests/storage.rules.test.ts\"",
    "build:canonical": "node scripts/build-canonical-bundle.mjs",
    "check:canonical": "node scripts/build-canonical-bundle.mjs --check",
    "prepare": "git config core.hooksPath .githooks || true",
    "verify-env": "node scripts/verify-env.mjs",
    "netlify:env": "npx netlify-cli env:import .env.local",
    "netlify:deploy": "npx netlify-cli deploy --build --prod"
  },
  "dependencies": {
    "@headlessui/react": "^1.7.17",
    "@heroicons/react": "^2.1.1",
    "@netlify/blobs": "^10.7.13",
    "@stripe/stripe-js": "^10.2.0",
    "clsx": "^2.1.0",
    "date-fns": "^3.0.6",
    "firebase": "^10.7.1",
    "leaflet": "^1.9.4",
    "next": "^16.4.2",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^4.10.38",
    "react": "^18.2.0",
    "react-big-calendar": "^1.20.0",
    "react-dom": "^18.2.0",
    "react-hook-form": "^7.90.0",
    "stripe": "^22.4.0",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "zod": "^4.6.5",
    "zustand": "^4.4.7"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^3.0.4",
    "@types/node": "^20.10.6",
    "@types/react": "^18.2.46",
    "@types/react-big-calendar": "^1.8.7",
    "@types/react-dom": "^18.2.18",
    "autoprefixer": "^10.6.1",
    "esbuild": "^0.28.2",
    "eslint": "^8.56.0",
    "eslint-config-next": "14.0.4",
    "postcss": "^8.5.31",
    "tailwindcss": "^3.4.0",
    "tsx": "^4.23.15",
    "typescript": "^5.3.3"
  },
  "overrides": {
    "undici": "^6.29.1",
    "@grpc/grpc-js": "^1.14.6",
    "@typescript-eslint/typescript-estree": {
      "minimatch": "^9.0.9"
    }
  }
}
